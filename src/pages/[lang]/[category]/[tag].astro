---
import type { Lang } from '../../../content/nav'
import type { LocalTag } from '../../../content/tags'

import Chips from '../../../components/Chips.astro'
import ExcerptList from '../../../components/ExcerptList.astro'
import Paragraph from '../../../components/Paragraph.astro'
import Plate from '../../../components/Plate.astro'
import PostProse from '../../../components/post/PostProse.astro'
import { CATEGORY_SEGMENTS, getCategoryPath, tags } from '../../../content/tags'
import PageLayout from '../../../layouts/PageLayout.astro'
import { type CollectionInfo, COLLECTIONPAGE } from '../../../lib/jsonld'
import { getExcerptPosts } from '../../../lib/posts'
import { relatedTags } from '../../../lib/tagCooccurrence'

export function getStaticPaths() {
    const langs: Lang[] = ['fi', 'sv', 'en']

    return langs.flatMap((lang) =>
        tags.map((tag) => ({
            params: { category: CATEGORY_SEGMENTS[lang], lang, tag: tag.slugs[lang] },
            props: { tag },
        }))
    )
}

interface Props {
    tag: LocalTag
}

const { tag } = Astro.props
const { lang } = Astro.params as { lang: Lang }

const heroImageFallback = 'Lauri-Lavanti-dipolissa-lasijulkisivun-edessa-hero-pysty'
const mobileHeroImageFallback = 'Lauri-Lavanti-dipolissa-lasijulkisivun-edessa-hero-vaaka'
const heroImageAltFallback: Record<Lang, string> = {
    en: 'Lauri Lavanti stands in front of a glass wall, wearing a dark blazer and a patterned shirt. Photo: Markus Isomeri.',
    fi: 'Lauri Lavanti seisoo lasiseinän edessä tummassa pikkutakissa ja kuviollisessa paidassa. Kuva: Markus Isomeri.',
    sv: 'Lauri Lavanti står framför en glasvägg, iklädd en mörk kavaj och en mönstrad skjorta. Foto: Markus Isomeri.',
}

const metaDescription = tag.metaDescription[lang]
const bodyParagraphs = tag.descriptions[lang]

const relatedPostsHeading: Record<Lang, string> = {
    en: 'Related posts',
    fi: 'Aiheeseen liittyvät kirjoitukset',
    sv: 'Relaterade inlägg',
}

const featuredHeading: Record<Lang, string> = {
    en: 'Start here',
    fi: 'Aloita näistä',
    sv: 'Börja här',
}

const featured = tag.featured ?? []

const relatedTagsHeading: Record<Lang, string> = {
    en: 'Related topics',
    fi: 'Liittyvät aiheet',
    sv: 'Relaterade ämnen',
}

/*
 * Sibling categories by co-occurrence over the published posts of this locale;
 * every tag with a category page qualifies, election and party tags included.
 */
const siblings = relatedTags(await getExcerptPosts({ lang }), tag.id, new Set(tags.map((t) => t.id))).map(({ id }) => ({
    href: getCategoryPath(id, lang)!,
    label: tags.find((t) => t.id === id)!.names[lang],
}))
/** A single sibling reads as noise, not as a map of the topic. */
const SIBLINGS_MIN = 2

/*
 * Every published post under the tag, in the order the page shows them (featured
 * first); the same query ExcerptList runs, so scheduled posts never reach the
 * JSON-LD early.
 */
const collection: CollectionInfo = {
    about: { name: tag.names[lang], termSet: new URL(`/${lang}/blog/`, Astro.site).href },
    items: (await getExcerptPosts({ lang, rankedIds: featured, tag: tag.id })).map((post) => ({
        name: post.title,
        url: new URL(post.url, Astro.site).href,
    })),
}

const langAlternates = {
    en: getCategoryPath(tag.id, 'en')!,
    fi: getCategoryPath(tag.id, 'fi')!,
    sv: getCategoryPath(tag.id, 'sv')!,
}
---

<PageLayout
    alt={tag.heroImageAlt?.[lang] ?? heroImageAltFallback[lang]}
    breadcrumbName={tag.names[lang]}
    breadcrumbParent="blog"
    collection={collection}
    description={metaDescription}
    faq={tag.faq?.[lang]}
    faqSection
    heroImage={tag.heroImage ?? heroImageFallback}
    lang={lang}
    langAlternates={langAlternates}
    mobileHeroImage={mobileHeroImageFallback}
    pageTitle={tag.pageTitle[lang]}
    plated
    slug={`${lang}/${CATEGORY_SEGMENTS[lang]}/${tag.slugs[lang]}`}
    title={tag.pageTitle[lang]}
    type={COLLECTIONPAGE}
    updatedDate={tag.updatedDate}
    variant="split"
>
    <Plate ground="white">
        <PostProse>{bodyParagraphs.map((p) => <Paragraph>{p}</Paragraph>)}</PostProse>
    </Plate>
    {
        featured.length > 0 && (
            <Plate ground="white" heading={featuredHeading[lang]}>
                <PostProse>
                    <ExcerptList lang={lang} onlyIds={featured} rankedIds={featured} tag={tag.id} />
                </PostProse>
            </Plate>
        )
    }
    <Plate ground="white" heading={relatedPostsHeading[lang]}>
        <PostProse>
            <ExcerptList excludeIds={featured.length > 0 ? featured : undefined} lang={lang} tag={tag.id} />
        </PostProse>
    </Plate>
    {
        siblings.length >= SIBLINGS_MIN && (
            <Plate ground="white" heading={relatedTagsHeading[lang]}>
                <Chips ariaLabel={relatedTagsHeading[lang]} items={siblings} />
            </Plate>
        )
    }
</PageLayout>
