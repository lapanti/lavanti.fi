---
import type { Lang } from '../../content/nav'
import type { AdoptionWallData } from './wall.client'

import { adoptionContent } from '../../content/signAdoption'
import Plate from '../Plate.astro'

interface Props {
    lang: Lang
}

/*
 * Momentum and the adopters list, filled from /api/adoptoi/seina by wall.client.ts. Nothing is
 * rendered at build time, so no name or count is ever seeded; below the wall's thresholds the
 * section stays empty. The visitor's own pending tile comes from sessionStorage.
 */
const { lang } = Astro.props
const content = adoptionContent[lang]
const t = content.wall
const scriptData: AdoptionWallData = {
    count: t.count(0).replace('0', '%n'),
    municipalities: content.form.municipalityOptions,
    other: t.other,
    ownTile: t.ownTile('%s'),
}
---

<style>
    .wall {
        display: grid;
        gap: 1.5rem;
    }
    [data-wall][hidden],
    .wall [hidden] {
        display: none;
    }
    .wall .count {
        color: var(--colorsForestGreen);
        font-family: 'Big Shoulders Display', sans-serif;
        font-size: 2.25rem;
        font-weight: 800;
        line-height: 1.1;
        margin: 0;
    }
    .wall h3 {
        color: var(--colorsForestGreen);
        font-weight: var(--fontWeightsSemibold);
        margin: 0 0 0.5rem;
    }
    .wall p {
        color: var(--colorsForestGreen);
        margin: 0;
    }
    .tiles {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    /* The tiles and quotes are created by wall.client.ts, hence :global. */
    .tiles :global(li) {
        background: var(--colorsWhite);
        border-bottom: 4px solid var(--colorsBrightGreen);
        color: var(--colorsForestGreen);
        font-family: 'Big Shoulders Display', sans-serif;
        font-size: 1.375rem;
        font-weight: 700;
        padding: 0.375rem 0.75rem;
    }
    .tiles :global(li.own) {
        border-bottom-style: dashed;
    }
    .messages {
        display: grid;
        gap: 1rem;
    }
    .messages :global(blockquote) {
        border-left: 4px solid var(--colorsBrightGreen);
        margin: 0;
        padding: 0.25rem 0 0.25rem 1rem;
    }
    .messages :global(cite) {
        display: block;
        font-style: normal;
        font-weight: var(--fontWeightsSemibold);
        margin-top: 0.25rem;
    }
</style>

<div data-wall hidden>
    <Plate ground="white" heading={t.adoptersHeading} id="adoptoijat">
        <div class="wall">
            <p class="count" data-wall-count hidden></p>
            <p data-wall-municipalities hidden><strong>{t.municipalities}</strong> <span></span></p>
            <ul class="tiles" data-wall-adopters hidden></ul>
            <div data-wall-messages hidden>
                <h3>{t.messagesHeading}</h3>
                <div class="messages"></div>
            </div>
        </div>
    </Plate>
</div>

<script id="adoption-wall-data" is:inline set:html={JSON.stringify(scriptData)} type="application/json" />

<script src="./wall.client.ts"></script>
