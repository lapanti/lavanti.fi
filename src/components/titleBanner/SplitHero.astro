---
import { typographics } from '../../lib/styles'
import Images from '../heroBanner/Images.astro'

interface Props {
    alt?: string
    ctaHref?: string
    ctaLabel?: string
    emphasis?: string
    eyebrow?: string
    heroImage?: string
    intro?: string
    mobileHeroImage?: string
    title: string
}

const { alt, ctaHref, ctaLabel, emphasis, eyebrow, heroImage, intro, mobileHeroImage, title } = Astro.props
---

<style
    define:vars={{
        displayFontFamily: typographics.display.fontFamily,
        displayFontWeight: typographics.display.fontWeight,
        displayLetterSpacing: typographics.display.letterSpacing,
        heroFootFontFamily: typographics.heroFoot.fontFamily,
        heroFootFontSize: typographics.heroFoot.fontSize,
        heroFootFontWeight: typographics.heroFoot.fontWeight,
        heroFootLineHeight: typographics.heroFoot.lineHeight,
        heroKickerFontFamily: typographics.heroKicker.fontFamily,
        heroKickerFontSize: typographics.heroKicker.fontSize,
        heroKickerFontWeight: typographics.heroKicker.fontWeight,
        heroKickerLetterSpacing: typographics.heroKicker.letterSpacing,
        heroKickerLineHeight: typographics.heroKicker.lineHeight,
    }}
>
    .hero {
        background: var(--colorsDeepForest);
        display: block;
        min-height: 0;
        /* The mobile header is `position: fixed` and out of flow — reserve its height
           so it doesn't sit on top of (and hide) the hero image underneath it. */
        padding-top: var(--headerSize);
        position: relative;
    }

    .hero-right {
        background: var(--colorsLightSand);
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 1.5rem 1rem 2rem;
    }

    .hero-kicker {
        color: var(--colorsDarkGreen);
        font-family: var(--heroKickerFontFamily);
        font-size: var(--heroKickerFontSize);
        font-weight: var(--heroKickerFontWeight);
        letter-spacing: var(--heroKickerLetterSpacing);
        line-height: var(--heroKickerLineHeight);
        text-transform: uppercase;
    }

    h1 {
        color: var(--colorsDeepForest);
        font-family: var(--displayFontFamily);
        font-size: 3.25rem;
        font-weight: var(--displayFontWeight);
        letter-spacing: var(--displayLetterSpacing);
        line-height: 1;
        margin: 0;
        max-width: 760px;
        padding: 1rem 0 0.75rem;
        text-transform: uppercase;
    }

    h1 em {
        color: var(--colorsBrightGreen);
        font-style: normal;
    }

    .hero-foot {
        align-items: flex-start;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        text-align: left;
    }

    .hero-foot p {
        color: var(--colorsDeepForest);
        font-family: var(--heroFootFontFamily);
        font-size: var(--heroFootFontSize);
        font-weight: var(--heroFootFontWeight);
        line-height: var(--heroFootLineHeight);
        margin: 0;
        max-width: none;
    }

    @media (min-width: 769px) {
        .hero {
            display: grid;
            grid-template-columns: 260px minmax(0, 1fr);
            min-height: 633px;
            padding-top: 0;
        }

        /* Stretches with the hero grid row (floored at 633px by .hero min-height) so the
           image always covers the whole left column. On an unusually long headline that
           grows .hero-right past 633px, the portrait zooms slightly (object-position:
           100% 50%) rather than exposing the deep-forest background below it. */
        .hero :global(.hero-left) {
            width: 260px;
        }

        .hero-right {
            grid-column: 2;
            padding: 6.5rem 2.5rem 2rem 1rem;
        }

        h1 {
            font-size: 4.5rem;
        }
    }

    @media (min-width: 1000px) {
        .hero {
            grid-template-columns: 330px minmax(0, 1fr);
        }

        .hero :global(.hero-left) {
            width: 330px;
        }

        .hero-right {
            padding: 8rem 2.5rem 2rem 1rem;
        }

        h1 {
            font-size: 5.5rem;
        }
    }

    @media (min-width: 1200px) {
        .hero {
            grid-template-columns: 331px minmax(0, 1fr);
        }

        .hero :global(.hero-left) {
            width: 331px;
        }

        .hero-right {
            padding: 8rem 3.5rem 2rem;
        }

        h1 {
            font-size: 7.5rem;
        }

        .hero-foot {
            flex-direction: row;
            flex-wrap: wrap;
        }

        .hero-foot p {
            max-width: 520px;
        }
    }
</style>
<section class="hero">
    <Images alt={alt} heroImage={heroImage} mobileHeroImage={mobileHeroImage} showMark={false} />
    <div class="hero-right">
        {eyebrow && <div class="hero-kicker">{eyebrow}</div>}
        <h1>
            {title}
            {emphasis && <em>{emphasis}</em>}
        </h1>
        <div class="hero-foot">
            {intro && <p>{intro}</p>}
            {
                ctaHref && ctaLabel && (
                    <a class="btn" href={ctaHref}>
                        {ctaLabel}
                    </a>
                )
            }
        </div>
    </div>
</section>
