---
import type { Lang } from '../../content/nav'

import { getCategoryPath, getTagName } from '../../content/tags'
import { colors, typographics } from '../../lib/styles'

interface Props {
    createdAt?: string
    lang?: Lang
    readingTime?: number
    tags?: string[]
    title: string
    updatedDate?: string
}

const { createdAt, lang = 'fi', readingTime, tags, title, updatedDate } = Astro.props

const readingTimeLabel: Record<Lang, string> = { en: 'min read', fi: 'min lukuaika', sv: 'min' }
const updatedLabel: Record<Lang, string> = { en: 'Updated', fi: 'Päivitetty', sv: 'Uppdaterad' }

const [dateOnly] = (createdAt ?? '').split('T')
const [year, month, day] = dateOnly ? dateOnly.split('-') : []
const dateToDisplay = dateOnly ? `${day}.${month}.${year}` : ''

const showUpdated = Boolean(updatedDate) && updatedDate !== dateOnly
const [updYear, updMonth, updDay] = showUpdated && updatedDate ? updatedDate.split('-') : []
const updatedDateToDisplay = showUpdated ? `${updDay}.${updMonth}.${updYear}` : ''

/* Canonical category paths: the legacy /{lang}/category/{id}/ form only resolves through a 301. */
const tagsToRender = (tags ?? [])
    .map((tagId) => ({ href: getCategoryPath(tagId, lang), name: getTagName(tagId, lang) }))
    .filter((tag): tag is { href: string; name: string } => tag.href !== undefined && tag.name !== undefined)
---

<style
    define:vars={{
        articleHeadlineFontFamily: typographics.articleHeadline.fontFamily,
        chipFontFamily: typographics.chip.fontFamily,
        chipFontSize: typographics.chip.fontSize,
        chipFontWeight: typographics.chip.fontWeight,
        chipLetterSpacing: typographics.chip.letterSpacing,
        colorsDarkGreen: colors.darkGreen,
        colorsDeepForest: colors.forestGreen,
        colorsForestGreen10: colors.forestGreen10,
        colorsLightSand: colors.lightSand,
        colorsTaivas700: colors.aquaInkSoft,
        eyebrowFontFamily: typographics.eyebrow.fontFamily,
        eyebrowFontSize: typographics.eyebrow.fontSize,
        eyebrowFontWeight: typographics.eyebrow.fontWeight,
        eyebrowLetterSpacing: typographics.eyebrow.letterSpacing,
        eyebrowLineHeight: typographics.eyebrow.lineHeight,
    }}
>
    .art-head {
        background: var(--colorsLightSand);
        padding: 4rem 0 3.5rem;
    }

    .art-meta {
        align-items: center;
        color: var(--colorsDarkGreen);
        display: flex;
        flex-wrap: wrap;
        font-family: var(--eyebrowFontFamily);
        font-size: var(--eyebrowFontSize);
        font-weight: var(--eyebrowFontWeight);
        gap: 0.875rem;
        letter-spacing: var(--eyebrowLetterSpacing);
        line-height: var(--eyebrowLineHeight);
        text-transform: uppercase;
    }

    /*
     * Drawn as a shape, not the "·" character: SiteImprove sia-r69 (WCAG 1.4.3)
     * flags the low-contrast middot as a visible text node, but a decorative
     * separator carries no text meaning. As a circle it keeps the exact muted
     * look while leaving the rule's text-node applicability — same appearance,
     * no palette change.
     */
    .art-meta .dot {
        background: var(--colorsTaivas700);
        border-radius: 50%;
        flex: none;
        height: 0.28em;
        opacity: 0.8;
        width: 0.28em;
    }

    h1 {
        color: var(--colorsDeepForest);
        font-family: var(--articleHeadlineFontFamily);
        font-size: 6rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        line-height: 1;
        margin: 0;
        max-width: 950px;
        padding: 1.25rem 0 0;
        text-transform: uppercase;
    }

    .topics {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
        padding-top: 1.75rem;
    }

    .topics a {
        background: var(--colorsForestGreen10);
        color: var(--colorsDeepForest);
        display: inline-block;
        font-family: var(--chipFontFamily);
        font-size: var(--chipFontSize);
        font-weight: var(--chipFontWeight);
        letter-spacing: var(--chipLetterSpacing);
        line-height: 1.6364;
        padding: 0.3125rem 0.625rem;
        text-decoration: none;
        text-transform: uppercase;
    }

    .topics a:hover {
        text-decoration: underline;
        text-underline-offset: 0.125rem;
    }

    @media (max-width: 1199px) {
        h1 {
            font-size: 4.75rem;
        }
    }

    @media (max-width: 999px) {
        h1 {
            font-size: 4rem;
        }
    }

    @media (max-width: 768px) {
        .art-head {
            padding: 1.5rem 0 2rem;
        }

        .art-meta {
            font-size: 0.8125rem;
            gap: 0.625rem;
            letter-spacing: 0.14em;
        }

        h1 {
            font-size: 3.25rem;
            max-width: none;
            padding-top: 0.875rem;
        }

        .topics {
            gap: 0.3125rem;
            padding-top: 1.25rem;
        }

        .topics a {
            font-size: 0.625rem;
            padding: 0.25rem 0.5rem;
        }
    }

    @media (max-width: 380px) {
        h1 {
            font-size: 2.75rem;
        }
    }
</style>
<div class="art-head">
    <div class="sheet">
        <div class="inner">
            <div class="art-meta">
                {dateOnly && <time datetime={dateOnly}>{dateToDisplay}</time>}
                {
                    readingTime && readingTime > 0 && (
                        <Fragment>
                            <span aria-hidden="true" class="dot" />
                            <span>
                                {readingTime} {readingTimeLabel[lang]}
                            </span>
                        </Fragment>
                    )
                }
                {
                    showUpdated && (
                        <Fragment>
                            <span aria-hidden="true" class="dot" />
                            <time datetime={updatedDate}>
                                {updatedLabel[lang]}: {updatedDateToDisplay}
                            </time>
                        </Fragment>
                    )
                }
            </div>
            <h1>{title}</h1>
            {
                tagsToRender.length > 0 && (
                    <ul class="topics">
                        {tagsToRender.map((tag) => (
                            <li>
                                <a href={tag.href}>{tag.name}</a>
                            </li>
                        ))}
                    </ul>
                )
            }
        </div>
    </div>
</div>
