---
import { colors, fontWeights, HEADER_SIZE, sizes, typographics } from '../lib/styles'

const { button, chip, eyebrow, fine, linkRule, text, textSmall } = typographics

/**
 * GlobalStyle renders no elements of its own, so Astro's `define:vars` — which declares
 * the custom properties inline on a component's root elements — has nowhere to put them
 * and every global rule below would reference variables that are never declared. Declare
 * them on `:root` instead, from the same token modules, so the globals resolve everywhere.
 *
 * The same rule keeps pages small: every name declared here must not be repeated in a
 * component's `define:vars`, which would copy it inline onto each of the component's
 * elements. Static tokens that several components share belong here, not there.
 */
const rootTokens: Record<string, string> = {
    buttonFontFamily: button.fontFamily,
    buttonFontSize: button.fontSize,
    buttonFontWeight: String(button.fontWeight),
    buttonLetterSpacing: button.letterSpacing,
    buttonLineHeight: String(button.lineHeight),
    chipFontFamily: chip.fontFamily,
    chipFontSize: chip.fontSize,
    chipFontWeight: String(chip.fontWeight),
    chipLetterSpacing: chip.letterSpacing,
    chipLineHeight: String(chip.lineHeight),
    colorsAquaBlue: colors.aquaBlue,
    colorsBrightGreen: colors.brightGreen,
    colorsBrightSky: colors.brightSky,
    colorsDarkGreen: colors.darkGreen,
    colorsDeepForest: colors.forestGreen,
    colorsEyebrowNeutral: colors.eyebrowNeutral,
    colorsForestGreen: colors.forestGreen,
    colorsForestGreen10: colors.forestGreen10,
    colorsForestGreen70: colors.forestGreen70,
    colorsGray: colors.gray,
    colorsLightSand: colors.lightSand,
    colorsOat: colors.oat,
    colorsOffWhite: colors.offWhite,
    colorsSand: colors.sand,
    colorsSignalBlue: colors.signalBlue,
    colorsTextPrimary: colors.textPrimary,
    colorsTextSecondary: colors.textSecondary,
    colorsWhite: colors.white,
    eyebrowFontFamily: eyebrow.fontFamily,
    eyebrowFontSize: eyebrow.fontSize,
    eyebrowFontWeight: String(eyebrow.fontWeight),
    eyebrowLetterSpacing: eyebrow.letterSpacing,
    eyebrowLineHeight: String(eyebrow.lineHeight),
    fineFontFamily: fine.fontFamily,
    fineFontSize: fine.fontSize,
    fineFontWeight: String(fine.fontWeight),
    fineLineHeight: String(fine.lineHeight),
    fontWeightsBold: String(fontWeights.bold),
    fontWeightsRegular: String(fontWeights.regular),
    fontWeightsSemibold: String(fontWeights.semibold),
    headerSize: HEADER_SIZE,
    linkRuleFontFamily: linkRule.fontFamily,
    linkRuleFontSize: linkRule.fontSize,
    linkRuleFontWeight: String(linkRule.fontWeight),
    linkRuleLetterSpacing: linkRule.letterSpacing,
    linkRuleLineHeight: String(linkRule.lineHeight),
    sectionPad: sizes[1.5],
    sizes05: sizes[0.5],
    sizes1: sizes[1],
    textFontFamily: text.fontFamily,
    textFontSize: text.fontSize,
    textFontWeight: String(text.fontWeight),
    textLineHeight: String(text.lineHeight),
    textSmallFontFamily: textSmall.fontFamily,
    textSmallFontSize: textSmall.fontSize,
    textSmallFontWeight: String(textSmall.fontWeight),
    textSmallLineHeight: String(textSmall.lineHeight),
}

const rootTokenRule = `:root{${Object.entries(rootTokens)
    .map(([name, value]) => `--${name}:${value};`)
    .join('')}}`
---

<style is:inline set:html={rootTokenRule}></style>

<style is:global>
    *,
    ::before,
    ::after {
        border-color: currentcolor;
        border-style: solid;
        border-width: 0px;
        box-sizing: border-box;
    }
    /* big-shoulders-display-v24 - latin (variable, wght 100-900) */
    @font-face {
        font-display: swap;
        font-family: 'Big Shoulders Display';
        font-style: normal;
        font-weight: 100 900;
        src: url(/fonts/big-shoulders-display-v24-latin.woff2) format('woff2');
        unicode-range:
            U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
            U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }

    /* big-shoulders-display-v24 - latin-ext (variable, wght 100-900) */
    @font-face {
        font-display: swap;
        font-family: 'Big Shoulders Display';
        font-style: normal;
        font-weight: 100 900;
        src: url(/fonts/big-shoulders-display-v24-latin-ext.woff2) format('woff2');
        unicode-range:
            U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF,
            U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }

    /* ibm-plex-mono-regular - latin_latin-ext */
    @font-face {
        font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
        font-family: 'IBM Plex Mono';
        font-style: normal;
        font-weight: 400;
        src: url(/fonts/ibm-plex-mono-v20-latin_latin-ext-regular.woff2) format('woff2');
    }

    /* ibm-plex-mono-italic - latin_latin-ext */
    @font-face {
        font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
        font-family: 'IBM Plex Mono';
        font-style: italic;
        font-weight: 400;
        src: url(/fonts/ibm-plex-mono-v20-latin_latin-ext-italic.woff2) format('woff2');
    }

    /* ibm-plex-mono-500 - latin_latin-ext */
    @font-face {
        font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
        font-family: 'IBM Plex Mono';
        font-style: normal;
        font-weight: 500;
        src: url(/fonts/ibm-plex-mono-v20-latin_latin-ext-500.woff2) format('woff2');
    }

    /* ibm-plex-sans-300 - latin_latin-ext */
    @font-face {
        font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
        font-family: 'IBM Plex Sans';
        font-style: normal;
        font-weight: 300;
        src: url(/fonts/ibm-plex-sans-v23-latin_latin-ext-300.woff2) format('woff2');
    }

    /* ibm-plex-sans-regular - latin_latin-ext */
    @font-face {
        font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
        font-family: 'IBM Plex Sans';
        font-style: normal;
        font-weight: 400;
        src: url(/fonts/ibm-plex-sans-v23-latin_latin-ext-regular.woff2) format('woff2');
    }

    /* ibm-plex-sans-italic - latin_latin-ext */
    @font-face {
        font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
        font-family: 'IBM Plex Sans';
        font-style: italic;
        font-weight: 400;
        src: url(/fonts/ibm-plex-sans-v23-latin_latin-ext-italic.woff2) format('woff2');
    }

    /* ibm-plex-sans-600 - latin */
    @font-face {
        font-display: swap;
        font-family: 'IBM Plex Sans';
        font-style: normal;
        font-weight: 600;
        src: url(/fonts/ibm-plex-sans-v23-latin-600.woff2) format('woff2');
        unicode-range:
            U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
            U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }

    /* ibm-plex-sans-600 - latin-ext */
    @font-face {
        font-display: swap;
        font-family: 'IBM Plex Sans';
        font-style: normal;
        font-weight: 600;
        src: url(/fonts/ibm-plex-sans-v23-latin-ext-600.woff2) format('woff2');
        unicode-range:
            U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF,
            U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }

    /* ibm-plex-sans-500 - latin_latin-ext */
    @font-face {
        font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
        font-family: 'IBM Plex Sans';
        font-style: normal;
        font-weight: 500;
        src: url(/fonts/ibm-plex-sans-v23-latin_latin-ext-500.woff2) format('woff2');
    }

    a {
        color: inherit;
        text-decoration: inherit;
    }
    blockquote,
    dl,
    dd,
    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    hr,
    figure,
    p,
    pre {
        margin: 0;
    }
    body {
        line-height: inherit;
        margin: 0;
    }
    button,
    [role='button'] {
        cursor: pointer;
    }
    button,
    [type='button'],
    [type='reset'],
    [type='submit'] {
        appearance: button;
        background-color: transparent;
        background-image: none;
    }
    button,
    input,
    optgroup,
    select,
    textarea {
        color: inherit;
        font-family: inherit;
        font-feature-settings: inherit;
        font-size: 100%;
        font-variation-settings: inherit;
        font-weight: inherit;
        line-height: inherit;
        margin: 0;
        padding: 0;
    }
    button,
    select {
        text-transform: none;
    }
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-size: inherit;
        font-weight: inherit;
    }
    hr {
        border-top-width: 1px;
        color: inherit;
        height: 0px;
    }
    html {
        background-color: rgb(22, 62, 53);
        font-display: swap;
        font-family: 'IBM Plex Sans';
        font-feature-settings: normal;
        font-variation-settings: normal;
        line-height: 1.5;
        overflow-x: clip;
        tab-size: 4;
    }
    img,
    svg,
    video,
    canvas,
    audio,
    iframe,
    embed,
    object {
        display: block;
        vertical-align: middle;
    }
    ol,
    ul,
    menu {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    /* ============================================================
       SIGNAL BAND — layout tokens, base treatments, shared primitives
       (visual rebrand)
       ============================================================ */
    /* motion — quick and flat: colour inverts over --dur-base, a press lands in
       --dur-fast, the mobile menu opens over --dur-menu. Reduced motion zeroes all
       three and the press offset, so components never need their own override. */
    :root {
        --dur-base: 0.18s;
        --dur-fast: 0.12s;
        --dur-menu: 0.28s;
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        --measure: 72rem;
        --pad-x: 3.5rem;
        --press: 2px;
        --prose: 50rem;
        --sec-y: 5.5rem;
    }
    @media (max-width: 1199px) {
        :root {
            --pad-x: 2.5rem;
        }
    }
    @media (max-width: 768px) {
        :root {
            --pad-x: 1.5rem;
            --sec-y: 3.75rem;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        :root {
            --dur-base: 0s;
            --dur-fast: 0s;
            --dur-menu: 0s;
            --press: 0px;
        }
    }
    @media (prefers-reduced-motion: no-preference) {
        html {
            scroll-behavior: smooth;
        }

        /* page to page — a short crossfade instead of a white flash. The header is not
           named: it is in flow rather than sticky, so a named group would swoop it in
           from wherever the old page was scrolled (see Header.astro). Browsers without
           cross-document view transitions navigate as before. */
        @view-transition {
            navigation: auto;
        }
        ::view-transition-old(root),
        ::view-transition-new(root) {
            animation-duration: 200ms;
            animation-timing-function: var(--ease);
        }
    }
    html {
        scrollbar-color: var(--colorsSand) var(--colorsLightSand);
        scrollbar-width: thin;
    }
    ::selection {
        background: var(--colorsBrightGreen);
        color: var(--colorsWhite);
    }
    :focus-visible {
        outline: 3px solid var(--colorsDarkGreen);
        outline-offset: 3px;
    }
    .on-dark :focus-visible {
        outline-color: var(--colorsOat);
    }

    /* layout primitives — a full-bleed shell, a centered measure, and the section rhythm */
    .sheet {
        margin-inline: auto;
        padding-inline: var(--pad-x);
        width: 100%;
    }
    .inner {
        margin-inline: auto;
        max-width: var(--measure);
        width: 100%;
    }
    .section {
        padding-block: var(--sec-y);
    }

    /* eyebrow — the tracked-uppercase label above a plate's heading */
    .eyebrow {
        color: var(--colorsEyebrowNeutral);
        display: block;
        font-family: var(--eyebrowFontFamily);
        font-size: var(--eyebrowFontSize);
        font-weight: var(--eyebrowFontWeight);
        letter-spacing: var(--eyebrowLetterSpacing);
        line-height: var(--eyebrowLineHeight);
        text-transform: uppercase;
    }

    /* buttons — flat and printed at rest, inverted on hover, a 2px press when held */
    .btn {
        border: 2px solid currentcolor;
        color: var(--colorsDeepForest);
        display: inline-block;
        font-family: var(--buttonFontFamily);
        font-size: var(--buttonFontSize);
        font-weight: var(--buttonFontWeight);
        letter-spacing: var(--buttonLetterSpacing);
        line-height: var(--buttonLineHeight);
        padding: 1rem 1.75rem;
        text-decoration: none;
        text-transform: uppercase;
        transition:
            background var(--dur-base) var(--ease),
            color var(--dur-base) var(--ease),
            transform var(--dur-fast) var(--ease);
    }
    .btn:hover {
        background: var(--colorsDeepForest);
        color: var(--colorsLightSand);
    }
    .btn:active {
        transform: translate(var(--press), var(--press));
    }
    .btn--green {
        color: var(--colorsDarkGreen);
    }
    .btn--green:hover {
        background: var(--colorsDarkGreen);
        color: var(--colorsOffWhite);
    }
    /* solid — a filled submit, as on the newsletter form: forest at rest, dark green on hover */
    .btn--solid {
        background: var(--colorsDeepForest);
        border-color: var(--colorsDeepForest);
        color: var(--colorsOat);
        cursor: pointer;
    }
    .btn--solid:hover {
        background: var(--colorsDarkGreen);
        border-color: var(--colorsDarkGreen);
        color: var(--colorsOat);
    }
    /* aria-disabled, not disabled: the button stays clickable so the browser can prompt for
       missing fields, but it looks inactive and neither inverts nor presses. */
    .btn--solid[aria-disabled='true'],
    .btn--solid[aria-disabled='true']:hover {
        background: var(--colorsForestGreen70);
        border-color: transparent;
        /* white keeps 5:1 on the muted fill; oat would drop to 3.4:1 */
        color: var(--colorsWhite);
        cursor: not-allowed;
    }
    .btn[aria-disabled='true']:active {
        transform: none;
    }
    @media (max-width: 768px) {
        .btn {
            font-size: 1.125rem;
            padding: 0.75rem 1.25rem;
        }
    }

    /* link-rule — an underlined tracked-uppercase link, the only inline link treatment */
    .link-rule {
        border-bottom: 2px solid currentcolor;
        color: var(--colorsDarkGreen);
        display: inline-block;
        font-family: var(--linkRuleFontFamily);
        font-size: var(--linkRuleFontSize);
        font-weight: var(--linkRuleFontWeight);
        letter-spacing: var(--linkRuleLetterSpacing);
        line-height: var(--linkRuleLineHeight);
        padding-bottom: 0.1875rem;
        text-decoration: none;
        text-transform: uppercase;
        transition:
            color var(--dur-base) var(--ease),
            transform var(--dur-fast) var(--ease);
    }
    .link-rule:hover {
        color: var(--colorsDeepForest);
    }
    .link-rule:active {
        transform: translate(calc(var(--press) / 2), calc(var(--press) / 2));
    }

    /* the signal band stripe — five equal flex children, one per signal color */
    .stripes {
        display: flex;
        flex-direction: column;
        height: 220px;
    }
    .stripes i {
        flex: 1;
    }
    .stripes i:nth-child(1) {
        background: var(--colorsDarkGreen);
    }
    .stripes i:nth-child(2) {
        background: var(--colorsBrightGreen);
    }
    .stripes i:nth-child(3) {
        background: var(--colorsAquaBlue);
    }
    .stripes i:nth-child(4) {
        background: var(--colorsBrightSky);
    }
    .stripes i:nth-child(5) {
        background: var(--colorsSignalBlue);
    }
    @media (max-width: 768px) {
        .stripes {
            height: 100px;
        }
    }
    .stripes--slim {
        height: 132px;
    }
    @media (max-width: 768px) {
        .stripes--slim {
            height: 72px;
        }
    }

    /* draw-in — the full-size band draws in once, left to right, dark green first,
       as it scrolls into view, and is complete by the time the whole band is visible.
       Scroll-driven, so it never replays on a timer; the slim band that tops inner
       pages stays static. Unsupported browsers and reduced motion get the static band. */
    @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
            /* animation-timeline sits in the per-band rules, not here: the minifier folds
               it into the `animation` shorthand, where it is invalid and drops the rule */
            .stripes:not(.stripes--slim, .stripe--vertical) i {
                animation: stripe-draw linear both;
                transform-origin: left center;
            }
            .stripes:not(.stripes--slim, .stripe--vertical) i:nth-child(1) {
                animation-range: entry 0% entry 60%;
                animation-timeline: view();
            }
            .stripes:not(.stripes--slim, .stripe--vertical) i:nth-child(2) {
                animation-range: entry 10% entry 70%;
                animation-timeline: view();
            }
            .stripes:not(.stripes--slim, .stripe--vertical) i:nth-child(3) {
                animation-range: entry 20% entry 80%;
                animation-timeline: view();
            }
            .stripes:not(.stripes--slim, .stripe--vertical) i:nth-child(4) {
                animation-range: entry 30% entry 90%;
                animation-timeline: view();
            }
            .stripes:not(.stripes--slim, .stripe--vertical) i:nth-child(5) {
                animation-range: entry 40% entry 100%;
                animation-timeline: view();
            }
        }
    }
    @keyframes stripe-draw {
        from {
            transform: scaleX(0);
        }
        to {
            transform: scaleX(1);
        }
    }

    /* site-form — the shared shell of the volunteer and recommendation forms */
    .site-form {
        display: grid;
        gap: 1.5rem;
        margin-top: 2.5rem;
        max-width: 36rem;
        scroll-margin-top: 6.5rem;
    }
    .site-form label,
    .site-form legend,
    .site-form summary {
        color: var(--colorsForestGreen);
        display: block;
        font-weight: var(--fontWeightsSemibold);
        margin-bottom: 0.4rem;
    }
    .site-form legend {
        padding: 0;
    }
    .site-form input[type='text'],
    .site-form input[type='email'],
    .site-form input[type='tel'],
    .site-form select,
    .site-form textarea {
        background-color: var(--colorsWhite);
        border: 1px solid var(--colorsForestGreen);
        border-radius: 0;
        box-sizing: border-box;
        color: var(--colorsForestGreen);
        font: inherit;
        min-height: 3rem;
        padding: 0.6rem 0.75rem;
        width: 100%;
    }
    .site-form fieldset {
        border: 0;
        margin: 0;
        min-width: 0;
        padding: 0;
    }
    .site-form .choice {
        align-items: flex-start;
        cursor: pointer;
        display: flex;
        font-weight: var(--fontWeightsRegular);
        gap: 0.75rem;
        line-height: 1.5;
        margin: 0;
        padding: 0.4rem 0;
    }
    /* Native checkbox, enlarged for touch and centred on the first line of its text. */
    .site-form .choice input {
        accent-color: var(--colorsForestGreen);
        flex-shrink: 0;
        height: 1.375rem;
        margin: 0.05rem 0 0;
        width: 1.375rem;
    }
    .site-form .consent {
        background: var(--colorsForestGreen10);
        padding: 0.75rem 1rem;
    }
    .site-form .honeypot {
        left: -10000px;
        position: absolute;
    }
    .site-form .submit-row {
        display: grid;
        gap: 0.5rem;
        justify-items: start;
    }
    .site-form .submit-hint,
    .site-form .required-note {
        color: var(--colorsForestGreen);
        font-size: var(--textSmallFontSize);
        margin: 0;
    }
    .site-form .req {
        color: var(--colorsDarkGreen);
        font-weight: var(--fontWeightsBold);
    }
    /* Set at runtime by the form's error script. */
    .site-form [aria-invalid='true'] {
        box-shadow: 0 0 0 2px var(--colorsDarkGreen);
    }
    .site-form .form-error {
        background: var(--colorsForestGreen10);
        border-left: 4px solid var(--colorsDarkGreen);
        color: var(--colorsForestGreen);
        font-weight: var(--fontWeightsSemibold);
        margin: 0;
        padding: 0.75rem 1rem;
        /* Clears the sticky header when the #lomake redirect or scrollIntoView lands here. */
        scroll-margin-top: 6.5rem;
    }
    /* Focused by script only, to be read out; it is not a control, so no focus ring. */
    .site-form .form-error:focus {
        outline: none;
    }
</style>
