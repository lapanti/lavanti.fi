---
import { colors, typographics } from '../lib/styles'

interface Props {
    ariaLabel?: string
    items: Array<{ href: string; label: string }>
}

const { ariaLabel, items } = Astro.props
---

<style
    define:vars={{
        chipFontFamily: typographics.chip.fontFamily,
        chipFontWeight: typographics.chip.fontWeight,
        colorsDeepForest: colors.forestGreen,
        colorsLightSand: colors.lightSand,
        colorsSand: colors.sand,
        colorsWhite: colors.white,
    }}
>
    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding-top: 1.25rem;
    }

    .chips a {
        background: var(--colorsWhite);
        border: 2px solid var(--colorsSand);
        color: var(--colorsDeepForest);
        display: block;
        font-family: var(--chipFontFamily);
        font-size: 0.8125rem;
        font-weight: var(--chipFontWeight);
        letter-spacing: 0.12em;
        line-height: 1.4;
        padding: 0.5rem 0.75rem;
        text-decoration: none;
        text-transform: uppercase;
        transition:
            background var(--dur-base) var(--ease),
            border-color var(--dur-base) var(--ease),
            color var(--dur-base) var(--ease),
            transform var(--dur-fast) var(--ease);
    }

    .chips a:hover {
        background: var(--colorsDeepForest);
        border-color: var(--colorsDeepForest);
        color: var(--colorsLightSand);
    }

    .chips a:active {
        transform: translate(calc(var(--press) / 2), calc(var(--press) / 2));
    }
</style>

<ul aria-label={ariaLabel} class="chips">
    {
        items.map((item) => (
            <li>
                <a href={item.href} rel={item.href.startsWith('http') ? 'noopener' : undefined}>
                    {item.label}
                </a>
            </li>
        ))
    }
</ul>
