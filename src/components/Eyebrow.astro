---
import { colors } from '../lib/styles'

interface Props {
    /** Raw color override; wins over tone. */
    color?: string
    tone?: 'neutral' | 'inherit'
}

const { color, tone = 'neutral' } = Astro.props
const eyebrowColor = color ?? (tone === 'inherit' ? 'currentColor' : colors.eyebrowNeutral)
---

<style define:vars={{ eyebrowColor }}>
    .eyebrow {
        color: var(--eyebrowColor);
        display: block;
        font-family: var(--eyebrowFontFamily);
        font-size: var(--eyebrowFontSize);
        font-weight: var(--eyebrowFontWeight);
        letter-spacing: var(--eyebrowLetterSpacing);
        line-height: var(--eyebrowLineHeight);
        text-transform: uppercase;
    }
</style>

<span class="eyebrow"><slot /></span>
