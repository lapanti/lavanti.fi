---
import { colors, typographics } from '../../lib/styles'
import Eyebrow from '../Eyebrow.astro'
import PlateHeading from '../PlateHeading.astro'
import Stripe from '../Stripe.astro'

interface Props {
    eyebrow: string
    heading: string
}

const { eyebrow, heading } = Astro.props
---

<style
    define:vars={{
        colorsBlueInk: colors.blueInk,
        textFontFamily: typographics.text.fontFamily,
        textFontSize: typographics.text.fontSize,
        textFontWeight: typographics.text.fontWeight,
        textLineHeight: typographics.text.lineHeight,
    }}
>
    .synth {
        background: var(--colorsOffWhite);
        overflow: hidden;
        position: relative;
    }

    .synth .inner {
        position: relative;
        z-index: 2;
    }

    .synth :global(p) {
        color: var(--colorsBlueInk);
        font-family: var(--textFontFamily);
        font-size: var(--textFontSize);
        font-weight: var(--textFontWeight);
        line-height: var(--textLineHeight);
        margin: 0;
        max-width: 672px;
        padding-top: 1.75rem;
    }

    .lion {
        display: block;
        height: auto;
        pointer-events: none;
        position: absolute;
        right: -40px;
        top: 20px;
        width: 183px;
        z-index: 1;
    }

    .vstripe {
        position: absolute;
        right: 0;
        top: 0;
        bottom: 0;
        z-index: 1;
    }

    @media (min-width: 769px) {
        .lion {
            display: none;
        }
        .vstripe {
            display: flex;
        }
    }

    @media (min-width: 1200px) {
        .lion {
            display: block;
            right: 244px;
            top: 96px;
            width: clamp(220px, 25vw, 381px);
        }
    }
</style>
<section class="synth section">
    <img alt="" class="lion" height="478" src="/digitaalinen-itsenaisyys-leijona.svg" width="381" />
    <div class="vstripe">
        <Stripe orientation="vertical-reversed" />
    </div>
    <div class="sheet">
        <div class="inner">
            <Eyebrow color={colors.blueInkSoft}>{eyebrow}</Eyebrow>
            <PlateHeading
                color={colors.blueInk}
                letterSpacing={typographics.displaySynthesis.letterSpacing}
                maxWidth="672px"
                sizes={['48px', '96px', typographics.displaySynthesis.fontSize]}
            >
                {heading}
            </PlateHeading>
            <slot />
        </div>
    </div>
</section>
