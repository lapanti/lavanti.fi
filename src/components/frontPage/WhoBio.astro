---
import { getImageSrcset } from '../../lib/images'
import { colors, typographics } from '../../lib/styles'

interface Props {
    credentials?: string[]
    eyebrow: string
    heading: string
    photographer: string
    portraitAlt: string
    portraitImage: string
}

const { credentials = [], eyebrow, heading, photographer, portraitAlt, portraitImage } = Astro.props
const portrait = getImageSrcset(portraitImage, 'hero', [560, 840, 1128])
---

<style
    define:vars={{
        colorsTextPrimary: colors.textPrimary,
        colorsTextSecondary: colors.textSecondary,
        displayFontFamily: typographics.headline.fontFamily,
        displayFontWeight: typographics.headline.fontWeight,
        textFontFamily: typographics.text.fontFamily,
        textFontWeight: typographics.text.fontWeight,
        textLineHeight: typographics.text.lineHeight,
        textSmallFontFamily: typographics.textSmall.fontFamily,
        textSmallFontWeight: typographics.textSmall.fontWeight,
    }}
>
    .who {
        background: var(--colorsLightSand, #e9e4d4);
        padding-block: 6rem;
    }

    .eyebrow {
        color: var(--colorsDarkGreen);
        font-family: var(--eyebrowFontFamily);
        font-size: var(--eyebrowFontSize);
        font-weight: var(--eyebrowFontWeight);
        letter-spacing: var(--eyebrowLetterSpacing);
        line-height: var(--eyebrowLineHeight);
        text-transform: uppercase;
    }

    .who-grid {
        align-items: start;
        display: grid;
        gap: 1.5rem;
        grid-template-columns: 1fr;
    }

    h2 {
        color: var(--colorsDeepForest);
        font-family: var(--displayFontFamily);
        font-size: 2.625rem;
        font-weight: var(--displayFontWeight);
        letter-spacing: -0.02em;
        line-height: 1;
        margin: 0;
        max-width: none;
        padding-top: 1rem;
        text-transform: uppercase;
    }

    .who :global(.bio) {
        color: var(--colorsTextPrimary);
        font-family: var(--textFontFamily);
        font-weight: var(--textFontWeight);
        font-size: 1.0625rem;
        line-height: var(--textLineHeight);
        margin: 0;
        padding-top: 1.2rem;
    }

    figure {
        margin: 0;
        padding-top: 1.5rem;
    }

    .frame {
        background: var(--colorsWhite);
        overflow: hidden;
    }

    .frame img {
        aspect-ratio: 564 / 392;
        height: auto;
        object-fit: cover;
        object-position: 50% 28%;
        width: 100%;
    }

    figcaption {
        color: var(--colorsTextSecondary);
        font-family: var(--textSmallFontFamily);
        font-size: 0.75rem;
        line-height: 1.68;
        padding-top: 0.6rem;
    }

    .creds {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: 1fr;
        padding-top: 2rem;
    }

    .creds li {
        border-left: 4px solid var(--colorsSand);
        color: var(--colorsTextPrimary);
        font-family: var(--textSmallFontFamily);
        font-weight: var(--textSmallFontWeight);
        font-size: 0.9375rem;
        line-height: 1.4;
        padding: 0.25rem 0 0.1875rem 0.75rem;
    }

    @media (min-width: 769px) {
        h2 {
            max-width: 584px;
        }
        .creds {
            border-top: 0;
            gap: 1.25rem;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            padding-top: 3rem;
        }
        .creds li {
            border-left: 0;
            border-top: 4px solid var(--colorsSand);
            padding: 0.7rem 0 0;
        }
    }

    @media (min-width: 1000px) {
        .who-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        .creds {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }
</style>
<section class="who">
    <div class="sheet">
        <div class="inner">
            <div class="who-grid">
                <div>
                    <span class="eyebrow">{eyebrow}</span>
                    <h2>{heading}</h2>
                    <slot />
                </div>
                <figure>
                    <div class="frame">
                        <img
                            alt={portraitAlt}
                            decoding="async"
                            height={portrait.height}
                            loading="lazy"
                            sizes="(max-width: 999px) 100vw, 50vw"
                            src={portrait.src}
                            srcset={portrait.srcset}
                            width={portrait.width}
                        />
                    </div>
                    <figcaption>{photographer}</figcaption>
                </figure>
            </div>
            {
                credentials.length > 0 && (
                    <ul class="creds">
                        {credentials.map((credential) => (
                            <li>{credential}</li>
                        ))}
                    </ul>
                )
            }
        </div>
    </div>
</section>
