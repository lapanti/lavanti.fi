---
import { colors } from '../../lib/styles'
import Eyebrow from '../Eyebrow.astro'
import PlateHeading from '../PlateHeading.astro'

interface Props {
    allPostsHref: string
    allPostsLabel: string
    eyebrow: string
    ground?: 'sand' | 'white'
    heading: string
}

const { allPostsHref, allPostsLabel, eyebrow, ground = 'sand', heading } = Astro.props
const groundColor = { sand: colors.lightSand, white: colors.white }[ground]
---

<style define:vars={{ colorsGround: groundColor }}>
    .writings {
        background: var(--colorsGround);
    }

    .head {
        align-items: flex-end;
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        justify-content: space-between;
    }

    .all-posts-link {
        color: var(--colorsDarkGreen);
        display: none;
        font-family: var(--linkRuleFontFamily);
        font-size: var(--linkRuleFontSize);
        font-weight: var(--linkRuleFontWeight);
        letter-spacing: var(--linkRuleLetterSpacing);
        line-height: var(--linkRuleLineHeight);
        text-decoration: none;
        text-transform: uppercase;
    }

    .content {
        padding-top: 2rem;
    }

    @media (min-width: 769px) {
        .all-posts-link {
            border-bottom: 2px solid currentcolor;
            display: inline-block;
            padding-bottom: 0.1875rem;
        }
    }
</style>
<section class="writings section">
    <div class="sheet">
        <div class="inner">
            <div class="head">
                <div>
                    <Eyebrow color={colors.darkGreen}>{eyebrow}</Eyebrow>
                    <PlateHeading color={colors.forestGreen} sizes={['48px', '58px']}>{heading}</PlateHeading>
                </div>
                <a class="all-posts-link" href={allPostsHref}>{allPostsLabel}</a>
            </div>
            <div class="content">
                <slot />
            </div>
        </div>
    </div>
</section>
