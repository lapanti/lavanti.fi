---
import { colors, typographics } from '../../lib/styles'
import Eyebrow from '../Eyebrow.astro'
import PlateHeading from '../PlateHeading.astro'

interface Read {
    href: string
    label: string
}

interface Props {
    eyebrow: string
    heading: string
    id?: string
    reads: Read[]
    tone: 'aqua' | 'oat' | 'peach'
    vocab: Read[]
}

const { eyebrow, heading, id, reads, tone, vocab } = Astro.props

const toneColors = {
    aqua: { ground: colors.aquaBlue, ink: colors.aquaInk, inkSoft: colors.aquaInkSoft },
    oat: { ground: colors.oat, ink: colors.oatInk, inkSoft: colors.oatSoft },
    peach: { ground: colors.peach, ink: colors.peachInk, inkSoft: colors.peachInkSoft },
}[tone]
---

<style
    define:vars={{
        chipFontFamily: typographics.chip.fontFamily,
        chipFontSize: typographics.chip.fontSize,
        chipFontWeight: typographics.chip.fontWeight,
        chipGround: colors.forestGreen10,
        chipLetterSpacing: typographics.chip.letterSpacing,
        chipLineHeight: typographics.chip.lineHeight,
        ground: toneColors.ground,
        ink: toneColors.ink,
        pillarAnswerFontFamily: typographics.pillarAnswer.fontFamily,
        pillarAnswerFontSize: typographics.pillarAnswer.fontSize,
        pillarAnswerFontWeight: typographics.pillarAnswer.fontWeight,
        pillarAnswerLineHeight: typographics.pillarAnswer.lineHeight,
        textSmallFontFamily: typographics.textSmall.fontFamily,
        textSmallFontSize: typographics.textSmall.fontSize,
        textSmallFontWeight: typographics.textSmall.fontWeight,
        textSmallLineHeight: typographics.textSmall.lineHeight,
    }}
>
    .pillar {
        background: var(--ground);
    }

    .pillar-body {
        display: grid;
        gap: 1.25rem;
        grid-template-columns: 1fr;
        padding-top: 2.5rem;
    }

    .pillar :global(.answer) {
        color: var(--ink);
        font-family: var(--pillarAnswerFontFamily);
        font-size: var(--pillarAnswerFontSize);
        font-weight: var(--pillarAnswerFontWeight);
        line-height: var(--pillarAnswerLineHeight);
        margin: 0;
    }

    .pillar :global(.detail) {
        color: var(--ink);
        font-family: var(--textSmallFontFamily);
        font-size: var(--textSmallFontSize);
        font-weight: var(--textSmallFontWeight);
        line-height: var(--textSmallLineHeight);
        margin: 0;
        opacity: 0.9;
    }

    .vocab {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        padding-top: 1.25rem;
    }

    .vocab li {
        background: var(--chipGround);
        color: var(--ink);
        font-family: var(--chipFontFamily);
        font-size: var(--chipFontSize);
        font-weight: var(--chipFontWeight);
        letter-spacing: var(--chipLetterSpacing);
        line-height: var(--chipLineHeight);
        padding: 0.28rem 0.55rem;
        text-transform: uppercase;
    }

    .vocab a {
        color: inherit;
        display: block;
        margin: -0.28rem -0.55rem;
        padding: 0.28rem 0.55rem;
        text-decoration: none;
        transition:
            background var(--dur-base) var(--ease),
            color var(--dur-base) var(--ease),
            transform var(--dur-fast) var(--ease);
    }

    .vocab a:hover {
        background: var(--ink);
        color: var(--ground);
    }

    .vocab a:active {
        transform: translate(var(--press), var(--press));
    }

    .reads {
        border-top: 3px solid var(--ink);
        display: grid;
        gap: 0.55rem;
        margin-top: 1.5rem;
        padding-top: 1.15rem;
    }

    .reads a {
        color: var(--ink);
        display: block;
        font-family: var(--textSmallFontFamily);
        font-size: var(--textSmallFontSize);
        font-weight: 500;
        line-height: 1.4;
        text-decoration: none;
    }

    .reads a:hover {
        text-decoration: underline;
        text-underline-offset: 0.1875rem;
    }

    @media (min-width: 1200px) {
        .pillar-body {
            gap: 3.5rem;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>
<section class="pillar section" id={id}>
    <div class="sheet">
        <div class="inner">
            <Eyebrow color={toneColors.inkSoft}>{eyebrow}</Eyebrow>
            <PlateHeading
                color={toneColors.ink}
                letterSpacing="-0.02em"
                letterSpacingDesktop={typographics.displayPillar.letterSpacing}
                sizes={['48px', '80px', typographics.displayPillar.fontSize]}
            >
                {heading}
            </PlateHeading>
            <div class="pillar-body">
                <div>
                    <slot name="answer" />
                    <ul class="vocab">
                        {
                            vocab.map((item) => (
                                <li>
                                    <a href={item.href}>{item.label}</a>
                                </li>
                            ))
                        }
                    </ul>
                </div>
                <div>
                    <slot name="detail" />
                    <ul class="reads">
                        {
                            reads.map((read) => (
                                <li>
                                    <a href={read.href}>{read.label}</a>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>
