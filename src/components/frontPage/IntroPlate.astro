---
import { colors, sizes, typographics } from '../../lib/styles'
import Eyebrow from '../Eyebrow.astro'
import PlateHeading from '../PlateHeading.astro'

interface Props {
    eyebrow: string
    ground?: 'sand' | 'white'
    heading: string
    id?: string
}

const { eyebrow, ground = 'sand', heading, id } = Astro.props
const groundColor = ground === 'sand' ? colors.lightSand : colors.offWhite
---

<style define:vars={{ groundColor, sizes45: sizes[45] }}>
    .plate {
        background: var(--groundColor);
    }

    .body {
        display: grid;
        gap: 1.25rem;
        padding-top: 1.5rem;
    }

    .body :global(p) {
        color: var(--colorsDeepForest);
        font-family: var(--textFontFamily);
        font-size: var(--textFontSize);
        font-weight: var(--textFontWeight);
        line-height: var(--textLineHeight);
        margin: 0;
        max-width: var(--sizes45);
    }
</style>
<section class="plate section" id={id}>
    <div class="sheet">
        <div class="inner">
            <Eyebrow>{eyebrow}</Eyebrow>
            <PlateHeading
                color={colors.forestGreen}
                letterSpacing={typographics.display.letterSpacing}
                sizes={['48px', '88px', typographics.display.fontSize]}
            >
                {heading}
            </PlateHeading>
            <slot name="video" />
            <div class="body">
                <slot />
            </div>
        </div>
    </div>
</section>
