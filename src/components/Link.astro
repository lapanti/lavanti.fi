---
import { colors, sizes } from '../lib/styles'

interface Props {
    /** Only used when external: suffixed with the Finnish "opens in a new tab" note. */
    ariaLabel?: string
    /** Opens in a new tab with noopener noreferrer. */
    external?: boolean
    heading?: boolean
    href: string
    rel?: string
}

const { ariaLabel, external = false, heading, href, rel } = Astro.props
---

<style define:vars={{ colorsDarkGreen: colors.darkGreen, colorsDarkMoss: colors.darkMoss, sizes0125: sizes[0.125] }}>
    a {
        color: var(--colorsDarkMoss);
        text-decoration: underline;
        text-decoration-thickness: var(--sizes0125);
        transition:
            color var(--dur-base) var(--ease),
            text-decoration-thickness var(--dur-base) var(--ease);
    }
    /* hover thickens the rule rather than swapping it for a box — the printed link */
    a:hover {
        text-decoration-thickness: 3px;
    }
    a.heading {
        display: block;
        min-block-size: 2.75rem;
    }

    :global(.prose) a {
        color: inherit;
        text-decoration: underline;
        text-decoration-thickness: 1.5px;
        text-underline-offset: 0.1875rem;
    }

    :global(.prose) a:hover {
        color: var(--colorsDarkGreen);
        text-decoration-thickness: 3px;
    }
</style>
<a
    aria-label={external && ariaLabel ? `${ariaLabel} (linkki aukeaa uudessa välilehdessä)` : null}
    class:list={[{ heading }]}
    href={href}
    rel={external ? `${rel ? rel : ''} noopener noreferrer` : `${rel ? rel : ''}`}
    target={external ? '_blank' : null}><slot /></a
>
