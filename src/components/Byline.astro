---
import type { Lang } from '../content/nav'
import type { AuthorEntry } from '../content/person'
import type { CoAuthorEntry, ExternalPublication } from '../lib/byline'

import {
    coAuthorsHeading,
    coAuthorsOf,
    formatPublicationDate,
    publicationLanguageSuffix,
    publicationPrefix,
} from '../lib/byline'
import { getImage } from '../lib/images'
import SmartLink from './SmartLink.astro'

interface Props {
    authors: AuthorEntry[]
    externalPublications?: ExternalPublication[]
    lang: Lang
}

const { authors, externalPublications, lang } = Astro.props
const coAuthors = coAuthorsOf(authors)
const heading = coAuthorsHeading(coAuthors.length, lang)
---

<style>
    .byline {
        display: grid;
        gap: 1.5rem;
        margin-top: 2rem;
    }

    .co-authors p {
        margin-block: 0;
    }

    .co-authors-heading {
        color: var(--colorsTextSecondary);
        font-family: var(--fineFontFamily);
        font-size: var(--fineFontSize);
        font-weight: 700;
        line-height: var(--fineLineHeight);
    }

    .co-authors ul {
        display: grid;
        gap: 0.875rem;
        list-style: none;
        margin: 0.75rem 0 0;
        padding: 0;
    }

    /* A smaller AuthorCard: photo beside name and role, centred on the text block. */
    .co-authors li.has-photo {
        align-items: center;
        column-gap: 0.875rem;
        display: grid;
        grid-template-columns: 3rem 1fr;
    }

    @media (min-width: 769px) {
        .co-authors li.has-photo {
            grid-template-columns: 3.5rem 1fr;
        }
    }

    .co-authors img {
        aspect-ratio: 4 / 5;
        border-radius: 4px;
        height: auto;
        object-fit: cover;
        width: 100%;
    }

    .name {
        font-family: var(--textFontFamily);
        font-weight: 700;
        line-height: 1.5;
    }

    .role {
        color: var(--colorsTextSecondary);
        font-family: var(--fineFontFamily);
        font-size: var(--fineFontSize);
        font-weight: var(--fineFontWeight);
        line-height: var(--fineLineHeight);
        margin-top: 0.125rem;
    }

    .elsewhere-note {
        border-top: 3px solid var(--colorsSand);
        display: grid;
        gap: 0.375rem;
        padding-top: 1.125rem;
    }

    .elsewhere-note p {
        color: var(--colorsTextSecondary);
        font-family: var(--textFontFamily);
        font-size: 0.875rem;
        font-weight: var(--textFontWeight);
        line-height: 1.6;
        margin-block: 0;
    }
</style>
{
    (coAuthors.length > 0 || externalPublications) && (
        <div class="byline">
            {coAuthors.length > 0 && (
                <aside aria-label={heading} class="co-authors">
                    <p class="co-authors-heading">{heading}</p>
                    <ul>
                        {coAuthors.map((coAuthor: CoAuthorEntry) => {
                            const photo = coAuthor.image ? getImage(coAuthor.image, 'avatar') : undefined

                            return (
                                <li class:list={{ 'has-photo': photo }}>
                                    {photo && (
                                        <img
                                            alt=""
                                            decoding="async"
                                            height={photo.height}
                                            loading="lazy"
                                            src={photo.src}
                                            width={photo.width}
                                        />
                                    )}
                                    <div>
                                        <p class="name">{coAuthor.name}</p>
                                        {coAuthor.role && <p class="role">{coAuthor.role}</p>}
                                    </div>
                                </li>
                            )
                        })}
                    </ul>
                </aside>
            )}
            {externalPublications && (
                <div class="elsewhere-note">
                    {externalPublications.map((pub: ExternalPublication) => {
                        const suffix = publicationLanguageSuffix(pub, lang)

                        return (
                            <p>
                                {/* prettier-ignore */}
                                <em>{`${publicationPrefix[lang]}: `}{pub.url ? <SmartLink href={pub.url}>{pub.name}</SmartLink> : pub.name}{`, ${formatPublicationDate(pub.date, lang)}${suffix}.`}</em>
                            </p>
                        )
                    })}
                </div>
            )}
        </div>
    )
}
