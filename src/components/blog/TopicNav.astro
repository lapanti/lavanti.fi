---
import { colors, typographics } from '../../lib/styles'

interface Item {
    href: string
    label: string
}

interface Props {
    ariaLabel: string
    currentId?: string
    items: Item[]
}

const { ariaLabel, currentId, items } = Astro.props
const topicNavScript = `(function(){
  function init(){
    var links = [].slice.call(document.querySelectorAll('.topicnav a'));
    if (!links.length) return;
    var pairs = [];
    links.forEach(function(a){
      var href = a.getAttribute('href');
      if (!href) return;
      var s = document.getElementById(decodeURIComponent(href.slice(1)));
      if (s) pairs.push({a: a, s: s});
    });
    if (!pairs.length) return;
    var current = null;
    function update(){
      var line = window.scrollY + (window.innerWidth <= 768 ? 60 : 0) + 96;
      var found = null;
      pairs.forEach(function(p){
        var top = p.s.getBoundingClientRect().top + window.scrollY;
        if (top <= line && top + p.s.offsetHeight > line) found = p;
      });
      if (found === current) return;
      current = found;
      pairs.forEach(function(p){ p.a.setAttribute('aria-current', 'false'); });
      if (found) found.a.setAttribute('aria-current', 'true');
    }
    window.addEventListener('scroll', update, {passive: true});
    window.addEventListener('resize', update, {passive: true});
    update();
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();`
---

<style
    define:vars={{
        topicNavAquaBlue: colors.aquaBlue,
        topicNavBrightGreen: colors.brightGreen,
        topicNavDisplayFontFamily: typographics.display.fontFamily,
        topicNavForestGreen: colors.forestGreen,
        topicNavOat: colors.oat,
        topicNavTransparent: colors.transparent,
    }}
>
    .topicnav {
        background: var(--topicNavForestGreen);
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .topicnav .inner {
        padding: 0;
    }

    .topicnav .sheet {
        padding-inline: 0;
    }

    .topicnav ul {
        -webkit-overflow-scrolling: touch;
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        padding-left: 0.75rem;
        padding-right: 0.75rem;
        scrollbar-width: none;
    }

    .topicnav ul::-webkit-scrollbar {
        display: none;
    }

    .topicnav a {
        border-bottom: 3px solid var(--topicNavTransparent);
        color: var(--topicNavAquaBlue);
        display: block;
        font-family: var(--topicNavDisplayFontFamily);
        font-size: 0.9375rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        line-height: 1.3;
        padding: 1rem 1.25rem 0.8125rem;
        text-decoration: none;
        text-transform: uppercase;
        transition:
            background var(--dur-base) var(--ease),
            border-color var(--dur-base) var(--ease),
            color var(--dur-base) var(--ease);
        white-space: nowrap;
    }

    .topicnav a:hover {
        border-bottom-color: var(--topicNavBrightGreen);
        color: var(--topicNavOat);
    }

    .topicnav a[aria-current='true'] {
        border-bottom-color: var(--topicNavOat);
        color: var(--topicNavOat);
    }

    .topicnav :focus-visible {
        outline: 3px solid var(--topicNavOat);
        outline-offset: -3px;
    }

    @media (max-width: 768px) {
        .topicnav {
            top: 60px;
        }

        .topicnav a {
            font-size: 0.875rem;
            padding: 0.8125rem 0.875rem 0.625rem;
        }
    }
</style>

<nav aria-label={ariaLabel} class="topicnav">
    <div class="sheet">
        <div class="inner">
            <ul>
                {
                    items.map((item) => (
                        <li>
                            <a aria-current={item.href === `#${currentId}` ? 'true' : 'false'} href={item.href}>
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</nav>
<script is:inline set:html={topicNavScript} />
