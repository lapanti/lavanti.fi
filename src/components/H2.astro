---
import { typographics } from '../lib/styles'

interface Props {
    itemProp?: string
}

const { itemProp } = Astro.props
---

<style
    define:vars={{
        articleHeadlineFontFamily: typographics.articleHeadline.fontFamily,
        articleHeadlineFontWeight: typographics.articleHeadline.fontWeight,
        articleHeadlineLetterSpacing: typographics.articleHeadline.letterSpacing,
        articleHeadlineLineHeight: typographics.articleHeadline.lineHeight,
        h2FontFamily: typographics.h2.fontFamily,
        h2FontSize: typographics.h2.fontSize,
        h2FontWeight: typographics.h2.fontWeight,
        h2LineHeight: typographics.h2.lineHeight,
    }}
>
    h2 {
        font-family: var(--h2FontFamily);
        font-weight: var(--h2FontWeight);
        font-size: var(--h2FontSize);
        line-height: var(--h2LineHeight);
        grid-column-start: 3;
        margin-block: 0;
    }

    :global(.prose) h2 {
        color: var(--colorsDarkGreen);
        font-family: var(--articleHeadlineFontFamily);
        font-size: 2rem;
        font-weight: var(--articleHeadlineFontWeight);
        letter-spacing: var(--articleHeadlineLetterSpacing);
        line-height: var(--articleHeadlineLineHeight);
        grid-column-start: auto;
        margin-top: 3rem;
        text-transform: uppercase;
    }

    @media (min-width: 769px) {
        :global(.prose) h2 {
            font-size: 2.625rem;
        }
    }
</style>
<h2 itemprop={itemProp}>
    <slot />
</h2>
