---
import { colors, typographics } from '../../lib/styles'

interface Props {
    href: string
    kicker: string
    note?: string
    value: string
}

const { href, kicker, note, value } = Astro.props
---

<style
    define:vars={{
        chipFontFamily: typographics.chip.fontFamily,
        chipFontWeight: typographics.chip.fontWeight,
        colorsAquaBlue: colors.aquaBlue,
        colorsDarkGreen: colors.darkGreen,
        colorsDeepForest: colors.forestGreen,
        colorsLightSand: colors.lightSand,
        colorsOat: colors.oat,
        colorsOffWhite: colors.offWhite,
        colorsTextSecondary: colors.textSecondary,
        displayFontFamily: typographics.display.fontFamily,
        displayFontWeight: typographics.display.fontWeight,
    }}
>
    .channel {
        background: var(--colorsOffWhite);
        border: 3px solid var(--colorsDeepForest);
        color: var(--colorsDeepForest);
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
        padding: 1.75rem;
        text-decoration: none;
        transition:
            background var(--dur-base) var(--ease),
            color var(--dur-base) var(--ease),
            transform var(--dur-fast) var(--ease);
    }

    .channel:hover {
        background: var(--colorsDeepForest);
        color: var(--colorsLightSand);
    }

    .channel:active {
        transform: translate(var(--press), var(--press));
    }

    .ch-k {
        color: var(--colorsDarkGreen);
        font-family: var(--chipFontFamily);
        font-size: 0.9375rem;
        font-weight: var(--chipFontWeight);
        letter-spacing: 0.176em;
        line-height: 1.3;
        text-transform: uppercase;
        transition: color var(--dur-base) var(--ease);
    }

    .channel:hover .ch-k {
        color: var(--colorsOat);
    }

    .ch-v {
        color: inherit;
        font-family: var(--displayFontFamily);
        font-size: 2.375rem;
        font-weight: var(--displayFontWeight);
        letter-spacing: -0.01em;
        line-height: 1;
        word-break: break-word;
    }

    .ch-n {
        color: var(--colorsTextSecondary);
        font-size: 0.875rem;
        line-height: 1.6;
        transition: color var(--dur-base) var(--ease);
    }

    .channel:hover .ch-n {
        color: var(--colorsAquaBlue);
    }
</style>
<a class="channel" href={href}>
    <span class="ch-k">{kicker}</span>
    <span class="ch-v">{value}</span>
    {note && <span class="ch-n">{note}</span>}
</a>
