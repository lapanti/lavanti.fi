---
import { colors } from '../lib/styles'
import Eyebrow from './Eyebrow.astro'
import PlateHeading from './PlateHeading.astro'

interface Props {
    eyebrow?: string
    ground?: 'sand' | 'offWhite' | 'gray' | 'oat' | 'white'
    heading?: string
    id?: string
    labelledBy?: string
    /** Less space above the content on phones, for a plate that must fit the first screen. */
    tight?: boolean
}

const { eyebrow, ground = 'sand', heading, id, labelledBy, tight = false } = Astro.props
const groundColor = {
    gray: colors.gray,
    oat: colors.oat,
    offWhite: colors.offWhite,
    sand: colors.lightSand,
    white: colors.white,
}[ground]
---

<style define:vars={{ groundColor }}>
    .plate {
        background: var(--groundColor);
    }
    @media (max-width: 768px) {
        .plate--tight {
            padding-top: 1.5rem;
        }
    }
</style>

<section aria-labelledby={labelledBy} class:list={['plate', 'section', { 'plate--tight': tight }]} id={id}>
    <div class="sheet">
        <div class="inner">
            {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
            {
                heading && (
                    <PlateHeading color={colors.forestGreen} sizes={['48px', '58px']}>
                        {heading}
                    </PlateHeading>
                )
            }
            <slot />
        </div>
    </div>
</section>
