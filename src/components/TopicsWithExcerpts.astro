---
import type { Lang } from '../content/nav'
import type { LocalTag } from '../content/tags/types'

import { getCategoryPath, tags } from '../content/tags'
import { getExcerptPosts, type Post } from '../lib/posts'
import TopicNav from './blog/TopicNav.astro'
import TopicPlate from './blog/TopicPlate.astro'
import Excerpt from './excerptList/Excerpt.astro'

interface Props {
    ariaLabel: string
    ids: string[]
    lang: Lang
}

const { ariaLabel, ids, lang } = Astro.props

const POSTS_PER_TOPIC = 3

const seenIds = new Set<number>()

const sections: Array<{ posts: Post[]; tag: LocalTag }> = []
for (const id of ids) {
    const tag = tags.find((t) => t.id === id)
    if (!tag) continue

    const posts = await getExcerptPosts({ excludeIds: [...seenIds], lang, limit: POSTS_PER_TOPIC, tag: tag.id })
    posts.forEach((p) => seenIds.add(p.id))

    sections.push({ posts, tag })
}

const seeAllLabels: Record<Lang, (name: string) => string> = {
    en: (name) => `All posts about ${name}`,
    fi: (name) => `Kaikki kirjoitukset aiheesta ${name}`,
    sv: (name) => `Alla inlägg om ${name}`,
}

const navItems = sections.map(({ tag }) => ({ href: `#${tag.id}`, label: tag.names[lang] }))
---

<style>
    .post-grid {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: 1fr;
    }

    @media (min-width: 769px) {
        .post-grid {
            gap: 2.5rem;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 1200px) {
        .post-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>

<TopicNav ariaLabel={ariaLabel} items={navItems} />
{
    sections.map(({ tag, posts }, index) => (
        <TopicPlate
            allPostsHref={getCategoryPath(tag.id, lang)!}
            allPostsLabel={seeAllLabels[lang](tag.names[lang])}
            ground={index % 2 === 0 ? 'sand' : 'offWhite'}
            heading={tag.names[lang]}
            id={tag.id}
            intro={tag.descriptions[lang]}
        >
            <ul class="post-grid">
                {posts.map((node) => (
                    <Excerpt
                        alt={node.alt}
                        date={node.publishDate}
                        excerpt={node.description}
                        image={node.heroImage}
                        lang={lang}
                        slug={node.url.replace(/^\//, '').replace(/\/$/, '')}
                        tags={node.tags}
                        title={node.title}
                    />
                ))}
            </ul>
        </TopicPlate>
    ))
}
