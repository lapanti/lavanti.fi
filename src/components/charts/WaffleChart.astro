---
/**
 * A waffle chart: one square per billion euros, grouped and coloured by category, with
 * a legend whose entries select a group.
 *
 * Selecting a group (tap, click or Enter on its legend entry, or a tap on one of its
 * squares) dims every other square and opens the group's breakdown under its entry.
 * Hovering with a mouse previews the same without selecting.
 *
 * The squares are decoration: the grid is aria-hidden, and the legend carries every
 * figure as text. Without JavaScript every breakdown stays open, so nothing is lost;
 * the post's bullet list under the chart states the same figures once more.
 */
import type { Lang } from '../../content/nav'
import type { WaffleData } from '../../content/publicFinance2027'

import { decimalsFor, formatBn, formatShare, groupValue, waffleCells } from '../../lib/publicFinanceCharts'
import { fontWeights, typographics } from '../../lib/styles'

interface Props {
    caption: string
    data: WaffleData
    lang: Lang
}

const { caption, data, lang } = Astro.props

const hints: Record<Lang, string> = {
    en: 'Select a category to highlight it and see its breakdown.',
    fi: 'Valitse erä, niin näet sen ruudut ja osat.',
    sv: 'Välj en post för att markera den och se dess delar.',
}

const cells = waffleCells(data)
const groups = data.groups.map((group) => {
    const value = groupValue(group)

    return {
        ...group,
        amount: formatBn(value, lang, decimalsFor(value)),
        share: formatShare((100 * value) / data.total, lang, decimalsFor(value)),
        swatch: group.items[0],
    }
})

/*
 * Inline like the site's other component scripts: the CSP allows inline scripts and
 * there is no bundler step for component JS. Idempotent, because each chart on the
 * page carries a copy and the first copy to run already wires up every chart.
 */
const script = `(function(){
var charts = document.querySelectorAll('[data-waffle]:not([data-ready])');
Array.prototype.forEach.call(charts, function(chart){
    chart.setAttribute('data-ready', '');
    Array.prototype.forEach.call(chart.querySelectorAll('button[data-group]'), function(button){
        button.setAttribute('aria-pressed', 'false');
    });
    var cells = chart.querySelectorAll('.grid .cell');
    var buttons = chart.querySelectorAll('button[data-group]');
    var selected = null;
    function show(key){
        if (key) chart.setAttribute('data-active', key); else chart.removeAttribute('data-active');
        Array.prototype.forEach.call(cells, function(cell){
            cell.classList.toggle('is-on', cell.getAttribute('data-group') === key);
        });
        Array.prototype.forEach.call(buttons, function(button){
            var on = button.getAttribute('data-group') === key;
            button.parentNode.classList.toggle('is-on', on);
        });
    }
    function select(key){
        selected = selected === key ? null : key;
        Array.prototype.forEach.call(buttons, function(button){
            button.setAttribute('aria-pressed', String(button.getAttribute('data-group') === selected));
        });
        show(selected);
    }
    Array.prototype.forEach.call(buttons, function(button){
        var key = button.getAttribute('data-group');
        button.addEventListener('click', function(){ select(key); });
        button.addEventListener('pointerenter', function(event){ if (event.pointerType === 'mouse' && !selected) show(key); });
        button.addEventListener('pointerleave', function(event){ if (event.pointerType === 'mouse' && !selected) show(null); });
    });
    chart.querySelector('.grid').addEventListener('click', function(event){
        var cell = event.target.closest('.cell');
        if (cell) select(cell.getAttribute('data-group'));
    });
});
})();`

/*
 * Set on the figure by hand rather than through `define:vars`: Astro copies those onto
 * every element that has its own `style`, which here is each of 160+ squares.
 */
const vars = Object.entries({
    amountFontFamily: typographics.textSmall.fontFamily,
    amountFontSize: typographics.textSmall.fontSize,
    captionFontFamily: typographics.caption.fontFamily,
    captionFontSize: typographics.caption.fontSize,
    captionLineHeight: typographics.caption.lineHeight,
    hintFontFamily: typographics.caption.fontFamily,
    hintFontSize: typographics.caption.fontSize,
    nameFontFamily: typographics.nav.fontFamily,
    nameFontSize: typographics.nav.fontSize,
    nameFontWeight: typographics.nav.fontWeight,
    nameLetterSpacing: typographics.nav.letterSpacing,
    nameTextTransform: typographics.nav.textTransform,
    selectedWeight: fontWeights.semibold,
})
    .map(([name, value]) => `--${name}: ${value}`)
    .join('; ')
---

<style>
    .waffle {
        grid-column-start: 3;
        margin: var(--sizes1) 0;
    }

    .layout {
        display: grid;
        gap: 1.25rem;
    }

    .grid {
        align-content: start;
        cursor: pointer;
        display: grid;
        gap: 3px;
        grid-template-columns: repeat(13, minmax(0, 1fr));
    }

    /* Rounded corners are an allowed exception to the square system for chart marks (design-system spec). */
    .cell {
        aspect-ratio: 1;
        background: var(--c);
        border-radius: 2px;
        transition: opacity 150ms ease;
    }

    .cell--half {
        background: linear-gradient(135deg, transparent 50%, var(--c) 50%);
        box-shadow: inset 0 0 0 1.5px var(--c);
    }

    .cell--hatch {
        background: repeating-linear-gradient(135deg, var(--c) 0 2px, transparent 2px 5px);
        box-shadow: inset 0 0 0 1.5px var(--c);
    }

    /* State the script sets is wrapped in :global(); the markup never renders it. */
    .waffle:global([data-active]) .grid .cell {
        opacity: 0.15;
    }

    .waffle:global([data-active]) .grid .cell:global(.is-on) {
        opacity: 1;
    }

    .hint {
        color: var(--colorsTextSecondary);
        display: none;
        font-family: var(--hintFontFamily);
        font-size: var(--hintFontSize);
        margin: 0 0 0.5rem;
    }

    .waffle:global([data-ready]) .hint {
        display: block;
    }

    .groups,
    .items {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .group {
        align-items: start;
        background: none;
        border: 0;
        border-radius: 2px;
        color: inherit;
        cursor: pointer;
        display: grid;
        gap: 0 0.625rem;
        grid-template-columns: 1.25rem 1fr;
        padding: 0.375rem 0.25rem;
        text-align: start;
        width: 100%;
    }

    .group:hover,
    .group:global([aria-pressed='true']) {
        background: var(--colorsForestGreen10);
    }

    .group:focus-visible {
        outline: 3px solid var(--colorsDarkGreen);
        outline-offset: 1px;
    }

    .swatch {
        aspect-ratio: 1;
        margin-top: 0.125rem;
        width: 1.25rem;
    }

    .swatch--small {
        margin-top: 0.3rem;
        width: 0.75rem;
    }

    .name {
        color: var(--colorsForestGreen);
        font-family: var(--nameFontFamily);
        font-size: var(--nameFontSize);
        font-weight: var(--nameFontWeight);
        letter-spacing: var(--nameLetterSpacing);
        line-height: 1.3;
        text-transform: var(--nameTextTransform);
    }

    .amount,
    .item {
        color: var(--colorsTextSecondary);
        font-family: var(--amountFontFamily);
        font-size: var(--amountFontSize);
        line-height: 1.5;
    }

    .amount {
        grid-column: 2;
    }

    .items {
        display: grid;
        gap: 0.125rem;
        padding: 0.25rem 0.25rem 0.5rem 2.125rem;
    }

    .item {
        align-items: start;
        display: grid;
        gap: 0.5rem;
        grid-template-columns: 0.75rem 1fr;
    }

    /* Before the script runs, or without it, every breakdown stays open. */
    /*
     * Collapsed visually only: a screen reader reads every breakdown in the legend
     * whether or not its group is selected, since selecting is a visual aid.
     */
    .waffle:global([data-ready]) .groups > li:not(:global(.is-on)) .items,
    .visually-hidden {
        clip-path: inset(50%);
        height: 1px;
        overflow: hidden;
        padding: 0;
        position: absolute;
        white-space: nowrap;
        width: 1px;
    }

    .waffle:global([data-ready]) .groups > li:global(.is-on) .name {
        font-weight: var(--selectedWeight);
    }

    figcaption {
        color: var(--colorsTextSecondary);
        font-family: var(--captionFontFamily);
        font-size: var(--captionFontSize);
        line-height: var(--captionLineHeight);
        padding-top: 0.75rem;
    }

    /*
     * On a phone the legend sits under the grid. Two columns keep grid and legend on
     * one screen, so the squares a tap highlights stay in view.
     */
    @media (max-width: 768px) {
        .groups {
            align-items: start;
            display: grid;
            gap: 0 0.5rem;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .items {
            padding-left: 0.25rem;
        }

        /* "Sosiaalivakuutusmaksut" is wider than half a phone screen. */
        .name {
            font-size: 1rem;
            hyphens: auto;
            overflow-wrap: anywhere;
        }
    }

    @media (min-width: 769px) {
        .layout {
            grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .cell {
            transition: none;
        }
    }
</style>

<figure class="waffle" data-waffle style={vars}>
    <div class="layout">
        <div aria-hidden="true" class="grid">
            {
                cells.map((cell) => (
                    <span
                        class:list={['cell', `cell--${cell.fill}`]}
                        data-group={cell.group}
                        style={`--c: ${cell.color}`}
                    />
                ))
            }
        </div>
        <div class="legend">
            <p class="hint">{hints[lang]}</p>
            <ul class="groups">
                {
                    groups.map((group) => (
                        <li>
                            <button class="group" data-group={group.key} type="button">
                                <span
                                    aria-hidden="true"
                                    class:list={['swatch', 'cell', `cell--${group.swatch.fill}`]}
                                    style={`--c: ${group.swatch.color}`}
                                />
                                <span class="name">{group.label[lang]}</span>
                                <span class="amount">
                                    {group.amount}
                                    <span aria-hidden="true">·</span>
                                    <span class="visually-hidden">,</span>
                                    {group.share}
                                </span>
                            </button>
                            {group.items.length > 1 && (
                                <ul class="items">
                                    {group.items.map((item) => (
                                        <li class="item">
                                            <span
                                                aria-hidden="true"
                                                class:list={['swatch', 'swatch--small', 'cell', `cell--${item.fill}`]}
                                                style={`--c: ${item.color}`}
                                            />
                                            <span>
                                                {item.label[lang]} {formatBn(item.value, lang, 1)}
                                            </span>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
    <figcaption>{caption}</figcaption>
    <script is:inline set:html={script} />
</figure>
