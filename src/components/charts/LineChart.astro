---
/**
 * One or more yearly series as lines, with the same readout and slider as InterestChart:
 * the readout row follows the pointer, a tap or the arrow keys, and the figures are in a
 * table under the chart.
 *
 * The lines are an SVG stretched to the plot (`preserveAspectRatio="none"`, strokes kept
 * even by `non-scaling-stroke`); the axis labels, the marker and its dots are HTML on top,
 * so no text is ever stretched with the drawing.
 *
 * Series are never joined: one that ends where another starts (two definitions of the
 * same ratio) keeps its own line, and a year that both have shows both in the readout.
 */
import type { Lang } from '../../content/nav'
import type { LineChartData } from '../../content/pensionFunding'

import { formatDecimal, formatShare } from '../../lib/publicFinanceCharts'
import { fontWeights, typographics } from '../../lib/styles'

interface Props {
    caption: string
    data: LineChartData
    lang: Lang
}

const { caption, data, lang } = Astro.props

const copy = {
    en: { slider: 'select a year', table: 'Figures as a table', year: 'Year' },
    fi: { slider: 'valitse vuosi', table: 'Luvut taulukkona', year: 'Vuosi' },
    sv: { slider: 'välj år', table: 'Siffrorna i tabellform', year: 'År' },
}[lang]

const format = (value: number) => (data.percent ? formatShare(value, lang, 1) : formatDecimal(value, 1, lang))

const years = data.series.flatMap((series) => series.points.map(([year]) => year))
const first = Math.min(...years)
const last = Math.max(...years)
const x = (year: number) => (100 * (year - first)) / (last - first)
const y = (value: number) => (100 * value) / data.yMax

/* Every year that any series has, in order; one marker stop each. */
const steps = [...new Set(years)]
    .sort((a, b) => a - b)
    .map((year) => {
        const values = data.series.flatMap((series) => {
            const point = series.points.find(([at]) => at === year)

            return point ? [{ key: series.key, label: series.label[lang], value: point[1] }] : []
        })
        const [lead, ...rest] = values
        const detail = [
            ...(data.series.length > 1 ? [lead.label] : []),
            ...rest.map((other) => `${other.label} ${format(other.value)}`),
        ].join(' · ')

        return { detail, value: format(lead.value), values, year }
    })
const initial = steps[steps.length - 1]

const lines = data.series.map((series) => ({
    ...series,
    path: series.points.map(([year, value]) => `${x(year).toFixed(2)},${(100 - y(value)).toFixed(2)}`).join(' '),
}))

/* Same progressive enhancement as InterestChart: inert markup until this runs. */
const script = `(function(){
var charts = document.querySelectorAll('[data-line]:not([data-ready])');
Array.prototype.forEach.call(charts, function(chart){
    chart.setAttribute('data-ready', '');
    var plot = chart.querySelector('.plot');
    plot.setAttribute('role', 'slider');
    plot.setAttribute('tabindex', '0');
    plot.setAttribute('aria-label', plot.getAttribute('data-slider-label'));
    plot.setAttribute('aria-orientation', 'horizontal');
    var area = chart.querySelector('.area');
    var steps = chart.querySelectorAll('.step');
    var first = Number(steps[0].getAttribute('data-year'));
    var last = Number(steps[steps.length - 1].getAttribute('data-year'));
    var year = chart.querySelector('.readout-year');
    var value = chart.querySelector('.readout-value');
    var detail = chart.querySelector('.readout-detail');
    var pinned = steps.length - 1;
    function show(index){
        var step = steps[index];
        Array.prototype.forEach.call(steps, function(other){ other.classList.toggle('is-on', other === step); });
        year.textContent = step.getAttribute('data-year');
        value.textContent = step.getAttribute('data-value');
        detail.textContent = step.getAttribute('data-detail');
        plot.setAttribute('aria-valuemin', String(first));
        plot.setAttribute('aria-valuemax', String(last));
        plot.setAttribute('aria-valuenow', step.getAttribute('data-year'));
        var text = step.getAttribute('data-year') + ': ' + step.getAttribute('data-value');
        if (step.getAttribute('data-detail')) text += ', ' + step.getAttribute('data-detail');
        plot.setAttribute('aria-valuetext', text);
    }
    function nearest(event){
        var box = area.getBoundingClientRect();
        var at = first + (event.clientX - box.left) / box.width * (last - first);
        var best = 0;
        Array.prototype.forEach.call(steps, function(step, index){
            if (Math.abs(Number(step.getAttribute('data-year')) - at) < Math.abs(Number(steps[best].getAttribute('data-year')) - at)) best = index;
        });
        return best;
    }
    plot.addEventListener('pointermove', function(event){ show(nearest(event)); });
    plot.addEventListener('pointerleave', function(){ show(pinned); });
    plot.addEventListener('click', function(event){ pinned = nearest(event); show(pinned); });
    plot.addEventListener('keydown', function(event){
        var next = {
            ArrowLeft: pinned - 1, ArrowDown: pinned - 1, ArrowRight: pinned + 1, ArrowUp: pinned + 1,
            PageDown: pinned - 5, PageUp: pinned + 5, Home: 0, End: steps.length - 1
        }[event.key];
        if (next === undefined) return;
        event.preventDefault();
        pinned = Math.min(steps.length - 1, Math.max(0, next));
        show(pinned);
    });
    show(pinned);
});
})();`

/* On the figure by hand, not `define:vars`, which Astro would copy onto every step; see WaffleChart. */
const vars = Object.entries({
    axisFontFamily: typographics.caption.fontFamily,
    axisFontSize: typographics.caption.fontSize,
    captionFontFamily: typographics.caption.fontFamily,
    captionFontSize: typographics.caption.fontSize,
    captionLineHeight: typographics.caption.lineHeight,
    readoutFontFamily: typographics.textSmall.fontFamily,
    readoutFontSize: typographics.textSmall.fontSize,
    tableFontFamily: typographics.textSmall.fontFamily,
    tableFontSize: typographics.textSmall.fontSize,
    valueFontFamily: typographics.nav.fontFamily,
    valueFontSize: typographics.nav.fontSize,
    valueFontWeight: typographics.nav.fontWeight,
    valueLetterSpacing: typographics.nav.letterSpacing,
    yearFontWeight: fontWeights.semibold,
})
    .map(([name, value]) => `--${name}: ${value}`)
    .join('; ')
---

<style>
    .line {
        grid-column-start: 3;
        margin: var(--sizes1) 0;
    }

    .readout {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        font-family: var(--readoutFontFamily);
        font-size: var(--readoutFontSize);
        gap: 0 0.75rem;
        min-height: 2rem;
        padding-bottom: 0.5rem;
    }

    .readout-year {
        color: var(--colorsTextPrimary);
        font-weight: var(--yearFontWeight);
    }

    .readout-value {
        color: var(--colorsForestGreen);
        font-family: var(--valueFontFamily);
        font-size: var(--valueFontSize);
        font-weight: var(--valueFontWeight);
        letter-spacing: var(--valueLetterSpacing);
    }

    .readout-detail {
        color: var(--colorsTextSecondary);
    }

    .plot {
        display: grid;
        gap: 0 0.5rem;
        grid-template-columns: auto minmax(0, 1fr);
        touch-action: pan-y;
    }

    .line:global([data-ready]) .plot {
        cursor: crosshair;
    }

    .plot:focus-visible {
        outline: 3px solid var(--colorsDarkGreen);
        outline-offset: 4px;
    }

    .unit {
        color: var(--colorsTextSecondary);
        font-family: var(--axisFontFamily);
        font-size: var(--axisFontSize);
        grid-column: 1 / -1;
        padding-bottom: 0.5rem;
    }

    .visually-hidden {
        clip-path: inset(50%);
        height: 1px;
        overflow: hidden;
        position: absolute;
        white-space: nowrap;
        width: 1px;
    }

    .y-axis {
        height: 16rem;
        position: relative;
        width: 1.5rem;
    }

    .y-axis span,
    .x-axis span {
        color: var(--colorsTextSecondary);
        font-family: var(--axisFontFamily);
        font-size: var(--axisFontSize);
        line-height: 1;
        position: absolute;
    }

    .y-axis span {
        bottom: var(--at);
        right: 0;
        transform: translateY(50%);
    }

    .area {
        border-bottom: 1px solid var(--colorsForestGreen);
        height: 16rem;
        position: relative;
    }

    .grid-line {
        border-top: 1px solid var(--colorsForestGreen10);
        bottom: var(--at);
        left: 0;
        position: absolute;
        right: 0;
    }

    svg {
        height: 100%;
        inset: 0;
        overflow: visible;
        position: absolute;
        width: 100%;
    }

    polyline {
        fill: none;
        stroke: var(--colorsForestGreen);
        stroke-linejoin: round;
        stroke-width: 3;
    }

    .series--muted {
        stroke: var(--colorsEyebrowNeutral);
    }

    .series--dashed {
        stroke-dasharray: 6 4;
    }

    .step {
        bottom: 0;
        left: var(--x);
        position: absolute;
        top: 0;
        visibility: hidden;
    }

    /* The script sets .is-on; :global() because the markup never renders it. */
    .step:global(.is-on) {
        visibility: visible;
    }

    .rule {
        border-left: 1px solid var(--colorsBrightGreen);
        bottom: 0;
        position: absolute;
        top: 0;
    }

    .dot {
        background: var(--colorsBrightGreen);
        border: 2px solid var(--colorsWhite);
        border-radius: 50%;
        bottom: var(--y);
        height: 0.75rem;
        position: absolute;
        transform: translate(-50%, 50%);
        width: 0.75rem;
    }

    .x-axis {
        grid-column: 2;
        height: 1.5rem;
        position: relative;
    }

    .x-axis span {
        left: var(--at);
        padding-top: 0.375rem;
        transform: translateX(-50%);
    }

    .x-axis span:first-child {
        transform: none;
    }

    .x-axis span:last-child {
        transform: translateX(-100%);
    }

    .key {
        color: var(--colorsTextSecondary);
        display: flex;
        flex-wrap: wrap;
        font-family: var(--readoutFontFamily);
        font-size: var(--readoutFontSize);
        gap: 0.25rem 1.5rem;
        list-style: none;
        margin: 0;
        padding: 0.5rem 0 0;
    }

    .key li {
        align-items: center;
        display: flex;
        gap: 0.5rem;
    }

    .key svg {
        height: 0.75rem;
        position: static;
        width: 1.5rem;
    }

    .key line {
        stroke: var(--colorsForestGreen);
        stroke-width: 3;
    }

    .key line.key-line--muted {
        stroke: var(--colorsEyebrowNeutral);
    }

    .key line.key-line--dashed {
        stroke-dasharray: 6 4;
    }

    details {
        font-family: var(--tableFontFamily);
        font-size: var(--tableFontSize);
        padding-top: 0.75rem;
    }

    summary {
        color: var(--colorsDarkGreen);
        cursor: pointer;
    }

    table {
        border-collapse: collapse;
        margin-top: 0.5rem;
        width: 100%;
    }

    th,
    td {
        border-bottom: 1px solid var(--colorsForestGreen10);
        padding: 0.25rem 0.5rem 0.25rem 0;
        text-align: end;
    }

    th:first-child,
    td:first-child {
        text-align: start;
    }

    figcaption {
        color: var(--colorsTextSecondary);
        font-family: var(--captionFontFamily);
        font-size: var(--captionFontSize);
        line-height: var(--captionLineHeight);
        padding-top: 0.75rem;
    }

    @media (min-width: 769px) {
        .y-axis,
        .area {
            height: 20rem;
        }
    }
</style>

<figure class="line" data-line style={vars}>
    <p aria-hidden="true" class="readout">
        <span class="readout-year">{initial.year}</span>
        <span class="readout-value">{initial.value}</span>
        <span class="readout-detail">{initial.detail}</span>
    </p>
    <div class="plot" data-slider-label={`${data.unit[lang]}, ${copy.slider}`}>
        <span aria-hidden="true" class="unit">{data.unit[lang]}</span>
        <div aria-hidden="true" class="y-axis">
            {data.yTicks.map((tick) => <span style={`--at: ${y(tick)}%`}>{tick}</span>)}
        </div>
        <div aria-hidden="true" class="area">
            {data.yTicks.slice(1).map((tick) => <span class="grid-line" style={`--at: ${y(tick)}%`} />)}
            <svg preserveAspectRatio="none" viewBox="0 0 100 100">
                {
                    lines.map((series) => (
                        <polyline
                            class:list={[{ 'series--dashed': series.dashed, 'series--muted': series.muted }]}
                            points={series.path}
                            vector-effect="non-scaling-stroke"
                        />
                    ))
                }
            </svg>
            {
                steps.map((step) => (
                    <span
                        class="step"
                        data-detail={step.detail}
                        data-value={step.value}
                        data-year={step.year}
                        style={`--x: ${x(step.year).toFixed(2)}%`}
                    >
                        <span class="rule" />
                        {step.values.map((point) => (
                            <span class="dot" style={`--y: ${y(point.value).toFixed(2)}%`} />
                        ))}
                    </span>
                ))
            }
        </div>
        <div aria-hidden="true" class="x-axis">
            {data.xTicks.map((year) => <span style={`--at: ${x(year).toFixed(2)}%`}>{year}</span>)}
        </div>
    </div>
    {
        data.series.length > 1 && (
            <ul class="key">
                {data.series.map((series) => (
                    <li>
                        <svg aria-hidden="true" viewBox="0 0 24 12">
                            <line
                                class:list={[{ 'key-line--dashed': series.dashed, 'key-line--muted': series.muted }]}
                                x1="0"
                                x2="24"
                                y1="6"
                                y2="6"
                            />
                        </svg>
                        {series.label[lang]}
                    </li>
                ))}
            </ul>
        )
    }
    <details>
        <summary>{copy.table}</summary>
        <table>
            <caption class="visually-hidden">{caption}</caption>
            <thead>
                <tr>
                    <th scope="col">{copy.year}</th>
                    {data.series.map((series) => <th scope="col">{series.label[lang]}</th>)}
                </tr>
            </thead>
            <tbody>
                {
                    steps.map((step) => (
                        <tr>
                            <th scope="row">{step.year}</th>
                            {data.series.map((series) => {
                                const point = step.values.find((value) => value.key === series.key)

                                return <td>{point ? format(point.value) : ''}</td>
                            })}
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </details>
    <figcaption>{caption}</figcaption>
    <script is:inline set:html={script} />
</figure>
