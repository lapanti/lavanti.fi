---
interface Props {
    excerpt?: string
}

const { excerpt } = Astro.props
---

<style>
    p {
        color: var(--colorsTextSecondary);
        font-family: var(--textSmallFontFamily);
        font-size: 0.9375rem;
        font-weight: var(--textSmallFontWeight);
        line-height: var(--textSmallLineHeight);
        margin: 0;
    }
</style>
<p itemprop="description">{excerpt}</p>
