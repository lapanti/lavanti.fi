---
import { getImageSrcset } from '../../../lib/images'
import { typographics } from '../../../lib/styles'

interface Props {
    alt?: string
    image?: string
    slug?: string
    title: string
}

const { alt, image, slug, title } = Astro.props
const img = image ? getImageSrcset(image, 'postThumb', [400, 560, 750, 1120]) : undefined
---

<style
    define:vars={{
        titleFontFamily: typographics.postTitle.fontFamily,
        titleFontWeight: typographics.postTitle.fontWeight,
        titleLineHeight: typographics.postTitle.lineHeight,
    }}
>
    a {
        color: inherit;
        display: block;
        text-decoration: none;
    }

    .shot {
        height: 184px;
        overflow: hidden;
    }

    .shot img {
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    h3 {
        color: var(--colorsDarkGreen);
        font-family: var(--titleFontFamily);
        font-size: 1.125rem;
        font-weight: var(--titleFontWeight);
        line-height: var(--titleLineHeight);
        margin: 0;
        padding-top: 0.55rem;
    }

    a:hover h3 {
        text-decoration: underline;
        text-underline-offset: 0.1875rem;
    }
</style>
<a href={`/${slug}/`} rel="permalink">
    {
        img && (
            <div class="shot">
                <img
                    alt={alt ?? ''}
                    height={img.height}
                    loading="lazy"
                    sizes="(max-width: 768px) 100vw, (max-width: 1199px) 50vw, 33vw"
                    src={img.src}
                    srcset={img.srcset}
                    width={img.width}
                />
            </div>
        )
    }
    <h3 itemprop="headline">{title}</h3>
</a>
