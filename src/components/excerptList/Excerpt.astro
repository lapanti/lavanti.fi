---
import type { Lang } from '../../content/nav'

import { getCategoryPath, getTagName } from '../../content/tags'
import { colors, typographics } from '../../lib/styles'
import Banner from './excerpt/Banner.astro'
import Description from './excerpt/Description.astro'

interface Props {
    alt?: string
    date?: string
    excerpt?: string
    image?: string
    lang?: Lang
    slug?: string
    tags?: string[]
    title: string
}

const { alt, date, excerpt, image, lang = 'fi', slug, tags, title } = Astro.props

const [dateOnly] = (date ?? '').split('T')
const [year, month, day] = dateOnly ? dateOnly.split('-') : []
const dateToDisplay = dateOnly ? `${day}.${month}.${year}` : ''

/*
 * Excerpt cards cap the chip row to keep it on a single line; the full tag
 * list still renders on the post page. Slice after filtering so we keep N
 * resolvable tags, not N raw ids that may include unresolved ones.
 */
const MAX_EXCERPT_TAGS = 3

const tagsToRender = (tags ?? [])
    .map((tagId) => {
        const name = getTagName(tagId, lang)

        return name ? { id: tagId, name } : undefined
    })
    .filter((t): t is { id: string; name: string } => t !== undefined)
    .slice(0, MAX_EXCERPT_TAGS)
---

<style
    define:vars={{
        chipFontFamily: typographics.chip.fontFamily,
        chipFontSize: typographics.chip.fontSize,
        chipFontWeight: typographics.chip.fontWeight,
        chipLetterSpacing: typographics.chip.letterSpacing,
        chipLineHeight: typographics.chip.lineHeight,
        colorsDarkGreen: colors.darkGreen,
        colorsForestGreen10: colors.forestGreen10,
        colorsSand: colors.sand,
        colorsTextSecondary: colors.textSecondary,
        colorsWhite: colors.white,
        metaFontFamily: typographics.meta.fontFamily,
        metaFontWeight: typographics.meta.fontWeight,
        metaLetterSpacing: typographics.meta.letterSpacing,
        metaLineHeight: typographics.meta.lineHeight,
    }}
>
    li {
        border-top: 5px solid var(--colorsSand);
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        min-width: 0;
        padding-top: 1rem;
        width: 100%;
    }

    time {
        color: var(--colorsTextSecondary);
        font-family: var(--metaFontFamily);
        font-size: 0.875rem;
        font-weight: var(--metaFontWeight);
        letter-spacing: var(--metaLetterSpacing);
        line-height: var(--metaLineHeight);
        padding-top: 0.25rem;
        text-transform: uppercase;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
        margin-top: auto;
        padding-top: 0.875rem;
    }

    .tags li {
        border-top: 0;
        display: block;
        width: auto;
    }

    .tags a {
        background: var(--colorsForestGreen10);
        color: var(--colorsDarkGreen);
        display: block;
        font-family: var(--chipFontFamily);
        font-size: var(--chipFontSize);
        font-weight: var(--chipFontWeight);
        letter-spacing: var(--chipLetterSpacing);
        line-height: var(--chipLineHeight);
        padding: 0.25rem 0.5625rem;
        text-decoration: none;
        text-transform: uppercase;
        transition:
            background var(--dur-base) var(--ease),
            color var(--dur-base) var(--ease),
            transform var(--dur-fast) var(--ease);
    }

    .tags a:hover {
        background: var(--colorsDarkGreen);
        color: var(--colorsWhite);
    }

    .tags a:active {
        transform: translate(var(--press), var(--press));
    }
</style>
<li>
    <article aria-label={title} itemscope itemtype="https://schema.org/CreativeWork">
        <Banner alt={alt} image={image} slug={slug} title={title} />
        {date && <time datetime={dateOnly}>{dateToDisplay}</time>}
        <Description excerpt={excerpt} />
    </article>
    {
        tagsToRender.length > 0 && (
            <ul class="tags">
                {tagsToRender.map(({ id, name }) => (
                    <li>
                        <a href={getCategoryPath(id, lang)}>{name}</a>
                    </li>
                ))}
            </ul>
        )
    }
</li>
