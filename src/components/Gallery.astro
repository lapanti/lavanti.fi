---
import type { GalleryPhoto } from '../content/gallery'
import type { Lang } from '../content/nav'

import { getDownloadUrl, getImageSrcset } from '../lib/images'
import { colors, sizes, typographics } from '../lib/styles'

interface Props {
    lang: Lang
    photos: GalleryPhoto[]
}

const { lang, photos } = Astro.props

const creditPrefix: Record<Lang, string> = { en: 'Photo', fi: 'Kuva', sv: 'Foto' }
const downloadHeading: Record<Lang, string> = {
    en: 'Download',
    fi: 'Lataa',
    sv: 'Ladda ner',
}
const aspectLabels: Record<Lang, Record<'nelio' | 'pysty' | 'vaaka', string>> = {
    en: { nelio: 'Square', pysty: 'Portrait', vaaka: 'Landscape' },
    fi: { nelio: 'Neliö', pysty: 'Pysty', vaaka: 'Vaaka' },
    sv: { nelio: 'Kvadrat', pysty: 'Stående', vaaka: 'Liggande' },
}
const aspects = ['nelio', 'pysty', 'vaaka'] as const
---

<style
    define:vars={{
        buttonFontFamily: typographics.linkRule.fontFamily,
        buttonFontSize: typographics.linkRule.fontSize,
        buttonFontWeight: typographics.linkRule.fontWeight,
        buttonLetterSpacing: typographics.linkRule.letterSpacing,
        captionFontFamily: typographics.caption.fontFamily,
        captionFontSize: typographics.caption.fontSize,
        colorsForestGreen: colors.forestGreen,
        colorsGray: colors.gray,
        colorsTextSecondary: colors.textSecondary,
        sizes05: sizes[0.5],
        sizes1: sizes[1],
        sizes2: sizes[2],
    }}
>
    ul {
        display: grid;
        gap: var(--sizes2);
        grid-template-columns: 1fr;
        list-style: none;
        margin: 0;
        padding: var(--sizes2) 0 0;
    }

    figure {
        display: flex;
        flex-direction: column;
        gap: var(--sizes05);
        margin: 0;
        width: 100%;
    }

    img {
        aspect-ratio: 1 / 1;
        background: var(--colorsGray);
        border-radius: 4px;
        height: auto;
        object-fit: cover;
        width: 100%;
    }

    figcaption {
        color: var(--colorsTextSecondary);
        font-family: var(--captionFontFamily);
        font-size: var(--captionFontSize);
    }

    .downloads {
        align-items: baseline;
        display: flex;
        flex-wrap: wrap;
        gap: var(--sizes05);
    }

    .downloads-label {
        color: var(--colorsForestGreen);
        font-family: var(--buttonFontFamily);
        font-size: var(--buttonFontSize);
        font-weight: var(--buttonFontWeight);
        letter-spacing: var(--buttonLetterSpacing);
        text-transform: uppercase;
    }

    a {
        border: 1px solid var(--colorsForestGreen);
        border-radius: 4px;
        color: var(--colorsForestGreen);
        display: inline-block;
        font-family: var(--buttonFontFamily);
        font-size: var(--buttonFontSize);
        font-weight: var(--buttonFontWeight);
        letter-spacing: var(--buttonLetterSpacing);
        padding: var(--sizes05) var(--sizes1);
        text-decoration: none;
        text-transform: uppercase;
    }

    a:hover,
    a:focus-visible {
        background: var(--colorsForestGreen);
        color: var(--colorsWhite);
    }

    @media (min-width: 769px) {
        ul {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 1200px) {
        ul {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>

<ul>
    {
        photos.map((photo) => {
            const thumbSlug = (photo.crops.nelio ?? photo.crops.pysty ?? photo.crops.vaaka)!
            const thumb = getImageSrcset(thumbSlug, '1x1', [400, 800])
            const availableAspects = aspects.filter((aspect) => photo.crops[aspect])

            return (
                <li>
                    <figure>
                        <img
                            alt={photo.alt[lang]}
                            height={thumb.height}
                            loading="lazy"
                            sizes="(max-width: 768px) 100vw, (max-width: 1199px) 50vw, 33vw"
                            src={thumb.src}
                            srcset={thumb.srcset}
                            width={thumb.width}
                        />
                        {photo.photographer && (
                            <figcaption>
                                {creditPrefix[lang]}: {photo.photographer}
                            </figcaption>
                        )}
                        <div class="downloads">
                            <span class="downloads-label">{downloadHeading[lang]}:</span>
                            {availableAspects.map((aspect) => (
                                <a
                                    aria-label={`${downloadHeading[lang]}: ${photo.alt[lang]} (${aspectLabels[lang][aspect]})`}
                                    download={`${photo.crops[aspect]}.jpg`}
                                    href={getDownloadUrl(photo.crops[aspect]!)}
                                >
                                    {aspectLabels[lang][aspect]}
                                </a>
                            ))}
                        </div>
                    </figure>
                </li>
            )
        })
    }
</ul>
