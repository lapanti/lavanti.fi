---
import type { Lang } from '../content/nav'

import { newsletterContent } from '../content/newsletter'
import { colors, signalBandFontFamilies, sizes, typographics } from '../lib/styles'
import Eyebrow from './Eyebrow.astro'
import H2 from './H2.astro'
import Link from './Link.astro'
import Paragraph from './Paragraph.astro'

interface Props {
    lang: Lang
    /**
     * `split` is the front page's oat newsletter band: an eyebrow, a headline-scale
     * heading and the blurb in one column, the form and its fine print in the other.
     * `stacked` (default) is the compact full-width form the inner pages carry.
     */
    layout?: 'split' | 'stacked'
}

const { lang, layout = 'stacked' } = Astro.props
const isSplit = layout === 'split'

const content = newsletterContent[lang]

const formId = lang === 'sv' ? 'mlb2-38379286' : lang === 'en' ? 'mlb2-38366393' : 'mlb2-38347721'
const formAction =
    lang === 'sv'
        ? 'https://assets.mailerlite.com/jsonp/2182645/forms/181754147902588391/subscribe'
        : lang === 'en'
          ? 'https://assets.mailerlite.com/jsonp/2182645/forms/181740004170532163/subscribe'
          : 'https://assets.mailerlite.com/jsonp/2182645/forms/181706420545128273/subscribe'
const takelUrl =
    lang === 'sv'
        ? 'https://assets.mailerlite.com/jsonp/2182645/forms/181754147902588391/takel'
        : lang === 'en'
          ? 'https://assets.mailerlite.com/jsonp/2182645/forms/181740004170532163/takel'
          : 'https://assets.mailerlite.com/jsonp/2182645/forms/181706420545128273/takel'
const subscribeClass = `ml-subscribe-form-${formId.replace('mlb2-', '')}`
const privacyHref = `/${lang}/privacy-policy/`
---

<style
    define:vars={{
        colorsDarkGreen: colors.darkGreen,
        colorsDeepForest: colors.forestGreen,
        colorsOat: colors.oat,
        colorsOatSoft: colors.oatSoft,
        colorsOnOatBody: colors.onOatBody,
        colorsOnOatEyebrow: colors.onOatEyebrow,
        colorsWhite: colors.white,
        fineFontFamily: typographics.fine.fontFamily,
        fineFontSize: typographics.fine.fontSize,
        fineLineHeight: typographics.fine.lineHeight,
        fontFamiliesHeading: signalBandFontFamilies.heading,
        fontFamiliesSans: signalBandFontFamilies.sans,
        headlineFontFamily: typographics.headline.fontFamily,
        headlineFontWeight: typographics.headline.fontWeight,
        headlineLetterSpacing: typographics.headline.letterSpacing,
        sizes1: sizes[1],
        sizes125: sizes[1.25],
        textFontFamily: typographics.text.fontFamily,
        textFontSize: typographics.text.fontSize,
        textLineHeight: typographics.text.lineHeight,
    }}
>
    /* LOADER */
    .ml-form-embedSubmitLoad {
        display: inline-block;
        width: var(--sizes125);
        height: var(--sizes125);
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -0.0625rem;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
    }

    .ml-form-embedSubmitLoad:after {
        content: ' ';
        display: block;
        width: 11px;
        height: 11px;
        margin: 0.0625rem;
        border-radius: 50%;
        border: 4px solid var(--colorsWhite);
        border-color: var(--colorsWhite) var(--colorsWhite) var(--colorsWhite) transparent;
    }
    @media (prefers-reduced-motion: no-preference) {
        .ml-form-embedSubmitLoad:after {
            animation: ml-form-embedSubmitLoad 1.2s linear infinite;
        }
        @keyframes ml-form-embedSubmitLoad {
            0% {
                transform: rotate(0deg);
            }
            100% {
                transform: rotate(360deg);
            }
        }
    }
    .ml-form-embedContainer {
        box-sizing: border-box;
        grid-column-start: 3;
        margin: 0 auto;
    }
    .ml-form-embedContainer span,
    .ml-form-embedContainer button {
        text-transform: none !important;
        letter-spacing: normal !important;
    }
    .ml-form-embedContainer .ml-form-embedWrapper {
        background-color: transparent;
        box-sizing: border-box;
        display: inline-block !important;
        margin: 0;
        padding: 0;
        position: relative;
    }
    .ml-form-embedContainer .ml-form-embedWrapper.embedForm {
        width: 100%;
    }
    .ml-form-embedContainer .ml-form-align-center {
        text-align: center;
    }
    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody,
    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-successBody {
        padding: var(--sizes125) var(--sizes125) 0 var(--sizes125);
    }
    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody.ml-form-embedBodyHorizontal {
        padding-bottom: 0;
    }
    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-embedContent,
    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-successBody .ml-form-successContent {
        text-align: left;
        margin: 0 0 var(--sizes125) 0;
    }
    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody form {
        margin: 0;
        width: 100%;
    }
    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-formContent {
        margin: 0 0 var(--sizes125) 0;
        width: 100%;
    }
    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-formContent.horozintalForm {
        margin: 0;
        padding: 0 0 var(--sizes125) 0;
        width: 100%;
        height: auto;
        float: left;
    }
    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-horizontalRow input::placeholder {
        color: var(--colorsOatSoft);
    }
    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-horizontalRow {
        /* one shared height for the field and the submit, so the two sit level when the
           row is side by side. Derived from the button's own type spec — one 1.4em line
           of 21px display type plus its 15.2px block padding — floored at the 44px
           touch target. The loading state inherits it too, so the row cannot jump. */
        --control-height: max(2.75rem, calc(21px * 1.4 + 30.4px));

        height: auto;
        width: 100%;
        float: left;
    }
    .ml-form-formContent.horozintalForm .ml-form-horizontalRow .ml-input-horizontal {
        width: 70%;
        float: left;
    }
    .ml-form-formContent.horozintalForm .ml-form-horizontalRow .ml-button-horizontal {
        width: 30%;
        float: left;
    }
    .ml-form-formContent.horozintalForm .ml-form-horizontalRow .horizontal-fields {
        box-sizing: border-box;
        float: left;
        padding-right: 0.625rem;
    }
    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-horizontalRow input {
        background-color: transparent;
        border-color: var(--colorsDeepForest);
        border-radius: 0;
        border-style: solid;
        border-width: 3px;
        box-sizing: border-box;
        caret-color: var(--colorsDarkGreen);
        color: var(--colorsDeepForest);
        font-family: var(--fontFamiliesSans);
        font-size: 1.0625rem;
        line-height: var(--sizes125);
        margin-bottom: 0;
        margin-top: 0;
        min-height: var(--control-height);
        overflow-y: initial;
        padding: 0.9rem 1rem;
        width: 100%;
    }
    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-horizontalRow button {
        align-items: center;
        background-color: var(--colorsDeepForest) !important;
        border: 0 !important;
        border-radius: 0;
        box-shadow: none;
        color: var(--colorsOat) !important;
        cursor: pointer;
        display: inline-flex;
        font-family: var(--fontFamiliesHeading);
        font-size: 1.3125rem !important;
        font-weight: 800;
        height: auto;
        justify-content: center;
        letter-spacing: 0.08em !important;
        line-height: 1.4;
        margin: 0 !important;
        min-height: var(--control-height);
        padding: 0.95rem 2rem !important;
        text-transform: uppercase !important;
        transition:
            background-color var(--dur-base) var(--ease),
            transform var(--dur-fast) var(--ease);
        width: 100%;
    }
    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-horizontalRow button:hover {
        background-color: var(--colorsDarkGreen) !important;
    }
    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-horizontalRow button:active {
        transform: translate(var(--press), var(--press));
    }
    @media only screen and (max-width: 1199px) {
        .ml-form-formContent.horozintalForm {
            float: left !important;
        }
        .ml-form-formContent.horozintalForm .ml-form-horizontalRow {
            height: auto !important;
            width: 100% !important;
            float: left !important;
        }
        .ml-form-formContent.horozintalForm .ml-form-horizontalRow .ml-input-horizontal {
            width: 100% !important;
        }
        .ml-form-formContent.horozintalForm .ml-form-horizontalRow .ml-input-horizontal > div {
            padding-right: 0 !important;
            padding-bottom: 0.625rem;
        }
        .ml-form-formContent.horozintalForm .ml-button-horizontal {
            width: 100% !important;
        }
    }
    .ml-mobileButton-horizontal {
        display: none;
    }

    .ml-mobileButton-horizontal button {
        background-color: var(--colorsDeepForest) !important;
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        color: var(--colorsOat) !important;
        cursor: pointer;
        font-family: var(--fontFamiliesHeading) !important;
        font-size: 1.125rem !important;
        font-weight: 800 !important;
        letter-spacing: 0.08em !important;
        line-height: 1.4 !important;
        padding: 0.75rem 1.25rem !important;
        text-transform: uppercase !important;
        width: 100% !important;
    }

    @media only screen and (max-width: 400px) {
        .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-formContent.horozintalForm {
            padding: 0 0 0.625rem 0 !important;
        }
        .ml-form-formContent.horozintalForm .ml-button-horizontal {
            display: none !important;
        }
        .ml-mobileButton-horizontal {
            display: inline-block !important;
            margin-bottom: var(--sizes125);
            width: 100%;
        }
        .ml-form-formContent.horozintalForm .ml-form-horizontalRow .ml-input-horizontal > div {
            padding-bottom: 0 !important;
        }
        .ml-form-formContent.horozintalForm .ml-form-horizontalRow .horizontal-fields {
            margin-bottom: 0.625rem !important;
            width: 100% !important;
        }
    }

    .ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-embedPermissions {
        text-align: left;
        float: left;
        width: 100%;
    }
    .ml-form-embedContainer
        .ml-form-embedWrapper
        .ml-form-embedBody
        .ml-form-embedPermissions
        .ml-form-embedPermissionsContent {
        margin: 0 0 var(--sizes1) 0;
        text-align: left;
    }
    .ml-form-embedContainer
        .ml-form-embedWrapper
        .ml-form-embedBody
        .ml-form-embedPermissions
        .ml-form-embedPermissionsContent.horizontal {
        margin: 0 0 var(--sizes1) 0;
    }

    /* ============================================================
       SPLIT — the front page's oat newsletter band: the intro in one
       column, the form and its fine print in the other, both flush to
       the plate's measure rather than the embed's own inset. The
       selectors match the embed chains above, which they override.
       ============================================================ */
    .news-split.ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody,
    .news-split.ml-form-embedContainer .ml-form-embedWrapper .ml-form-successBody {
        padding: 0;
    }

    .news-split.ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody {
        align-items: start;
        display: grid;
        gap: var(--sizes1);
        grid-template-columns: minmax(0, 1fr);
    }

    .news-split.ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-embedContent {
        color: var(--colorsOnOatEyebrow);
        margin: 0;
        max-width: 544px;
    }

    .news-split.ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-embedContent :global(h2) {
        color: var(--colorsDeepForest);
        font-family: var(--headlineFontFamily);
        font-size: 2.625rem;
        font-weight: var(--headlineFontWeight);
        letter-spacing: var(--headlineLetterSpacing);
        line-height: 1;
        padding-top: var(--sizes1);
        text-transform: uppercase;
    }

    .news-split.ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-embedContent :global(p) {
        color: var(--colorsOnOatBody);
        font-family: var(--textFontFamily);
        font-size: var(--textFontSize);
        line-height: var(--textLineHeight);
        padding-top: var(--sizes1);
    }

    .news-split.ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody form {
        max-width: 432px;
    }

    .news-split.ml-form-embedContainer
        .ml-form-embedWrapper
        .ml-form-embedBody
        .ml-form-embedPermissionsContent
        :global(p) {
        color: var(--colorsOnOatBody);
        font-family: var(--fineFontFamily);
        font-size: var(--fineFontSize);
        line-height: var(--fineLineHeight);
    }

    @media (min-width: 769px) {
        .news-split.ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody {
            gap: 4rem;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .news-split.ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-embedContent :global(h2) {
            font-size: 3.625rem;
        }

        /* the 432px column is too narrow for the 70/30 row — stack the field
           over a button that keeps its own width, as the prototype does */
        .news-split .ml-form-formContent.horozintalForm .ml-form-horizontalRow .ml-input-horizontal {
            width: 100%;
        }

        .news-split .ml-form-formContent.horozintalForm .ml-form-horizontalRow .horizontal-fields {
            padding-bottom: 0.8rem;
            padding-right: 0;
        }

        .news-split .ml-form-formContent.horozintalForm .ml-form-horizontalRow .ml-button-horizontal {
            width: auto !important;
        }

        .news-split.ml-form-embedContainer .ml-form-embedWrapper .ml-form-embedBody .ml-form-horizontalRow button {
            width: auto;
        }
    }
</style>

<div class:list={['ml-form-embedContainer ml-subscribe-form', subscribeClass, { 'news-split': isSplit }]} id={formId}>
    <div class="ml-form-align-center">
        <div class="ml-form-embedWrapper embedForm">
            <div class="ml-form-embedBody ml-form-embedBodyHorizontal row-form">
                <div class="ml-form-embedContent">
                    {isSplit && <Eyebrow tone="inherit">{content.eyebrow}</Eyebrow>}
                    <H2>{content.heading}</H2>
                    <Paragraph>{content.description}</Paragraph>
                </div>

                <form action={formAction} class="ml-block-form" data-code="" method="post" target="_blank">
                    <div class="ml-form-formContent horozintalForm">
                        <div class="ml-form-horizontalRow">
                            <div class="ml-input-horizontal">
                                <div class="horizontal-fields" style="width: 100%;">
                                    <div class="ml-field-group ml-field-email ml-validate-email ml-validate-required">
                                        <!-- input -->
                                        <label class="sr-only" for="newsletter-email">{content.emailPlaceholder}</label>
                                        <input
                                            autocomplete="email"
                                            class="form-control"
                                            data-inputmask=""
                                            id="newsletter-email"
                                            name="fields[email]"
                                            placeholder={content.emailPlaceholder}
                                            type="email"
                                        />
                                        <!-- /input -->
                                    </div>
                                </div>
                            </div>

                            <div class="ml-button-horizontal primary">
                                <button class="primary" type="submit">{content.submitButton}</button>

                                <button class="loading" disabled="disabled" style="display: none;" type="button">
                                    <div class="ml-form-embedSubmitLoad"></div>
                                    <span class="sr-only">{content.loadingLabel}</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div aria-hidden="true" class="ml-mobileButton-horizontal">
                        <button class="primary" tabindex="-1" type="submit">{content.submitButton}</button>
                        <button class="loading" disabled="disabled" style="display: none;" tabindex="-1" type="button">
                            <div class="ml-form-embedSubmitLoad"></div>
                            <span class="sr-only">{content.loadingLabel}</span>
                        </button>
                    </div>

                    <!-- Privacy policy -->
                    <div class="ml-form-embedPermissions" style="">
                        <div class="ml-form-embedPermissionsContent horizontal privacy-policy">
                            <Paragraph>
                                {content.privacyText}
                                <Link href={privacyHref}>{content.privacyLinkText}</Link>
                                {content.privacyTextAfter}
                            </Paragraph>
                        </div>
                    </div>
                    <!-- /Privacy policy -->

                    <input name="ml-submit" type="hidden" value="1" />

                    <input name="anticsrf" type="hidden" value="true" />
                </form>
            </div>

            <div class="ml-form-successBody row-success" style="display: none">
                <div class="ml-form-successContent">
                    <H2>{content.successHeading}</H2>
                    <Paragraph>{content.successMessage}</Paragraph>
                </div>
            </div>
        </div>
    </div>
</div>

<script
    is:inline
    set:html={`
function ml_webform_success_${formId.replace('mlb2-', '')}() {
    var $ = ml_jQuery || jQuery
    $('.${subscribeClass} .row-success').show()
    $('.${subscribeClass} .row-form').hide()
}
`}
/>

{
    /* The embed script (and the jQuery + inputmask bundles it chains) must not compete with the LCP hero for throttled bandwidth — the form sits below the fold on every page and posts natively before the script arrives, so it loads only when scrolled near. */
}
<script
    is:inline
    set:html={`
(function () {
    var loaded = false
    function load() {
        if (loaded || window.__mlWebformsLoaded) {
            loaded = true
            return
        }
        loaded = true
        window.__mlWebformsLoaded = true
        var s = document.createElement('script')
        s.src = 'https://groot.mailerlite.com/js/w/webforms.min.js?v95037e5bac78f29ed026832ca21a7c7b'
        s.defer = true
        document.head.appendChild(s)
        fetch('${takelUrl}')
    }
    var el = document.getElementById('${formId}')
    if (!el || !('IntersectionObserver' in window)) {
        load()
        return
    }
    var io = new IntersectionObserver(
        function (entries) {
            for (var i = 0; i < entries.length; i++) {
                if (entries[i].isIntersecting) {
                    io.disconnect()
                    load()
                    return
                }
            }
        },
        { rootMargin: '400px 0px' }
    )
    io.observe(el)
})()
`}
/>
