---
import { typographics } from '../lib/styles'

interface Props {
    items: string[]
}

const { items } = Astro.props
---

<style
    define:vars={{
        factsFontFamily: typographics.text.fontFamily,
        factsFontWeight: typographics.pillarAnswer.fontWeight,
    }}
>
    .facts {
        display: grid;
        gap: 0.75rem;
        padding-top: 1.5rem;
    }

    .facts li {
        border-left: 4px solid var(--colorsSand);
        color: var(--colorsTextPrimary);
        font-family: var(--factsFontFamily);
        font-size: 1.0625rem;
        font-weight: var(--factsFontWeight);
        line-height: 1.6;
        padding: 0.25rem 0 0.25rem 0.75rem;
    }

    @media (max-width: 768px) {
        .facts {
            gap: 1rem;
            padding-top: 1.5rem;
        }
    }
</style>

<ul class="facts">
    {items.map((item) => <li>{item}</li>)}
</ul>
