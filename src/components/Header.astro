---
import type { Lang } from '../content/nav'

import { navLinks } from '../content/nav'
import { colors, gridAreas, HEADER_SIZE, zIndices } from '../lib/styles'
import DesktopMenu from './header/DesktopMenu.astro'
import MobileMenu from './header/MobileMenu.astro'
import SkipLinks from './header/SkipLinks.astro'

interface Props {
    /**
     * Only the front page's hero renders its own in-image wordmark — every other
     * `hero`-variant page needs the nav's own brand link shown (and overhanging the
     * hero) instead. Ignored for `variant="solid"`.
     */
    heroShowsMark?: boolean
    lang?: Lang
    /**
     * Signal Band visual rebrand: `hero` is the transparent bar absolutely positioned
     * over a page's hero image (68px, no background of its own — legibility comes
     * from each nav link's own light-sand chip, not a gradient overlay). `solid`
     * is the light-sand bar every other page uses, sized by its own content.
     */
    variant?: 'hero' | 'solid'
}

const { heroShowsMark = false, lang = 'fi', variant = 'solid' } = Astro.props
const links = navLinks[lang]
---

<style
    define:vars={{
        colorsDeepForest: colors.forestGreen,
        colorsLightSand: colors.lightSand,
        gridAreasHeader: gridAreas.header,
        headerSize: HEADER_SIZE,
        zIndices50: zIndices[50],
    }}
>
    header {
        box-sizing: border-box;
        grid-area: var(--gridAreasHeader);
        max-width: 100%;
        user-select: none;
        width: 100vw;
        z-index: var(--zIndices50);
    }

    header.hero {
        background: transparent;
        height: 68px;
        position: absolute;
        inset: 0 0 auto 0;
    }

    /* Deliberately unnamed for view transitions. The bar is in flow, not sticky, so on
       a page scrolled 2 000px its old snapshot sits 2 000px above the viewport, and a
       named group would swoop the header down from there on every navigation. It
       crossfades with the rest of the page instead. */
    header.solid {
        background-color: var(--colorsLightSand);
        position: relative;
    }

    /* desktop: the same 68px bar as the hero — the wordmark overhangs (DesktopMenu) */
    @media (min-width: 1200px) {
        header.solid {
            height: 68px;
        }
    }

    /* tablet (769–1199px): the desktop nav does not fit beside the wordmark, so the
       header keeps the phone bar and menu while the page below is already in its
       desktop layout. At 1000px "Ota yhteyttä" already wrapped; 1200px is the one
       desktop breakpoint the brand names. The hero bar stays out of flow (absolute) —
       the desktop hero reserves no room for a fixed bar. */
    @media (min-width: 769px) and (max-width: 1199px) {
        header.hero {
            background-color: var(--colorsDeepForest);
            height: var(--headerSize);
        }
    }

    @media (max-width: 768px) {
        header.hero {
            background-color: var(--colorsDeepForest);
            height: var(--headerSize);
            position: fixed;
        }
    }

    /* Without the Popover API the phone links render inline (MobileMenu). A fixed,
       60px bar would then pin them over the page, so the bar grows to fit them and
       scrolls away with the page. */
    @supports not selector(:popover-open) {
        header.hero {
            height: auto;
            position: absolute;
        }
    }
</style>
<header class:list={[variant]}>
    <SkipLinks lang={lang} />
    <MobileMenu heroShowsMark={heroShowsMark} lang={lang} links={links} variant={variant} />
    <DesktopMenu heroShowsMark={heroShowsMark} lang={lang} links={links} variant={variant} />
</header>
