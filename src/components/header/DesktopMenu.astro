---
import type { Lang, NavLink } from '../../content/nav'

import MainNavigationLink from './components/MainNavigationLink.astro'
import NavigationLink from './components/NavigationLink.astro'

/** package 20260824 8pm/Site — every page's header shares this edge gutter (--pad-x). */
const DESKTOP_PAD_X = '56px'

interface Props {
    heroShowsMark?: boolean
    lang?: Lang
    links: NavLink[]
    variant?: 'hero' | 'solid'
}

const { heroShowsMark = false, lang, links, variant = 'solid' } = Astro.props
const navLinks = links.filter((link) => !link.switchToLang)
const langLinks = links.filter((link) => link.switchToLang)
/**
 * The overhanging brand sits on the dark hero image and needs to be white; every
 * other case (front-page hidden, or the solid light-sand bar) wants the dark mark.
 */
const tone = variant === 'hero' && !heroShowsMark ? 'light' : 'dark'
---

<style define:vars={{ desktopPadX: DESKTOP_PAD_X }}>
    /* Every page's header spans the full width with this edge gutter, unlike the
       body copy's own narrower centered measure (package 20260824 8pm/Site — shared
       .sheet, --pad-x:56px, no max-width cap on the shell). */
    .container {
        display: none;
        align-items: center;
        flex-direction: row;
        gap: 1.5rem;
        padding-left: var(--desktopPadX);
        padding-right: var(--desktopPadX);
        position: relative;
        width: 100%;
    }

    .brand {
        margin-right: auto;
    }

    /* The front page's hero has its own in-image wordmark, so the nav's copy is
       redundant there. Every other hero-variant page has no in-image mark — the nav's
       brand is its only logo, positioned to overhang the top of the dark hero column
       (package 20260824 8pm/Site/laurista.html: ".top .brand", Figma 2067:47750).
       Solid pages overhang the same way, so the bar keeps the hero's 68px height and
       the nav sits at the same height on every page instead of the in-flow wordmark
       stretching the bar to ~83px. */
    .brand.hidden {
        display: none;
    }

    .brand.overhang {
        left: var(--desktopPadX);
        position: absolute;
        top: 14px;
    }

    /* the overhanging mark is out of flow, so reserve its width (~171px at scale
       2.43, plus the row gap) or a narrow desktop nav slides underneath it */
    .container:has(> .brand.overhang) {
        padding-left: calc(var(--desktopPadX) + 10.75rem + 1.5rem);
    }

    nav {
        display: flex;
        gap: 0.875rem;
        margin-left: auto;
    }

    .langs {
        display: flex;
        gap: 0.15rem;
        margin-left: 2rem;
    }

    /* below 1200px the nav does not fit beside the wordmark on one line (at 1000px
       "Ota yhteyttä" wrapped); MobileMenu takes over */
    @media (min-width: 1200px) {
        .container {
            display: flex;
        }
    }
</style>
<div class="container">
    <div
        class:list={[
            'brand',
            {
                hidden: variant === 'hero' && heroShowsMark,
                overhang: variant === 'solid' || (variant === 'hero' && !heroShowsMark),
            },
        ]}
    >
        <MainNavigationLink lang={lang} scale={2.43} tone={tone} />
    </div>
    <nav aria-label="Päävalikko">
        {
            navLinks.map((link) => (
                <NavigationLink
                    context="desktop"
                    href={link.href}
                    label={link.label}
                    title={link.title}
                    variant={variant}
                />
            ))
        }
    </nav>
    <div class="langs" role="group">
        {
            langLinks.map((link) => (
                <NavigationLink
                    context="desktop"
                    href={link.href}
                    label={link.label}
                    switchToLang={link.switchToLang}
                    title={link.title}
                    variant={variant}
                />
            ))
        }
    </div>
</div>
