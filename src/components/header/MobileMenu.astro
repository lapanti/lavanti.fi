---
import type { Lang, NavLink } from '../../content/nav'

import { menuLabel } from '../../content/nav'
import { colors, CONTENT_PADDING, CONTENT_SIZE, HEADER_SIZE, sizes } from '../../lib/styles'
import MainNavigationLink from './components/MainNavigationLink.astro'
import NavigationLink from './components/NavigationLink.astro'

interface Props {
    lang?: Lang
    links: NavLink[]
    variant?: 'hero' | 'solid'
}

const { lang = 'fi', links, variant = 'solid' } = Astro.props
const navLinks = links.filter((link) => !link.switchToLang)
const langLinks = links.filter((link) => link.switchToLang)
const tone = variant === 'hero' ? 'light' : 'dark'
const label = menuLabel[lang]
---

<style
    define:vars={{
        colorsDarkGreen: colors.darkGreen,
        colorsDeepForest: colors.forestGreen,
        colorsLightSand: colors.lightSand,
        contentPadding: CONTENT_PADDING,
        contentSize: CONTENT_SIZE,
        headerSize: HEADER_SIZE,
        sizes05: sizes[0.5],
        sizes25: sizes[2.5],
    }}
>
    .container {
        align-items: center;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        margin-left: var(--contentPadding);
        margin-right: var(--contentPadding);
        max-width: var(--contentSize);
        min-width: 0;
        /* margins sit outside the box even under border-box, so 100% here would
           overflow by 2x contentPadding — subtract them explicitly */
        width: calc(100% - (var(--contentPadding) * 2));
    }

    .container > div {
        align-items: center;
        display: flex;
        gap: var(--sizes25);
        width: 50%;
        justify-content: flex-start;
    }

    /* hand-tuned: the wordmark's skew makes it read as slightly low even though its
       box is centered — nudge up 1px. */
    .brand :global(.name-logo) {
        margin-top: -0.0625rem;
    }

    .container > div ~ div {
        justify-content: flex-end;
    }

    /* menu button — the printed .btn at header size: flat at rest, inverted while the
       menu is open, a press when held. Light sand on the hero's forest bar. */
    .menu-btn {
        background: transparent;
        border: 2px solid currentcolor;
        color: var(--colorsDeepForest);
        cursor: pointer;
        font-family: var(--buttonFontFamily);
        font-size: 1rem;
        font-weight: var(--buttonFontWeight);
        letter-spacing: var(--buttonLetterSpacing);
        line-height: 1;
        min-height: 2.75rem;
        min-width: 2.75rem;
        padding: 0 0.875rem;
        text-transform: uppercase;
        transition:
            background var(--dur-base) var(--ease),
            color var(--dur-base) var(--ease),
            transform var(--dur-fast) var(--ease);
    }
    .menu-btn.light {
        color: var(--colorsLightSand);
    }
    .menu-btn:has(+ .links:popover-open) {
        background: var(--colorsDeepForest);
        border-color: var(--colorsDeepForest);
        color: var(--colorsLightSand);
    }
    .menu-btn.light:has(+ .links:popover-open) {
        background: var(--colorsLightSand);
        border-color: var(--colorsLightSand);
        color: var(--colorsDeepForest);
    }
    .menu-btn:active {
        transform: translate(var(--press), var(--press));
    }

    /* the panel — a native popover, so the browser owns Escape, tap-outside, focus
       return and hiding the closed links from the tab order and the a11y tree. It
       sits in the top layer under the 60px bar: absolute (scrolls with the page) under
       the in-flow solid header, fixed under the hero's fixed bar. */
    /* layout: a top-aligned, left-aligned list (not the old brand's centred
       full-screen stack, which clipped its first link once the list outgrew the
       panel), language chips pinned low, the signal stripe as the closing edge. */
    .links {
        align-items: flex-start;
        background-color: var(--colorsDeepForest);
        border: 0;
        box-sizing: border-box;
        color: inherit;
        flex-direction: column;
        gap: 0.25rem;
        height: calc(100dvh - var(--headerSize));
        inset: var(--headerSize) 0 auto 0;
        justify-content: flex-start;
        margin: 0;
        overflow: auto;
        overscroll-behavior: contain;
        padding: 1.5rem var(--pad-x) 0;
        position: absolute;
        width: 100%;
    }
    /* the hero bar is deep forest too — a hairline marks where bar ends and panel begins */
    .links.hero {
        border-top: 2px solid var(--colorsDarkGreen);
        position: fixed;
    }
    .links:popover-open {
        display: flex;
    }

    .langs {
        display: flex;
        gap: var(--sizes05);
        margin-block: auto 1.5rem;
        padding-top: 1.5rem;
    }

    /* the panel's closing edge — the five signal bands at menu scale, static */
    .menu-stripe {
        align-self: stretch;
        display: flex;
        flex: none;
        flex-direction: column;
        height: 1.25rem;
        margin-inline: calc(var(--pad-x) * -1);
    }
    .menu-stripe i {
        flex: 1;
    }
    .menu-stripe i:nth-child(1) {
        background: var(--colorsDarkGreen);
    }
    .menu-stripe i:nth-child(2) {
        background: var(--colorsBrightGreen);
    }
    .menu-stripe i:nth-child(3) {
        background: var(--colorsAquaBlue);
    }
    .menu-stripe i:nth-child(4) {
        background: var(--colorsBrightSky);
    }
    .menu-stripe i:nth-child(5) {
        background: var(--colorsSignalBlue);
    }

    /* The page behind the open panel does not scroll. */
    :global(html:has(#mobile-nav:popover-open)) {
        overflow: hidden;
    }

    /* Motion: the panel unrolls downward over --dur-menu and rolls back up over the
       shorter --dur-base; links settle in behind it, 40ms apart. clip-path keeps it off
       the layout path. Opening is a keyframe animation rather than a transition from
       @starting-style — Siteimprove Alfa (e2e a11y gate) cannot parse @starting-style
       and drops the rest of the stylesheet. Closing transitions display/overlay
       discretely so it plays out before the panel leaves the top layer. Reduced motion
       zeroes every duration and the stagger, leaving an instant show/hide. */
    .links {
        clip-path: inset(0 0 100% 0);
        transition:
            clip-path var(--dur-base) var(--ease),
            display var(--dur-base) allow-discrete,
            overlay var(--dur-base) allow-discrete;
    }
    .links:popover-open {
        animation: menu-unroll var(--dur-menu) var(--ease);
        clip-path: inset(0);
    }
    .links:popover-open > :global(*:not(.menu-stripe)) {
        animation: menu-settle var(--dur-base) var(--ease) calc(var(--i, 0) * var(--dur-fast) / 3) backwards;
    }
    @keyframes menu-unroll {
        from {
            clip-path: inset(0 0 100% 0);
        }
    }
    @keyframes menu-settle {
        from {
            opacity: 0;
            transform: translateY(-0.25rem);
        }
    }
    .links > :global(:nth-child(2)) {
        --i: 1;
    }
    .links > :global(:nth-child(3)) {
        --i: 2;
    }
    .links > :global(:nth-child(4)) {
        --i: 3;
    }
    /* capped at 4 so the last link lands within ~340ms */
    .links > :global(:nth-child(n + 5)) {
        --i: 4;
    }

    /* Without the Popover API the button would do nothing — drop it and show the
       links inline under the bar instead, so navigation is never unreachable. */
    @supports not selector(:popover-open) {
        .container {
            flex-wrap: wrap;
        }
        .menu-btn {
            display: none;
        }
        .links {
            clip-path: none;
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            height: auto;
            position: static;
        }
    }

    @media (min-width: 769px) {
        .container,
        .links {
            display: none;
        }
        /* own rule: a browser without :popover-open drops the whole selector list,
           which would put the mobile bar back on desktop */
        .links:popover-open {
            display: none;
        }
    }
</style>
<div class="container">
    <div class="brand">
        <MainNavigationLink lang={lang} tone={tone} />
    </div>
    <div>
        <button class:list={['menu-btn', { light: tone === 'light' }]} popovertarget="mobile-nav" type="button">
            {label}
        </button>
        <nav aria-label={label} class:list={['links', 'on-dark', { hero: variant === 'hero' }]} id="mobile-nav" popover>
            {
                navLinks.map((link) => (
                    <NavigationLink context="mobile" href={link.href} label={link.label} title={link.title} />
                ))
            }
            <div class="langs" role="group">
                {
                    langLinks.map((link) => (
                        <NavigationLink
                            context="mobile"
                            href={link.href}
                            label={link.label}
                            switchToLang={link.switchToLang}
                            title={link.title}
                        />
                    ))
                }
            </div>
            <div aria-hidden="true" class="menu-stripe"><i></i><i></i><i></i><i></i><i></i></div>
        </nav>
    </div>
</div>
