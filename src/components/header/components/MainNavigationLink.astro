---
import type { Lang } from '../../../content/nav'

import { colors, HEADER_SIZE, sizes } from '../../../lib/styles'
import NameLogo from '../../NameLogo.astro'

interface Props {
    lang?: Lang
    scale?: number
    tone?: 'dark' | 'light'
}

const { lang = 'fi', scale = 1, tone = 'light' } = Astro.props
const { pathname } = Astro.url
const href = `/${lang}/`
const underlineColor = tone === 'light' ? colors.white : colors.forestGreen
---

<style
    define:vars={{
        headerSize: HEADER_SIZE,
        sizes01875: sizes[0.1875],
        sizes5: sizes[5],
        underlineColor,
    }}
>
    a {
        align-items: center;
        display: flex;
        min-height: var(--sizes5);
        position: relative;
    }

    /* the phone/tablet header bar is 60px (see HEADER_SIZE) — cap the tap target to
       match, otherwise the logo's own min-height grows the header past that. */
    @media (max-width: 999px) {
        a {
            min-height: var(--headerSize);
        }
    }

    a:focus-visible {
        outline: var(--sizes01875) solid var(--underlineColor);
        outline-offset: 2px;
    }
</style>
<a aria-current={pathname === href ? 'page' : 'false'} href={href}>
    <NameLogo scale={scale} size="small" tone={tone} />
</a>
