---
import type { CvRow } from '../../types/local'

import { typographics } from '../../lib/styles'
import Plate from '../Plate.astro'
import Row from './section/Row.astro'

interface Props {
    ground?: 'gray' | 'offWhite'
    items: CvRow[]
    title: string
}

const { ground = 'gray', title, items } = Astro.props
---

<style
    define:vars={{
        displayFontFamily: typographics.display.fontFamily,
        displayFontWeight: typographics.display.fontWeight,
    }}
>
    h2 {
        color: var(--colorsDeepForest);
        font-family: var(--displayFontFamily);
        font-size: 3rem;
        font-weight: var(--displayFontWeight);
        letter-spacing: -0.015em;
        line-height: 1;
        margin: 0;
        text-transform: uppercase;
    }

    ul {
        padding-top: 2rem;
    }

    @media (min-width: 769px) {
        h2 {
            font-size: 3.625rem;
        }
    }
</style>

<Plate ground={ground}>
    <h2>{title}</h2>
    <ul>
        {items?.filter((f) => f !== undefined).map((row) => <Row {...row} />)}
    </ul>
</Plate>
