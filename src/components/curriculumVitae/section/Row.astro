---
import { colors, typographics } from '../../../lib/styles'
import Description from './row/Description.astro'
import Label from './row/Label.astro'
import Meta from './row/Meta.astro'

interface Props {
    company?: string
    degree?: string
    description?: string[]
    duty?: string
    endYear?: number
    location?: string
    organization?: string
    school?: string
    startYear: number
    title?: string
}

const { company, degree, description, duty, endYear, location, organization, school, startYear, title } = Astro.props
---

<style
    define:vars={{
        colorsGreen: colors.brightGreen,
        cvOrgFontFamily: typographics.chip.fontFamily,
        cvOrgFontWeight: typographics.chip.fontWeight,
        cvRoleFontFamily: typographics.title.fontFamily,
        cvRoleFontWeight: typographics.title.fontWeight,
    }}
>
    li {
        border-top: 3px solid var(--colorsDarkGreen);
        display: grid;
        gap: 1rem;
        grid-template-columns: 1fr;
        padding-block: 1.75rem;
    }

    li:last-child {
        border-bottom: 3px solid var(--colorsDarkGreen);
    }

    :global(.cv-role) {
        color: var(--colorsDarkGreen);
        font-family: var(--cvRoleFontFamily);
        font-size: 1.1875rem;
        font-weight: var(--cvRoleFontWeight);
        line-height: 1.32;
        margin: 0;
    }

    :global(.cv-org) {
        color: var(--colorsTextSecondary);
        display: block;
        font-family: var(--cvOrgFontFamily);
        font-size: 0.9375rem;
        font-weight: var(--cvOrgFontWeight);
        letter-spacing: 0.14em;
        line-height: 1.4;
        padding-top: 0.5rem;
        text-transform: uppercase;
    }

    :global(.cv-notes) {
        display: grid;
        gap: 0.625rem;
    }

    :global(.cv-notes li) {
        border-top: 0;
        color: var(--colorsTextSecondary);
        display: grid;
        font-size: 0.9375rem;
        gap: 0.875rem;
        grid-template-columns: 8px minmax(0, 1fr);
        line-height: 1.68;
        padding: 0;
    }

    :global(.cv-notes li)::before {
        background: var(--colorsGreen);
        content: '';
        display: block;
        height: 8px;
        margin-top: 0.5625rem;
        width: 8px;
    }

    @media (min-width: 769px) {
        li {
            gap: 1rem 3.5rem;
            grid-template-columns: minmax(0, 4fr) minmax(0, 6fr);
        }
    }
</style>
<li>
    <div>
        <Label degree={degree} duty={duty} title={title} />
        <Meta
            company={company}
            endYear={endYear}
            location={location}
            organization={organization}
            school={school}
            startYear={startYear}
        />
    </div>
    {description && <Description items={description} />}
</li>
