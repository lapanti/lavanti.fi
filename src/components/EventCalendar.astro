---
import type { CampaignEvent } from '../content/events'
import type { Lang } from '../content/nav'

import { eventDateTimeAttribute, formatEventDate, formatEventTime } from '../lib/eventDate'
import { colors, typographics } from '../lib/styles'
import Eyebrow from './Eyebrow.astro'
import PlateHeading from './PlateHeading.astro'

interface Props {
    events: CampaignEvent[]
    eyebrow: string
    heading: string
    id?: string
    lang: Lang
}

const { events, eyebrow, heading, id, lang } = Astro.props

/** Shown in place of a programme while the subject of an event is still open. */
const topicPendingLabels: Record<Lang, string> = {
    en: 'The topic will be confirmed later.',
    fi: 'Aihe vahvistetaan myöhemmin.',
    sv: 'Ämnet bekräftas senare.',
}
---

<style
    define:vars={{
        ground: colors.lightSand,
        metaFontFamily: typographics.meta.fontFamily,
        metaFontSize: typographics.meta.fontSize,
        metaFontWeight: typographics.meta.fontWeight,
        metaLetterSpacing: typographics.meta.letterSpacing,
        metaLineHeight: typographics.meta.lineHeight,
        textSmallFontSize: typographics.textSmall.fontSize,
        titleFontFamily: typographics.title.fontFamily,
        titleFontSize: typographics.title.fontSize,
        titleFontWeight: typographics.title.fontWeight,
    }}
>
    .events {
        background: var(--ground);
    }

    .event-list {
        column-gap: 3.5rem;
        display: grid;
        grid-template-columns: 1fr;
        list-style: none;
        margin: 0;
        padding: 2rem 0 0;
    }

    .event-list > li {
        border-top: 3px solid var(--colorsForestGreen);
        padding-block: 1.9rem;
    }

    .event-when {
        color: var(--colorsDarkGreen);
        display: block;
        font-family: var(--metaFontFamily);
        font-size: var(--metaFontSize);
        font-weight: var(--metaFontWeight);
        letter-spacing: var(--metaLetterSpacing);
        line-height: var(--metaLineHeight);
        text-transform: uppercase;
    }

    .event-list h3 {
        color: var(--colorsForestGreen);
        font-family: var(--titleFontFamily);
        font-size: var(--titleFontSize);
        font-weight: var(--titleFontWeight);
        line-height: 1.3;
        margin: 0;
        padding-top: 0.5rem;
    }

    .event-place {
        color: var(--colorsTextSecondary);
        font-family: var(--textSmallFontFamily);
        font-size: var(--textSmallFontSize);
        font-weight: var(--textSmallFontWeight);
        line-height: var(--textSmallLineHeight);
        margin: 0;
        padding-top: 0.35rem;
    }

    .event-description {
        color: var(--colorsTextPrimary);
        font-family: var(--textFontFamily);
        font-size: var(--textFontSize);
        font-weight: var(--textFontWeight);
        line-height: var(--textLineHeight);
        margin: 0;
        padding-top: 0.65rem;
    }

    /* A div, not a p: SiteImprove sia-r85 (paragraph-not-italics) fails an italic
       paragraph, and the repo already moves such labels off the paragraph role. */
    .event-pending {
        color: var(--colorsTextSecondary);
        font-family: var(--fineFontFamily);
        font-size: var(--fineFontSize);
        font-style: italic;
        font-weight: var(--fineFontWeight);
        line-height: var(--fineLineHeight);
        margin: 0;
        padding-top: 0.5rem;
    }

    @media (min-width: 769px) {
        .event-list {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>
{
    events.length > 0 && (
        <section class="events section" id={id}>
            <div class="sheet">
                <div class="inner">
                    <Eyebrow color={colors.darkGreen}>{eyebrow}</Eyebrow>
                    <PlateHeading color={colors.forestGreen} sizes={['42px', '58px']}>
                        {heading}
                    </PlateHeading>
                    <ol class="event-list">
                        {events.map((event) => {
                            const time = formatEventTime(event, lang)

                            return (
                                <li data-event-id={event.id}>
                                    <time class="event-when" datetime={eventDateTimeAttribute(event)}>
                                        {formatEventDate(event.date, lang)}
                                        {time && ` ${time}`}
                                    </time>
                                    <h3>{event.locales[lang].title}</h3>
                                    <p class="event-place">
                                        {event.locales[lang].venue}, {event.locales[lang].locality}
                                    </p>
                                    <p class="event-description">{event.locales[lang].description}</p>
                                    {!event.topicConfirmed && (
                                        <div class="event-pending">{topicPendingLabels[lang]}</div>
                                    )}
                                </li>
                            )
                        })}
                    </ol>
                </div>
            </div>
        </section>
    )
}
