---
import type { CampaignEvent } from '../content/events'
import type { Lang } from '../content/nav'
import type { AuthorEntry } from '../content/person'

import {
    getPersonImageUrl,
    PERSON_ID,
    personAffiliation,
    personAlumniOf,
    personBirthDate,
    personBirthPlace,
    personDescription,
    personEmail,
    personFamilyName,
    personGivenName,
    personHasOccupation,
    personJobTitle,
    personKnowsAbout,
    personKnowsLanguage,
    personMemberOf,
    personName,
    personNationality,
    personSameAs,
    personTelephone,
    personUrl,
    personWorksFor,
} from '../content/person'
import { rssTitles } from '../content/rss'
import { toHelsinkiIso } from '../lib/eventDate'
import { hasFaqSection } from '../lib/faq'
import {
    BLOGPOSTING,
    type BreadcrumbItem,
    type CollectionInfo,
    COLLECTIONPAGE,
    EVENT,
    type FaqItem,
    FAQPAGE,
    JSON_LD_TYPES,
    type JsonLdType,
    PERSON,
    PROFILEPAGE,
    WEBPAGE,
    WEBSITE,
} from '../lib/jsonld'
import { stripSoftHyphens } from '../lib/text'

interface Props {
    authors?: AuthorEntry[]
    breadcrumbs?: BreadcrumbItem[]
    /** With type CollectionPage: the topic and the listed items, as `about` and an ItemList `mainEntity`. */
    collection?: CollectionInfo
    createdAt?: string
    description?: string
    /** Campaign events for the sibling Event JSON-LD; the section itself renders from the page body. */
    events?: CampaignEvent[]
    faq?: Array<FaqItem>
    /**
     * With `noindex`: let crawlers follow the page's links. For pages that are not
     * content themselves but point at content, like the root language dispatcher.
     */
    follow?: boolean
    lang?: Lang
    langAlternates?: Record<Lang, string>
    noindex?: boolean
    ogImage?: string
    ogImageAlt?: string
    slug?: string
    tags?: string[]
    title: string
    type?: JsonLdType
    updatedAt?: string
    wordCount?: number
}

const {
    authors,
    breadcrumbs,
    collection,
    description = 'Vihreiden eduskuntavaaliehdokas Uudenmaan vaalipiirissä, johtava ohjelmistokehittäjä. Tavoitteena digitaalisesti itsenäinen Suomi tekoälyn aikakaudella.',
    events,
    faq,
    follow = false,
    lang: rawLang = 'fi',
    langAlternates,
    noindex,
    tags,
    title: rawTitle,
    type,
    slug,
    ogImage,
    ogImageAlt,
    createdAt,
    updatedAt,
    wordCount,
} = Astro.props

const lang: Lang = rawLang
/*
 * Soft hyphens are a line-break hint for headings on the page. In <title>, og:title and
 * JSON-LD they are invisible bytes that break exact-match search and leak into shares.
 */
const title = stripSoftHyphens(rawTitle)

/*
 * JSON-LD is injected raw with set:html. Escaping `<` keeps a stray `</script>` in a
 * title, FAQ answer or description from closing the tag early; JSON parsers read
 * < back as `<`, so the structured data is unchanged.
 */
const scriptSafe = (json: string): string => json.replace(/</g, '\\u003c')

const ogLocale: Record<Lang, string> = {
    en: 'en_GB',
    fi: 'fi_FI',
    sv: 'sv_SE',
}

const isArticle = type === BLOGPOSTING

/*
 * Derive hreflang URLs. When langAlternates is provided (blog posts), use the
 * pre-computed per-locale URLs directly. Otherwise fall back to swapping the
 * locale prefix in the canonical slug (works for all other page types).
 */
const siteUrl = Astro.site?.toString()

const hreflangLinks =
    !noindex && siteUrl
        ? (['fi', 'sv', 'en'] as Lang[]).map((l) => ({
              href: langAlternates?.[l]
                  ? new URL(langAlternates[l], siteUrl).toString()
                  : new URL(slug ? slug.replace(/^(fi|sv|en)/, l) + '/' : `${l}/`, siteUrl).toString(),
              hreflang: l,
          }))
        : []

const xDefaultHref = hreflangLinks.find((l) => l.hreflang === 'fi')?.href ?? null

const ogLocaleAlternates = !noindex
    ? (['fi', 'sv', 'en'] as Lang[]).filter((l) => l !== lang).map((l) => ogLocale[l])
    : []

const canonical = !noindex && (slug === 'index' ? Astro.site : slug ? new URL(`${slug}/`, siteUrl) : null)

const ogImageUrl = ogImage ?? null

const resolvedAuthors = (authors ?? (['lauri'] as AuthorEntry[])).map((entry: AuthorEntry) => {
    if (entry === 'lauri') {
        /*
         * The canonical Person node with its full field set lives on the profile page;
         * elsewhere this is a reference to it. Carrying name/url/jobTitle inline as well
         * keeps the identity the same while letting an engine that parses one article in
         * isolation — as AI answer engines do — see who wrote it.
         */
        return {
            '@id': PERSON_ID,
            '@type': 'Person' as const,
            jobTitle: personJobTitle[lang],
            name: personName,
            url: personUrl,
        }
    }
    return {
        '@type': 'Person' as const,
        name: entry.name,
        ...(entry.url ? { url: entry.url } : {}),
        ...(entry.sameAs ? { sameAs: entry.sameAs } : {}),
    }
})

const articleAuthorNames = (authors ?? (['lauri'] as AuthorEntry[])).map((entry: AuthorEntry) =>
    entry === 'lauri' ? personName : entry.name
)

const canonicalPersonObject = {
    '@id': PERSON_ID,
    '@type': 'Person',
    affiliation: personAffiliation,
    alumniOf: personAlumniOf,
    birthDate: personBirthDate,
    birthPlace: personBirthPlace,
    description: personDescription[lang],
    email: personEmail,
    familyName: personFamilyName,
    givenName: personGivenName,
    hasOccupation: personHasOccupation[lang],
    image: await getPersonImageUrl(),
    jobTitle: personJobTitle[lang],
    knowsAbout: personKnowsAbout[lang],
    knowsLanguage: personKnowsLanguage,
    memberOf: personMemberOf,
    name: personName,
    nationality: personNationality,
    sameAs: personSameAs,
    telephone: personTelephone,
    url: personUrl,
    worksFor: personWorksFor,
}

const jsonLd = JSON.stringify(
    type === PROFILEPAGE
        ? {
              '@context': 'https://schema.org',
              '@type': PROFILEPAGE,
              ...(updatedAt ? { dateModified: updatedAt } : {}),
              description,
              mainEntity: canonicalPersonObject,
              name: title,
              url: canonical,
          }
        : type === PERSON
          ? /* A Person is not a CreativeWork: author, headline and license are invalid on it. */
            { '@context': 'https://schema.org', ...canonicalPersonObject }
          : {
                '@context': 'https://schema.org',
                '@type': type && JSON_LD_TYPES.includes(type) ? type : WEBSITE,
                author: isArticle ? resolvedAuthors : { '@type': 'Person', name: personName },
                ...(updatedAt && type !== BLOGPOSTING ? { dateModified: updatedAt } : {}),
                description,
                headline: title,
                license: 'https://creativecommons.org/licenses/by-sa/4.0/',
                url: canonical,
                ...(ogImageUrl ? { image: ogImageUrl } : {}),
                ...(type === BLOGPOSTING
                    ? {
                          ...(ogImageUrl
                              ? {
                                    image: { '@type': 'ImageObject', height: 630, url: ogImageUrl, width: 1200 },
                                    primaryImageOfPage: {
                                        '@type': 'ImageObject',
                                        height: 630,
                                        url: ogImageUrl,
                                        width: 1200,
                                    },
                                }
                              : {}),
                          dateModified: updatedAt ?? createdAt,
                          datePublished: createdAt,
                          inLanguage: lang,
                          mainEntityOfPage: {
                              '@id': canonical,
                              '@type': WEBPAGE,
                              inLanguage: lang,
                          },
                          /* A personal blog: the author publishes it. Google accepts a Person here. */
                          publisher: { '@id': PERSON_ID, '@type': 'Person', name: personName, url: personUrl },
                          ...(wordCount ? { wordCount } : {}),
                      }
                    : {}),
                ...(type === COLLECTIONPAGE
                    ? {
                          inLanguage: lang,
                          ...(collection
                              ? {
                                    about: {
                                        '@type': 'DefinedTerm',
                                        inDefinedTermSet: collection.about.termSet,
                                        name: stripSoftHyphens(collection.about.name),
                                    },
                                    mainEntity: {
                                        '@type': 'ItemList',
                                        itemListElement: collection.items.map((item, i) => ({
                                            '@type': 'ListItem',
                                            name: stripSoftHyphens(item.name),
                                            position: i + 1,
                                            url: item.url,
                                        })),
                                        numberOfItems: collection.items.length,
                                    },
                                }
                              : {}),
                      }
                    : {}),
                ...(type === WEBSITE
                    ? {
                          name: personName,
                          sameAs: personSameAs,
                      }
                    : {}),
            }
)

const faqJsonLd = hasFaqSection(faq)
    ? JSON.stringify({
          '@context': 'https://schema.org',
          '@type': FAQPAGE,
          mainEntity: faq.map(({ q, a }) => ({
              '@type': 'Question',
              acceptedAnswer: {
                  '@type': 'Answer',
                  text: a,
              },
              name: q,
          })),
      })
    : null

/*
 * Event nodes ride along as a sibling script, exactly as faqJsonLd does — the page's
 * primary @type stays WebPage. Events whose topic is still open are left out: an
 * Event node needs a name that says what actually happens, and structured data
 * should not announce a programme that does not exist yet. There is no minimum
 * count here; the >= 2 gate on faq is a FAQPage rich-result requirement, not a
 * pattern to copy. One script per event rather than a single array: every other
 * block on the page is a standalone object, and scripts/checks/dist-head.ts reads
 * @context and @type off each block.
 *
 * organizer is written out rather than referenced by @id: on a WebPage the canonical
 * Person node is not in the emitted graph, so a bare @id would dangle.
 */
const announceableEvents = (events ?? []).filter((event) => event.topicConfirmed)

const eventsJsonLd = announceableEvents.map((event) =>
    JSON.stringify({
        '@context': 'https://schema.org',
        '@type': EVENT,
        description: event.locales[lang].description,
        ...(event.endTime ? { endDate: toHelsinkiIso(event.date, event.endTime) } : {}),
        eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
        eventStatus: 'https://schema.org/EventScheduled',
        isAccessibleForFree: true,
        location: {
            '@type': 'Place',
            address: {
                '@type': 'PostalAddress',
                addressCountry: 'FI',
                addressLocality: event.locales[lang].locality,
                postalCode: event.postalCode,
                streetAddress: event.streetAddress,
            },
            name: event.locales[lang].venue,
        },
        name: event.locales[lang].title,
        organizer: { '@type': 'Person', name: personName, url: personUrl },
        ...(event.fbUrl ? { sameAs: event.fbUrl } : {}),
        startDate: toHelsinkiIso(event.date, event.startTime),
        ...(canonical ? { url: canonical.toString() } : {}),
    })
)

const breadcrumbJsonLd =
    breadcrumbs && breadcrumbs.length >= 2
        ? JSON.stringify({
              '@context': 'https://schema.org',
              '@type': 'BreadcrumbList',
              itemListElement: breadcrumbs.map(({ name, url }: BreadcrumbItem, i: number) => ({
                  '@type': 'ListItem',
                  item: url,
                  name,
                  position: i + 1,
              })),
          })
        : null
---

<meta charset="utf-8" />
{noindex && <meta content={follow ? 'noindex, follow' : 'noindex, nofollow'} name="robots" />}
<meta content="width=device-width, initial-scale=1, shrink-to-fit=no" name="viewport" />
<meta content={title} property="og:title" />
<meta content={personName} name="author" />
<meta content={ogLocale[lang]} property="og:locale" />
{ogLocaleAlternates.map((loc) => <meta content={loc} property="og:locale:alternate" />)}
<meta content={description} name="description" />
<meta content={description} property="og:description" />
<meta content={personName} property="og:site_name" />
<meta content={title} name="twitter:title" />
<meta content={isArticle ? 'article' : 'website'} property="og:type" />
<meta content={description} name="twitter:description" />
{isArticle && articleAuthorNames.map((n: string) => <meta content={n} property="article:author" />)}
{isArticle && <meta content={createdAt} property="article:published_time" />}
{isArticle && updatedAt && <meta content={updatedAt} property="article:modified_time" />}
{isArticle && tags && tags.length > 0 && <meta content={tags[0]} property="article:section" />}
{isArticle && tags && tags.map((tag: string) => <meta content={tag} property="article:tag" />)}
<meta content="@laurilavanti@mastodon.social" name="fediverse:creator" />
{
    canonical && (
        <>
            <meta content={canonical} property="og:url" />
            <link href={canonical} rel="canonical" />
        </>
    )
}
{hreflangLinks.map(({ hreflang, href }) => <link href={href} hreflang={hreflang} rel="alternate" />)}
{xDefaultHref && <link href={xDefaultHref} hreflang="x-default" rel="alternate" />}
{
    ogImageUrl ? (
        <>
            <meta content={ogImageUrl} property="og:image" />
            {ogImageAlt && <meta content={ogImageAlt} property="og:image:alt" />}
            <meta content="630" property="og:image:height" />
            <meta content="1200" property="og:image:width" />
            <meta content="summary_large_image" name="twitter:card" />
        </>
    ) : (
        <meta content="summary" name="twitter:card" />
    )
}
<meta content="#163E35" name="theme-color" />
<meta content="Lauri Lavanti" name="apple-mobile-web-app-title" />
<link href="/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180" />
<link href="/favicon-96x96.png" rel="icon" sizes="96x96" type="image/png" />
<link href="/favicon.svg" rel="icon" type="image/svg+xml" />
<link href="/favicon.ico" rel="shortcut icon" />
<link href="/app.webmanifest" rel="manifest" />
<link href="https://scripts.simpleanalyticscdn.com" rel="preconnect" />
{
    /* Hero images always load from the canonical host; on preview deploys (*.pages.dev) that is a cross-origin hop the LCP image otherwise pays connection setup for. Same-origin in production, where browsers ignore the hint. */
}
<link href="https://lavanti.fi" rel="preconnect" />
<link
    as="font"
    crossorigin=""
    href="/fonts/ibm-plex-sans-v23-latin_latin-ext-regular.woff2"
    rel="preload"
    type="font/woff2"
/>
<link as="font" crossorigin="" href="/fonts/big-shoulders-display-v24-latin.woff2" rel="preload" type="font/woff2" />
<title>{title.startsWith('Lauri Lavanti') ? title : `${title} | Lauri Lavanti`}</title>
<script is:inline set:html={scriptSafe(jsonLd)} type="application/ld+json" />
{faqJsonLd && <script is:inline set:html={scriptSafe(faqJsonLd)} type="application/ld+json" />}
{eventsJsonLd.map((event) => <script is:inline set:html={scriptSafe(event)} type="application/ld+json" />)}
{breadcrumbJsonLd && <script is:inline set:html={scriptSafe(breadcrumbJsonLd)} type="application/ld+json" />}

<link href="/sitemap-index.xml" rel="sitemap" />
<link href={`/${lang}/rss.xml`} rel="alternate" title={rssTitles[lang]} type="application/rss+xml" />
<link href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license" />
