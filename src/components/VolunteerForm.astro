---
import type { Lang } from '../content/nav'

import { TURNSTILE_SITE_KEY, volunteerContent } from '../content/volunteer'
import { utmFormScript } from '../lib/utmFormScript'
import { HELP_OPTIONS, MUNICIPALITIES } from '../lib/volunteers'
import Link from './Link.astro'

interface Props {
    lang: Lang
}

const { lang } = Astro.props
const t = volunteerContent[lang]

/*
 * Error feedback without losing what was typed.
 * - Ready state: until name, email and consent are valid the button looks inactive
 *   (aria-disabled, not disabled, so a click still runs the browser's own required-field
 *   prompts) and the hint under it says what is missing.
 * - Submit: keeps the typed values in sessionStorage. Consent is never kept; it is ticked again.
 * - Load with ?virhe=<code>: restores the values, shows the message from the fixed list in the
 *   content file (nothing from the URL is written into the page), marks the field it names and
 *   moves focus there. Any other load drops the stored values.
 * Storage may throw (private mode, blocked site data); the form then works without restore.
 */
const errorScript = `(function () {
    var KEY = 'volunteer-form'
    var FIELDS = ['name', 'email', 'phone', 'municipality']
    var messages = ${JSON.stringify(t.errors)}
    var form = document.getElementById('lomake')
    var box = document.getElementById('volunteer-error')
    var store = function (fn) { try { return fn(window.sessionStorage) } catch (e) { return null } }
    var helpBoxes = function () { return form.querySelectorAll('input[name="help"]') }
    var target = function (code) {
        if (code === 'help') return helpBoxes()[0]
        if (code === 'consent') return form.querySelector('input[name="consent"]')
        return FIELDS.indexOf(code) >= 0 ? form.elements.namedItem(code) : null
    }
    var show = function (code) {
        box.textContent = messages[code]
        box.hidden = false
        var field = target(code)
        if (field) {
            field.setAttribute('aria-invalid', 'true')
            field.setAttribute('aria-describedby', 'volunteer-error')
        }
        box.scrollIntoView({ block: 'center' })
        ;(field || box).focus({ preventScroll: true })
    }
    // After the redirect the browser jumps to #lomake once the page has loaded, which would
    // undo the scroll and focus above; run them after that jump.
    var showAfterLoad = function (code) {
        var run = function () { window.requestAnimationFrame(function () { show(code) }) }
        if (document.readyState === 'complete') run()
        else window.addEventListener('load', run)
    }

    var button = form.querySelector('button[type="submit"]')
    var hint = document.getElementById('volunteer-submit-hint')
    var updateReady = function () {
        var name = form.elements.namedItem('name')
        var email = form.elements.namedItem('email')
        var ready = name.value.trim().length >= 2 && email.value !== '' && email.validity.valid &&
            form.querySelector('input[name="consent"]').checked
        button.setAttribute('aria-disabled', ready ? 'false' : 'true')
        hint.hidden = ready
    }
    form.addEventListener('input', updateReady)

    form.addEventListener('change', function (event) {
        var name = event.target.name
        form.querySelectorAll('[aria-invalid="true"]').forEach(function (el) {
            if (el.name === name) el.removeAttribute('aria-invalid')
        })
        updateReady()
    })

    // A Turnstile token verifies once, so a second post fails as 'varmistus' after the first was
    // stored. Ignore repeat submits until the page is shown again, or after 30 s in case the
    // visitor stopped the load and is left on this page.
    var sent = false
    form.addEventListener('submit', function (event) {
        if (sent) { event.preventDefault(); return }
        sent = true
        button.setAttribute('aria-disabled', 'true')
        window.setTimeout(function () { sent = false; updateReady() }, 30000)
        var data = { help: [] }
        FIELDS.forEach(function (f) { data[f] = form.elements.namedItem(f).value })
        helpBoxes().forEach(function (c) { if (c.checked) data.help.push(c.value) })
        store(function (s) { s.setItem(KEY, JSON.stringify(data)) })
    })

    var code = new URLSearchParams(window.location.search).get('virhe')
    var saved = store(function (s) { var v = s.getItem(KEY); s.removeItem(KEY); return v })
    // Browsers may refill fields from their own form cache, so check after load too.
    updateReady()
    window.addEventListener('pageshow', function () { sent = false; updateReady() })
    if (!code || !Object.prototype.hasOwnProperty.call(messages, code)) return
    if (saved) {
        try {
            var data = JSON.parse(saved)
            FIELDS.forEach(function (f) { if (typeof data[f] === 'string') form.elements.namedItem(f).value = data[f] })
            helpBoxes().forEach(function (c) { c.checked = (data.help || []).indexOf(c.value) >= 0 })
        } catch (e) {}
    }
    updateReady()
    showAfterLoad(code)
})()`
---

<!-- Styled by .site-form in GlobalStyle.astro, shared with RecommendationForm.astro. -->
<form action="/api/liity" class="site-form" id="lomake" method="post">
    <p class="form-error" hidden id="volunteer-error" role="alert" tabindex="-1"></p>

    <p class="required-note">{t.requiredNote}</p>

    <input name="lang" type="hidden" value={lang} />
    <input name="utm_source" type="hidden" value="" />
    <input name="utm_campaign" type="hidden" value="" />

    <div>
        <label for="volunteer-name">{t.name}<span aria-hidden="true" class="req"> *</span></label>
        <input autocomplete="name" id="volunteer-name" maxlength="100" minlength="2" name="name" required type="text" />
    </div>

    <div>
        <label for="volunteer-email">{t.email}<span aria-hidden="true" class="req"> *</span></label>
        <input autocomplete="email" id="volunteer-email" name="email" required type="email" />
    </div>

    <div>
        <label for="volunteer-phone">{t.phone}</label>
        <input autocomplete="tel" id="volunteer-phone" name="phone" type="tel" />
    </div>

    <div>
        <label for="volunteer-municipality">{t.municipality}</label>
        <select id="volunteer-municipality" name="municipality">
            <option value=""></option>
            {MUNICIPALITIES.map((m) => <option value={m}>{t.municipalityOptions[m]}</option>)}
        </select>
    </div>

    <fieldset>
        <legend>{t.helpLegend}</legend>
        {
            HELP_OPTIONS.map((h) => (
                <label class="choice">
                    <input name="help" type="checkbox" value={h} />
                    <span>{t.help[h]}</span>
                </label>
            ))
        }
    </fieldset>

    <div aria-hidden="true" class="honeypot">
        <label for="volunteer-website">Website</label>
        <input autocomplete="off" id="volunteer-website" name="website" tabindex="-1" type="text" />
    </div>

    <label class="choice consent">
        <input name="consent" required type="checkbox" value="yes" />
        <span>
            {t.consent.before}
            <Link href={t.privacyHref}>{t.consent.linkText}</Link>
            {t.consent.after}
            <span aria-hidden="true" class="req"> *</span>
        </span>
    </label>

    <div class="cf-turnstile" data-language={lang} data-sitekey={TURNSTILE_SITE_KEY}></div>

    <div class="submit-row">
        <button aria-describedby="volunteer-submit-hint" type="submit">{t.submit}</button>
        <p aria-live="polite" class="submit-hint" id="volunteer-submit-hint">{t.submitHint}</p>
    </div>
</form>

<script async defer is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
<script is:inline set:html={errorScript} />
<script is:inline set:html={utmFormScript} />
