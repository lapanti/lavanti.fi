---
import type { Lang } from '../content/nav'

interface Props {
    /** Override the destination (defaults to the blog listing of `lang`). */
    href?: string
    /** Override the label (defaults to "All posts" in `lang`). */
    label?: string
    lang: Lang
}

const { href, label, lang } = Astro.props

const labels: Record<Lang, string> = {
    en: 'All posts',
    fi: 'Kaikki kirjoitukset',
    sv: 'Alla inlägg',
}

const hrefs: Record<Lang, string> = {
    en: '/en/blog/all/',
    fi: '/fi/blog/all/',
    sv: '/sv/blog/all/',
}
---

<style>
    .cta-wrapper {
        display: flex;
        justify-content: center;
        padding-top: 2rem;
    }
</style>
<div class="cta-wrapper">
    <a class="btn btn--green" href={href ?? hrefs[lang]}>{label ?? labels[lang]}</a>
</div>
