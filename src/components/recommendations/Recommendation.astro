---
import { getImageSrcset } from '../../lib/images'
import { colors, typographics } from '../../lib/styles'

interface Props {
    alt: string
    recommendation: string
    image: string
    name: string
    title: string
}

const { alt, recommendation, image, name, title } = Astro.props
const img = image ? getImageSrcset(image, '1x1', [448, 896]) : undefined
---

<style
    define:vars={{
        colorsTextPrimary: colors.textPrimary,
        colorsTextSecondary: colors.textSecondary,
        quoteBodyFontFamily: typographics.quoteBody.fontFamily,
        quoteBodyFontSize: typographics.quoteBody.fontSize,
        quoteBodyFontStyle: typographics.quoteBody.fontStyle,
        quoteBodyFontWeight: typographics.quoteBody.fontWeight,
        quoteBodyLineHeight: typographics.quoteBody.lineHeight,
        quoteCiteFontFamily: typographics.quoteCite.fontFamily,
        quoteCiteFontSize: typographics.quoteCite.fontSize,
        quoteCiteFontWeight: typographics.quoteCite.fontWeight,
        quoteCiteLineHeight: typographics.quoteCite.lineHeight,
        quoteCiteMetaFontFamily: typographics.quoteCiteMeta.fontFamily,
        quoteCiteMetaFontSize: typographics.quoteCiteMeta.fontSize,
        quoteCiteMetaFontWeight: typographics.quoteCiteMeta.fontWeight,
        quoteCiteMetaLetterSpacing: typographics.quoteCiteMeta.letterSpacing,
        quoteCiteMetaLineHeight: typographics.quoteCiteMeta.lineHeight,
    }}
>
    article {
        background: var(--colorsOffWhite);
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
    }

    .portrait {
        overflow: hidden;
        width: 100%;
    }

    .portrait :global(img) {
        aspect-ratio: 1;
        object-fit: cover;
        width: 100%;
    }

    blockquote {
        margin: 0;
        padding: 0.25rem 0.5rem 0.5rem;
    }

    p {
        color: var(--colorsTextPrimary);
        font-family: var(--quoteBodyFontFamily);
        font-size: var(--quoteBodyFontSize);
        font-weight: var(--quoteBodyFontWeight);
        line-height: var(--quoteBodyLineHeight);
        margin: 0;
        /* Hangs the opening quotation mark into the blockquote's own left padding. */
        text-indent: -0.45em;
    }

    /*
     * The quotation marks are decoration, so they live in CSS rather than in the markup.
     * They hang off the quote itself rather than the paragraph so that the markup's own
     * indentation can't push them away from the text. Italics live here too, not on the
     * paragraph, so the paragraph's own computed style stays non-italic (Siteimprove sia-r85).
     */
    em {
        font-style: var(--quoteBodyFontStyle);
    }

    em::before,
    em::after {
        content: '”';
    }

    /* Hides the marks from screen readers where the alt-text syntax is supported. */
    @supports (content: '”' / '') {
        em::before,
        em::after {
            content: '”' / '';
        }
    }

    footer {
        display: flex;
        flex-direction: column;
        padding-top: 0.75rem;
    }

    footer cite {
        color: var(--colorsDarkGreen);
        font-family: var(--quoteCiteFontFamily);
        font-size: var(--quoteCiteFontSize);
        font-style: normal;
        font-weight: var(--quoteCiteFontWeight);
        line-height: var(--quoteCiteLineHeight);
    }

    footer span {
        color: var(--colorsTextSecondary);
        font-family: var(--quoteCiteMetaFontFamily);
        font-size: var(--quoteCiteMetaFontSize);
        font-weight: var(--quoteCiteMetaFontWeight);
        letter-spacing: var(--quoteCiteMetaLetterSpacing);
        line-height: var(--quoteCiteMetaLineHeight);
    }
</style>
<article>
    {
        img && (
            <div class="portrait">
                <img
                    alt={alt}
                    height={img.height}
                    loading="lazy"
                    sizes="(max-width: 600px) 100vw, 448px"
                    src={img.src}
                    srcset={img.srcset}
                    style="width:100%;height:auto;"
                    width={img.width}
                />
            </div>
        )
    }
    <blockquote>
        {
            recommendation && (
                <p>
                    <em>{recommendation}</em>
                </p>
            )
        }
        <footer>
            <cite>{name}</cite>
            {title && <span>{title}</span>}
        </footer>
    </blockquote>
</article>
