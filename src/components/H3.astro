---
import { typographics } from '../lib/styles'

interface Props {
    itemProp?: string
}

const { itemProp } = Astro.props
---

<style
    define:vars={{
        h3FontFamily: typographics.h3.fontFamily,
        h3FontSize: typographics.h3.fontSize,
        h3FontWeight: typographics.h3.fontWeight,
        h3LineHeight: typographics.h3.lineHeight,
        titleFontFamily: typographics.title.fontFamily,
        titleFontSize: typographics.title.fontSize,
        titleFontWeight: typographics.title.fontWeight,
        titleLineHeight: typographics.title.lineHeight,
    }}
>
    h3 {
        font-family: var(--h3FontFamily);
        font-weight: var(--h3FontWeight);
        font-size: var(--h3FontSize);
        line-height: var(--h3LineHeight);
        grid-column-start: 3;
        margin-block: 0;
    }

    :global(.prose) h3 {
        color: var(--colorsTextPrimary);
        font-family: var(--titleFontFamily);
        font-size: var(--titleFontSize);
        font-weight: var(--titleFontWeight);
        line-height: var(--titleLineHeight);
        grid-column-start: auto;
        margin-top: 2.25rem;
    }
</style>
<h3 itemprop={itemProp}>
    <slot />
</h3>
