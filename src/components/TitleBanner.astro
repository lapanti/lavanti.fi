---
import type { Lang } from '../content/nav'

import { sizes } from '../lib/styles'
import ArtHead from './titleBanner/ArtHead.astro'
import HeroMedia from './titleBanner/HeroMedia.astro'
import Image from './titleBanner/Image.astro'
import SplitHero from './titleBanner/SplitHero.astro'
import Title from './titleBanner/Title.astro'

interface Props {
    alt?: string
    createdAt?: string
    ctaHref?: string
    ctaLabel?: string
    emphasis?: string
    eyebrow?: string
    heroImage?: string
    intro?: string
    lang?: Lang
    mobileHeroImage?: string
    readingTime?: number
    tags?: string[]
    title: string
    updatedDate?: string
    variant?: 'page' | 'post' | 'split'
}

const {
    alt,
    createdAt,
    ctaHref,
    ctaLabel,
    emphasis,
    eyebrow,
    heroImage,
    intro,
    lang,
    mobileHeroImage,
    readingTime,
    tags,
    title,
    updatedDate,
    variant = 'page',
} = Astro.props
---

<style define:vars={{ sizes45: sizes[45] }}>
    .container {
        background-color: var(--colorsForestGreen);
        grid-column: 1 / -1;
        padding-top: var(--headerSize);
    }

    .content {
        background-color: var(--colorsWhite);
    }

    @media (min-width: 1200px) {
        .container {
            height: var(--sizes45);
        }

        .content {
            display: flex;
            flex-direction: row;
            height: 100%;
            justify-content: flex-end;
            margin: auto;
        }
    }
</style>
{
    variant === 'post' ? (
        <Fragment>
            <ArtHead
                createdAt={createdAt}
                lang={lang}
                readingTime={readingTime}
                tags={tags}
                title={title}
                updatedDate={updatedDate}
            />
            <HeroMedia alt={alt} heroImage={heroImage} />
        </Fragment>
    ) : variant === 'split' ? (
        <SplitHero
            alt={alt}
            ctaHref={ctaHref}
            ctaLabel={ctaLabel}
            emphasis={emphasis}
            eyebrow={eyebrow}
            heroImage={heroImage}
            intro={intro}
            mobileHeroImage={mobileHeroImage}
            title={title}
        />
    ) : (
        <div class="container">
            <div class="content">
                <Title
                    createdAt={createdAt}
                    lang={lang}
                    readingTime={readingTime}
                    tags={tags}
                    title={title}
                    updatedDate={updatedDate}
                />
                <Image alt={alt} heroImage={heroImage} />
            </div>
        </div>
    )
}
