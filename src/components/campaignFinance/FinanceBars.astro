---
/**
 * A row of labelled bars for comparing amounts — our budget against what campaigns
 * cost in 2023, or how those campaigns were funded.
 *
 * The bars are decoration: each one is aria-hidden, and the label and the amount next
 * to it carry the same information as text. A reader with no CSS, or a screen reader,
 * loses nothing.
 */
import type { Lang } from '../../content/nav'

import { barsMax, barWidth, formatEuro, formatPercent } from '../../lib/campaignFinance'
import { colors, typographics } from '../../lib/styles'

interface Row {
    /** Our own figure among the comparisons — drawn in the campaign's green. */
    emphasis?: boolean
    label: string
    value: number
}

interface Props {
    caption: string
    lang: Lang
    rows: Row[]
    unit: 'eur' | 'percent'
}

const { caption, lang, rows, unit } = Astro.props

/*
 * The largest row sets the scale, so the tallest bar always fills the track and the
 * differences between the rest stay readable.
 */
const max = barsMax(rows.map((row) => row.value))
const format = (value: number): string => (unit === 'eur' ? formatEuro(value, lang) : formatPercent(value, lang))
---

<style
    define:vars={{
        barsAmountFontFamily: typographics.meta.fontFamily,
        barsCaptionFontFamily: typographics.title.fontFamily,
        barsCaptionFontSize: typographics.title.fontSize,
        barsCaptionFontWeight: typographics.title.fontWeight,
        barsLabelFontFamily: typographics.text.fontFamily,
        barsLabelFontSize: typographics.text.fontSize,
        colorsBrightGreen: colors.brightGreen,
        colorsDarkGreen: colors.darkGreen,
        colorsForestGreen: colors.forestGreen,
        colorsForestGreen10: colors.forestGreen10,
        colorsTextPrimary: colors.textPrimary,
    }}
>
    .bars {
        margin: 0;
        padding-top: 1.5rem;
    }

    .bars figcaption {
        color: var(--colorsForestGreen);
        font-family: var(--barsCaptionFontFamily);
        font-size: var(--barsCaptionFontSize);
        font-weight: var(--barsCaptionFontWeight);
        line-height: 1.3;
        padding-bottom: 1rem;
    }

    .rows {
        display: grid;
        gap: 1rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .row {
        align-items: center;
        display: grid;
        gap: 0.375rem 0.75rem;
        grid-template-columns: 1fr auto;
    }

    .label {
        color: var(--colorsTextPrimary);
        font-family: var(--barsLabelFontFamily);
        font-size: var(--barsLabelFontSize);
        line-height: 1.4;
    }

    .amount {
        color: var(--colorsForestGreen);
        font-family: var(--barsAmountFontFamily);
        font-size: 1.0625rem;
        font-weight: 700;
        justify-self: end;
        white-space: nowrap;
    }

    .track {
        background: var(--colorsForestGreen10);
        border-radius: 2px;
        display: block;
        grid-column: 1 / -1;
        height: 0.75rem;
        overflow: hidden;
    }

    .fill {
        background: var(--colorsDarkGreen);
        border-radius: 2px;
        display: block;
        height: 100%;
        width: var(--w);
    }

    .row--emphasis .label {
        font-weight: 700;
    }

    .row--emphasis .fill {
        background: var(--colorsBrightGreen);
    }

    .foot {
        padding-top: 1rem;
    }

    @media (min-width: 769px) {
        .row {
            grid-template-columns: minmax(0, 14rem) 1fr auto;
        }

        .track {
            grid-column: 2;
        }
    }
</style>

<figure class="bars">
    <figcaption>{caption}</figcaption>
    <ol class="rows">
        {
            rows.map((row) => (
                <li class:list={['row', { 'row--emphasis': row.emphasis }]}>
                    <span class="label">{row.label}</span>
                    <span aria-hidden="true" class="track">
                        <span class="fill" style={`--w: ${barWidth(row.value, max)}%`} />
                    </span>
                    <span class="amount">{format(row.value)}</span>
                </li>
            ))
        }
    </ol>
    {
        Astro.slots.has('default') && (
            <div class="foot">
                <slot />
            </div>
        )
    }
</figure>
