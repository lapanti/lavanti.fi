---
/**
 * One amount broken into its parts — the budget by funding source, or the money
 * raised split into spent and unspent.
 *
 * The bar is aria-hidden decoration and only carries segments with money in them.
 * The legend below it lists every part, zeros included: a funding source that has
 * given nothing is exactly what a transparency page exists to show.
 */
import type { Lang } from '../../content/nav'
import type { FinanceSegment } from '../../lib/campaignFinance'

import { formatEuro, formatPercent, percentOf, toneColors } from '../../lib/campaignFinance'
import { colors, typographics } from '../../lib/styles'

interface Props {
    caption: string
    lang: Lang
    segments: FinanceSegment[]
    /** The whole the segments are parts of; drives both bar widths and the shares. */
    total: number
}

const { caption, lang, segments, total } = Astro.props
const drawn = segments.filter((segment) => segment.value > 0)
---

<style
    define:vars={{
        colorsForestGreen: colors.forestGreen,
        colorsForestGreen10: colors.forestGreen10,
        colorsForestGreen70: colors.forestGreen70,
        colorsTextPrimary: colors.textPrimary,
        colorsTextSecondary: colors.textSecondary,
        stackCaptionFontFamily: typographics.title.fontFamily,
        stackCaptionFontSize: typographics.title.fontSize,
        stackCaptionFontWeight: typographics.title.fontWeight,
        stackLabelFontFamily: typographics.text.fontFamily,
        stackLabelFontSize: typographics.text.fontSize,
        stackShareFontFamily: typographics.meta.fontFamily,
    }}
>
    .stack {
        margin: 0;
        padding-top: 1.5rem;
    }

    .stack figcaption {
        color: var(--colorsForestGreen);
        font-family: var(--stackCaptionFontFamily);
        font-size: var(--stackCaptionFontSize);
        font-weight: var(--stackCaptionFontWeight);
        line-height: 1.3;
        padding-bottom: 1rem;
    }

    .bar {
        border-radius: 3px;
        display: flex;
        gap: 2px;
        height: 1.75rem;
        overflow: hidden;
    }

    .seg {
        background: var(--tone);
        box-shadow: inset 0 0 0 1px var(--colorsForestGreen10);
        min-width: 3px;
    }

    /* What is still missing is drawn as an outline, not a solid block. */
    .seg--needed,
    .swatch--needed {
        border: 2px dashed var(--colorsForestGreen70);
    }

    .legend {
        display: grid;
        gap: 0.75rem;
        list-style: none;
        margin: 0;
        padding: 1.25rem 0 0;
    }

    .item {
        align-items: baseline;
        display: grid;
        gap: 0.25rem 0.75rem;
        grid-template-columns: 0.875rem 1fr auto;
    }

    .swatch {
        background: var(--tone);
        border-radius: 2px;
        box-shadow: inset 0 0 0 1px var(--colorsForestGreen10);
        height: 0.875rem;
        width: 0.875rem;
    }

    .name {
        color: var(--colorsTextPrimary);
        font-family: var(--stackLabelFontFamily);
        font-size: var(--stackLabelFontSize);
        line-height: 1.4;
    }

    .figures {
        color: var(--colorsForestGreen);
        font-family: var(--stackShareFontFamily);
        font-size: 1.0625rem;
        font-weight: 700;
        justify-self: end;
        white-space: nowrap;
    }

    .share {
        color: var(--colorsTextSecondary);
        font-weight: 400;
        padding-left: 0.375rem;
    }
</style>

<figure class="stack">
    <figcaption>{caption}</figcaption>
    <div aria-hidden="true" class="bar">
        {
            drawn.map((segment) => (
                <div
                    class:list={['seg', { 'seg--needed': segment.tone === 'needed' }]}
                    style={`--tone: ${toneColors[segment.tone]}; flex: ${segment.value} 1 0%`}
                />
            ))
        }
    </div>
    <ul class="legend">
        {
            segments.map((segment) => (
                <li class="item">
                    <span
                        aria-hidden="true"
                        class:list={['swatch', { 'swatch--needed': segment.tone === 'needed' }]}
                        style={`--tone: ${toneColors[segment.tone]}`}
                    />
                    <span class="name">{segment.label}</span>
                    <span class="figures">
                        {formatEuro(segment.value, lang)}
                        <span class="share">{formatPercent(percentOf(segment.value, total), lang)}</span>
                    </span>
                </li>
            ))
        }
    </ul>
</figure>
