---
/**
 * One amount broken into its parts — the budget by funding source, or the money
 * raised split into spent and unspent.
 *
 * The bar is aria-hidden decoration and only carries segments with money in them.
 * The legend below it lists every part, zeros included: a funding source that has
 * given nothing is exactly what a transparency page exists to show.
 */
import type { Lang } from '../../content/nav'
import type { FinanceSegment, Tone } from '../../lib/campaignFinance'

import { formatPercent, percentOf, toneColors, withPending } from '../../lib/campaignFinance'
import { colors, fontWeights, sizes, typographics } from '../../lib/styles'

interface Props {
    caption: string
    lang: Lang
    segments: FinanceSegment[]
    /**
     * Print each part's share of the total next to its amount. Off for the spending
     * stack: there the whole is the money raised so far, which keeps moving, and a
     * "100 %" spent reads as the campaign being out of money rather than as early bills.
     */
    showShares?: boolean
    /** The whole the segments are parts of; drives both bar widths and the shares. */
    total: number
}

const { caption, lang, segments, showShares = true, total } = Astro.props
const size = (segment: FinanceSegment): number => segment.value + (segment.pending ?? 0)
const drawn = segments.filter((segment) => size(segment) > 0)

/** Hatched whole: the shortfall, or an undertaking that has not moved. */
const HATCHED_TONES = new Set<Tone>(['committed', 'needed'])
---

<style
    define:vars={{
        barHeight: sizes[1.75],
        captionFontFamily: typographics.title.fontFamily,
        captionFontSize: typographics.title.fontSize,
        captionFontWeight: typographics.title.fontWeight,
        captionPad: sizes[1],
        colorsForestGreen70: colors.forestGreen70,
        figuresFontSize: typographics.text.fontSize,
        figuresFontWeight: fontWeights.bold,
        labelFontFamily: typographics.text.fontFamily,
        labelFontSize: typographics.text.fontSize,
        legendPad: sizes[1.25],
        legendWidth: sizes[35],
        shareFontFamily: typographics.meta.fontFamily,
        swatchSize: sizes[0.875],
    }}
>
    .stack {
        margin: 0;
        padding-top: var(--sectionPad);
    }

    .stack figcaption {
        color: var(--colorsForestGreen);
        font-family: var(--captionFontFamily);
        font-size: var(--captionFontSize);
        font-weight: var(--captionFontWeight);
        line-height: 1.3;
        padding-bottom: var(--captionPad);
    }

    .bar {
        border-radius: 3px;
        display: flex;
        gap: 2px;
        height: var(--barHeight);
        overflow: hidden;
    }

    .seg {
        background: var(--tone);
        box-shadow: inset 0 0 0 1px var(--colorsForestGreen70);
        min-width: 3px;
    }

    .legend {
        display: grid;
        gap: 0.75rem;
        list-style: none;
        margin: 0;
        /*
         * Narrower than the bar on purpose: at full plate width the amount drifts a
         * screen away from the label it belongs to, and the eye stops connecting them.
         */
        max-width: var(--legendWidth);
        padding: var(--legendPad) 0 0;
    }

    .item {
        align-items: baseline;
        display: grid;
        gap: 0.25rem 0.75rem;
        grid-template-columns: var(--swatchSize) 1fr auto;
    }

    /*
     * The outline carries the pale tones: a light swatch on the oat or off-white plate
     * would otherwise read as an empty gap in the list.
     */
    .swatch {
        background: var(--tone);
        border-radius: 2px;
        box-shadow: inset 0 0 0 1px var(--colorsForestGreen70);
        height: var(--swatchSize);
        width: var(--swatchSize);
    }

    /*
     * Money that has not moved yet — pending, committed, or still to be raised — is
     * hatched rather than filled, so a solid block always means money that has
     * actually moved. Declared after .seg and .swatch: the rules carry the same
     * specificity, so source order is what decides which background wins.
     */
    .seg--hatched,
    .swatch--hatched {
        background: repeating-linear-gradient(135deg, var(--tone) 0 5px, var(--colorsWhite) 5px 10px);
        box-shadow: inset 0 0 0 1px var(--colorsForestGreen70);
    }

    /* Coarser stripes on the 14 px swatch, where a 5 px gap would read as solid. */
    .swatch--hatched {
        background: repeating-linear-gradient(135deg, var(--tone) 0 3px, var(--colorsWhite) 3px 6px);
    }

    .name {
        color: var(--colorsTextPrimary);
        font-family: var(--labelFontFamily);
        font-size: var(--labelFontSize);
        line-height: 1.4;
    }

    .figures {
        color: var(--colorsForestGreen);
        font-family: var(--shareFontFamily);
        font-size: var(--figuresFontSize);
        font-weight: var(--figuresFontWeight);
        justify-self: end;
        white-space: nowrap;
    }

    .share {
        color: var(--colorsTextSecondary);
        font-weight: 400;
        padding-left: 0.375rem;
    }

    /*
     * One sweep across the whole bar rather than a per-segment reveal: the segments are
     * parts of a single amount, and staggering them would imply an order the data does
     * not have. Same @supports and reduced-motion guards as the comparison bars.
     */
    @supports (animation-timeline: view()) {
        @media (prefers-reduced-motion: no-preference) {
            .bar {
                animation: sweep linear both;
                animation-range: entry 20% cover 30%;
                transform-origin: left center;
            }

            /* Separate rule: see the note in FinanceBars — the shorthand cannot carry
               a timeline, and the minifier folds adjacent animation declarations. */
            .stack .bar {
                animation-timeline: view();
            }
        }
    }

    @keyframes sweep {
        from {
            transform: scaleX(0);
        }

        to {
            transform: scaleX(1);
        }
    }
</style>

<figure class="stack">
    <figcaption>{caption}</figcaption>
    <div aria-hidden="true" class="bar">
        {
            drawn.flatMap((segment) => {
                const hatched = HATCHED_TONES.has(segment.tone)
                const tone = `--tone: ${toneColors[segment.tone]}`

                return [
                    segment.value > 0 && (
                        <div
                            class:list={['seg', { 'seg--hatched': hatched }]}
                            style={`${tone}; flex: ${segment.value} 1 0%`}
                        />
                    ),
                    (segment.pending ?? 0) > 0 && (
                        <div class="seg seg--hatched" style={`${tone}; flex: ${segment.pending} 1 0%`} />
                    ),
                ]
            })
        }
    </div>
    <ul class="legend">
        {
            segments.map((segment) => (
                <li class="item">
                    <span
                        aria-hidden="true"
                        class:list={['swatch', { 'swatch--hatched': HATCHED_TONES.has(segment.tone) }]}
                        style={`--tone: ${toneColors[segment.tone]}`}
                    />
                    <span class="name">{segment.label}</span>
                    <span class="figures">
                        {withPending(segment.value, segment.pending, segment.pendingLabel, lang)}
                        {showShares && (
                            <span class="share">{formatPercent(percentOf(size(segment), total), lang)}</span>
                        )}
                    </span>
                </li>
            ))
        }
    </ul>
</figure>
