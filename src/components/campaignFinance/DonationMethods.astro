---
/**
 * The ways to donate, for the election and finance pages, ordered by what the campaign
 * prefers: MobilePay (`/mp`) and bank transfer go straight to the support association and
 * come first; the party's donation page (`/lahjoita`) comes last and alone waits on
 * `donationsOpen`. Every value a donor has to type is printed with a copy button, so a
 * bank transfer needs no visit to the terms page.
 */
import type { Lang } from '../../content/nav'

import { campaignFinance, financeLabels, supportAssociation } from '../../content/campaignFinance'
import { typographics } from '../../lib/styles'
import Eyebrow from '../Eyebrow.astro'
import Plate from '../Plate.astro'

interface Props {
    /** Section anchor; localized like every other section id on these pages. */
    id: string
    lang: Lang
}

/** Donation terms page per locale, and the anchor of its bank transfer heading. */
const donationTerms: Record<Lang, string> = {
    en: '/en/elections/campaign-finance/donation-terms/#bank-transfer',
    fi: '/fi/eduskuntavaalit/vaalirahoitus/lahjoitusehdot/#tilisiirto',
    sv: '/sv/riksdagsvalet/valfinansiering/donationsvillkor/#bankoverforing',
}

const { id, lang } = Astro.props
const labels = financeLabels[lang].donationMethods
const pending = financeLabels[lang].donate.pending

/** `copy` is what lands on the clipboard: the IBAN without spaces pastes into any bank form. */
const mobilePayFields = [
    {
        copy: supportAssociation.mobilePayNumber,
        label: labels.mobilePay.number,
        value: supportAssociation.mobilePayNumber,
    },
]
const bankFields = [
    { copy: supportAssociation.name, label: labels.bankTransfer.recipient, value: supportAssociation.name },
    {
        copy: supportAssociation.iban.replaceAll(' ', ''),
        label: labels.bankTransfer.iban,
        value: supportAssociation.iban,
    },
]

/*
 * Copy buttons are icon-only; the accessible name and tooltip carry "<copy>: <field>".
 * They render hidden and the script reveals them only where the Clipboard API exists, so a
 * browser without it never shows a button that does nothing. After a copy the button shows
 * a check mark for two seconds and the live region announces it. One delegated listener
 * serves every button on the page.
 */
const copyScript = `(function(){
    if(!navigator.clipboard) return
    document.querySelectorAll('button[data-copy]').forEach(function(button){ button.hidden = false })
    if(window.__donationCopyBound) return
    window.__donationCopyBound = true
    document.addEventListener('click', function(event){
        var button = event.target.closest && event.target.closest('button[data-copy]')
        if(!button) return
        navigator.clipboard.writeText(button.getAttribute('data-copy')).then(function(){
            var status = button.closest('section').querySelector('[data-copy-status]')
            button.classList.add('is-done')
            if(status) status.textContent = button.getAttribute('data-done')
            setTimeout(function(){
                button.classList.remove('is-done')
                if(status) status.textContent = ''
            }, 2000)
        })
    })
})()`
---

<style
    define:vars={{
        titleFontFamily: typographics.title.fontFamily,
        titleFontWeight: typographics.title.fontWeight,
    }}
>
    .intro {
        padding-top: 1rem;
    }

    .methods {
        display: grid;
        gap: 2rem;
        list-style: none;
        margin: 0;
        padding: 1.5rem 0 0;
    }

    .methods > li {
        align-content: start;
        border-left: 4px solid var(--colorsSand);
        display: grid;
        gap: 0.75rem;
        padding: 0.25rem 0 0.25rem 0.75rem;
    }

    .methods h3 {
        color: var(--colorsDeepForest);
        font-family: var(--titleFontFamily);
        font-size: 1.1875rem;
        font-weight: var(--titleFontWeight);
        line-height: 1.3;
        margin: 0;
    }

    .methods p,
    .fields {
        margin: 0;
    }

    .fields {
        display: grid;
        gap: 0.75rem;
    }

    .fields > div {
        display: grid;
        gap: 0.25rem;
    }

    .fields dd {
        margin: 0;
    }

    /* Value and icon share a row; a long value wraps inside its own column. */
    .fields .copyable {
        align-items: center;
        column-gap: 0.25rem;
        display: grid;
        grid-template-columns: minmax(0, auto) 2.75rem;
        justify-content: start;
    }

    .value {
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    /* 44px hit area; the negative margin keeps it from growing the row. */
    .copy {
        align-items: center;
        background: transparent;
        border: 0;
        color: var(--colorsDarkGreen);
        cursor: pointer;
        display: inline-flex;
        height: 2.75rem;
        justify-content: center;
        margin-block: -0.5rem;
        padding: 0;
        width: 2.75rem;
    }

    .copy:hover {
        color: var(--colorsDeepForest);
    }

    .copy svg {
        height: 1.25rem;
        width: 1.25rem;
    }

    /* `is-done` is set by the copy script, so the template never shows it to the linter. */
    .copy .done,
    .copy:global(.is-done) .idle {
        display: none;
    }

    .copy:global(.is-done) .done {
        display: block;
    }

    .copy[hidden] {
        display: none;
    }

    .action {
        padding-top: 0.5rem;
    }

    .action .btn {
        display: block;
        text-align: center;
        width: 100%;
    }

    .status {
        clip-path: inset(50%);
        height: 1px;
        overflow: hidden;
        position: absolute;
        white-space: nowrap;
        width: 1px;
    }

    @media (min-width: 769px) {
        .methods {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>

<Plate eyebrow={labels.eyebrow} ground="white" heading={labels.heading} id={id}>
    <p class="intro">{labels.intro(supportAssociation.name)}</p>
    <ul class="methods">
        <li>
            <h3>{labels.mobilePay.title}</h3>
            <dl class="fields">
                {
                    mobilePayFields.map((field) => (
                        <div>
                            <dt>
                                <Eyebrow>{field.label}</Eyebrow>
                            </dt>
                            <dd class="copyable">
                                <span class="value">{field.value}</span>
                                <button
                                    aria-label={`${labels.copy}: ${field.label}`}
                                    class="copy"
                                    data-copy={field.copy}
                                    data-done={labels.copied}
                                    hidden
                                    title={`${labels.copy}: ${field.label}`}
                                    type="button"
                                >
                                    <svg
                                        aria-hidden="true"
                                        class="idle"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        viewBox="0 0 24 24"
                                    >
                                        <rect height="13" rx="2" width="13" x="9" y="9" />
                                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                                    </svg>
                                    <svg
                                        aria-hidden="true"
                                        class="done"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="M20 6 9 17l-5-5" />
                                    </svg>
                                </button>
                            </dd>
                        </div>
                    ))
                }
            </dl>
            <p class="action">
                <a class="btn btn--solid" href={campaignFinance.mobilePayUrl}>{labels.mobilePay.link}</a>
            </p>
        </li>
        <li>
            <h3>{labels.bankTransfer.title}</h3>
            <dl class="fields">
                {
                    bankFields.map((field) => (
                        <div>
                            <dt>
                                <Eyebrow>{field.label}</Eyebrow>
                            </dt>
                            <dd class="copyable">
                                <span class="value">{field.value}</span>
                                <button
                                    aria-label={`${labels.copy}: ${field.label}`}
                                    class="copy"
                                    data-copy={field.copy}
                                    data-done={labels.copied}
                                    hidden
                                    title={`${labels.copy}: ${field.label}`}
                                    type="button"
                                >
                                    <svg
                                        aria-hidden="true"
                                        class="idle"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        viewBox="0 0 24 24"
                                    >
                                        <rect height="13" rx="2" width="13" x="9" y="9" />
                                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                                    </svg>
                                    <svg
                                        aria-hidden="true"
                                        class="done"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="M20 6 9 17l-5-5" />
                                    </svg>
                                </button>
                            </dd>
                        </div>
                    ))
                }
                <div>
                    <dt>
                        <Eyebrow>{labels.bankTransfer.messageLabel}</Eyebrow>
                    </dt>
                    <dd>{labels.bankTransfer.message}</dd>
                </div>
            </dl>
            <p>
                <a class="link-rule" href={donationTerms[lang]}>{labels.bankTransfer.terms}</a>
            </p>
        </li>
        <li>
            <h3>{labels.card.title}</h3>
            <p class="action">
                {
                    campaignFinance.donationsOpen ? (
                        <a class="btn" href={campaignFinance.donationUrl}>
                            {labels.card.link}
                        </a>
                    ) : (
                        pending
                    )
                }
            </p>
        </li>
    </ul>
    <p aria-live="polite" class="status" data-copy-status></p>
    <script is:inline set:html={copyScript} />
</Plate>
