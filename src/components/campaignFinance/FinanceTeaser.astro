---
/**
 * The campaign's finances in four figures, for the election page. Reads the same data
 * module as the finance page itself, so the two can never disagree.
 */
import type { Lang } from '../../content/nav'

import { campaignFinance, financeLabels } from '../../content/campaignFinance'
import { formatEuro, gapToBudget, totalRaised } from '../../lib/campaignFinance'
import Plate from '../Plate.astro'
import FinanceStats from './FinanceStats.astro'

interface Props {
    href: string
    lang: Lang
}

const { href, lang } = Astro.props
const labels = financeLabels[lang]
const items = [
    { label: labels.budget, value: formatEuro(campaignFinance.budget, lang) },
    { label: labels.raised, value: formatEuro(totalRaised(campaignFinance), lang) },
    { label: labels.spent, value: formatEuro(campaignFinance.spent, lang) },
    { label: labels.gap, value: formatEuro(gapToBudget(campaignFinance), lang) },
]
---

<style>
    .foot {
        padding-top: 1.5rem;
    }
</style>

<Plate eyebrow={labels.teaser.eyebrow} ground="gray" heading={labels.teaser.heading} id="rahoitus">
    <FinanceStats items={items} />
    <p class="foot">
        <a class="link-rule" href={href}>{labels.teaser.cta}</a>
    </p>
</Plate>
