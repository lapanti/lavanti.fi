---
/**
 * The headline figures of the campaign's finances, two per row on a phone and four
 * across from tablet up.
 */
import { sizes } from '../../lib/styles'
import FinanceStat from './FinanceStat.astro'

interface Props {
    items: { label: string; note?: string; value: string }[]
}

const { items } = Astro.props
---

<style define:vars={{ columnGap: sizes[1], desktopGap: sizes[2], rowGap: sizes[1.5], sectionPad: sizes[1.5] }}>
    .stats {
        display: grid;
        gap: var(--rowGap) var(--columnGap);
        grid-template-columns: repeat(2, minmax(0, 1fr));
        margin: 0;
        padding-top: var(--sectionPad);
    }

    @media (min-width: 769px) {
        .stats {
            gap: var(--desktopGap);
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }
</style>

<dl class="stats">
    {items.map((item) => <FinanceStat label={item.label} note={item.note} value={item.value} />)}
</dl>
