---
import type { Lang } from '../../content/nav'
import type { StripPhoto } from '../../content/photoStrips'

import { getImageSrcset } from '../../lib/images'
import { sizes, typographics } from '../../lib/styles'

interface Props {
    lang: Lang
    /**
     * `grid` wraps cells into rows; `scroll` is one horizontally scrollable, scroll-snapped row.
     * Defaults to `scroll` when more photos than fit one desktop row (3), else `grid`.
     */
    layout?: 'grid' | 'scroll'
    photos: StripPhoto[]
}

const { lang, layout = Astro.props.photos.length > 3 ? 'scroll' : 'grid', photos } = Astro.props

const creditPrefix: Record<Lang, string> = { en: 'Photo', fi: 'Kuva', sv: 'Foto' }
---

<style
    define:vars={{
        captionFontFamily: typographics.caption.fontFamily,
        captionFontSize: typographics.caption.fontSize,
        captionFontWeight: typographics.caption.fontWeight,
        captionLineHeight: typographics.caption.lineHeight,
        sizes05: sizes[0.5],
        sizes1: sizes[1],
        sizes2: sizes[2],
    }}
>
    ul {
        display: grid;
        gap: var(--sizes2);
        grid-template-columns: 1fr;
        list-style: none;
        margin: var(--sizes1) 0 var(--sizes2);
        padding: 0;
    }

    figure {
        display: flex;
        flex-direction: column;
        gap: var(--sizes05);
        margin: 0;
        width: 100%;
    }

    img {
        background: var(--colorsGray);
        border-radius: 4px;
        height: auto;
        width: 100%;
    }

    figcaption {
        color: var(--colorsTextSecondary);
        font-family: var(--captionFontFamily);
        font-size: var(--captionFontSize);
        font-weight: var(--captionFontWeight);
        line-height: var(--captionLineHeight);
    }

    .credit {
        display: block;
    }

    @media (min-width: 769px) {
        ul {
            gap: var(--sizes1);
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    /* One scroll-snapped row; the partly visible last cell signals that the row scrolls. */
    ul.scroll {
        display: flex;
        gap: var(--sizes1);
        overflow-x: auto;
        overscroll-behavior-x: contain;
        padding-bottom: var(--sizes05);
        scroll-snap-type: x mandatory;
        scrollbar-width: thin;
    }

    ul.scroll li {
        flex: 0 0 auto;
        scroll-snap-align: start;
        width: min(calc((100% - var(--sizes1)) / 1.2), 20rem);
    }

    @media (min-width: 769px) {
        ul.scroll li {
            width: calc((100% - 2 * var(--sizes1)) / 3.3);
        }
    }
</style>

<ul class:list={['photo-strip', layout]}>
    {
        photos.map((photo) => {
            const img = getImageSrcset(photo.slug, 'body', photo.widths)

            return (
                <li>
                    <figure>
                        <img
                            alt={photo.alt[lang]}
                            height={img.height}
                            loading="lazy"
                            sizes="(max-width: 768px) 100vw, 33vw"
                            src={img.src}
                            srcset={img.srcset}
                            width={img.width}
                        />
                        <figcaption>
                            {photo.caption[lang]}
                            {photo.photographer && (
                                <span class="credit">
                                    {creditPrefix[lang]}: {photo.photographer}
                                </span>
                            )}
                        </figcaption>
                    </figure>
                </li>
            )
        })
    }
</ul>
