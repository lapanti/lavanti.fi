---
import type { Lang } from '../../content/nav'

import { getImageSrcset } from '../../lib/images'
import { typographics } from '../../lib/styles'

interface Props {
    alt?: string
    caption: string
    image?: string
    /** Selects the credit prefix; defaults to 'fi'. Ignored when photographer is omitted. */
    lang?: Lang
    /** Omit when no credit applies. */
    photographer?: string
}

const { alt, caption, image, lang = 'fi', photographer } = Astro.props
const img = image ? getImageSrcset(image, 'body', [400, 800, 1200]) : undefined

const creditPrefix: Record<Lang, string> = { en: 'Photo', fi: 'Kuva', sv: 'Foto' }
---

<style
    define:vars={{
        captionFontFamily: typographics.caption.fontFamily,
        captionFontSize: typographics.caption.fontSize,
        captionFontWeight: typographics.caption.fontWeight,
        captionLineHeight: typographics.caption.lineHeight,
    }}
>
    figure {
        grid-column-start: 3;
        margin-bottom: var(--sizes1);
        margin-top: var(--sizes1);
    }

    figcaption {
        color: var(--colorsTextSecondary);
        font-family: var(--captionFontFamily);
        font-size: var(--captionFontSize);
        font-weight: var(--captionFontWeight);
        line-height: var(--captionLineHeight);
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: var(--sizes05);
        text-align: center;
        width: 100%;
    }

    .credit {
        display: block;
    }

    :global(.prose) figure {
        grid-column-start: auto;
        margin-block: 2rem;
    }

    :global(.prose) figcaption {
        align-items: flex-start;
        text-align: left;
    }
</style>
{
    img && (
        <figure aria-label={caption}>
            <img
                alt={alt ?? ''}
                height={img.height}
                loading="lazy"
                sizes="(max-width: 640px) 100vw, 800px"
                src={img.src}
                srcset={img.srcset}
                style="width:100%;height:auto;"
                width={img.width}
            />
            <figcaption>
                {caption}
                {photographer && (
                    <span class="credit">
                        {creditPrefix[lang]}: {photographer}
                    </span>
                )}
            </figcaption>
        </figure>
    )
}
