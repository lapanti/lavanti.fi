---
import type { Lang } from '../content/nav'
import type { BreadcrumbParent } from '../lib/breadcrumbs'
import type { BreadcrumbItem, FaqItem, JsonLdType } from '../lib/jsonld'

import Faq from '../components/Faq.astro'
import HeroPreloadLinks from '../components/HeroPreloadLinks.astro'
import Stripe from '../components/Stripe.astro'
import TitleBanner from '../components/TitleBanner.astro'
import { pageBreadcrumbs } from '../lib/breadcrumbs'
import { faqSectionLabels, hasFaqSection } from '../lib/faq'
import { getImage } from '../lib/images'
import { ogId } from '../lib/og/id'
import { visibleCampaignEvents } from '../lib/visibleEvents'
import BaseLayout from './BaseLayout.astro'

interface Props {
    alt?: string
    /** The page's own crumb; defaults to `pageTitle`. */
    breadcrumbName?: string
    /** Section the page sits under. Without it the page emits no BreadcrumbList. */
    breadcrumbParent?: BreadcrumbParent
    createdAt?: string
    ctaHref?: string
    ctaLabel?: string
    description?: string
    emphasis?: string
    /** Opt in to the campaign Event JSON-LD. The section itself renders from the page body. */
    eventCalendar?: boolean
    eyebrow?: string
    faq?: Array<FaqItem>
    /**
     * Opt in to the visible FAQ plate below the page body. Unlike PostLayout and
     * NewsletterLayout, a PageLayout body is composed by the page itself: the
     * election pages already mount <Faq> mid-body with their own heading, so
     * rendering it automatically from `faq` would duplicate them.
     */
    faqSection?: boolean
    heroImage?: string
    intro?: string
    lang?: Lang
    langAlternates?: Record<Lang, string>
    mobileHeroImage?: string
    noindex?: boolean
    pageTitle: string
    plated?: boolean
    slug?: string
    tags?: string[]
    title: string
    type?: JsonLdType
    updatedAt?: string
    updatedDate?: string
    variant?: 'page' | 'split'
}

// Support both MDX layout usage (props under frontmatter) and direct .astro component usage
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const props: Props = ((Astro.props as any).frontmatter as Props | undefined) ?? (Astro.props as Props)
const {
    alt,
    breadcrumbName,
    breadcrumbParent,
    createdAt,
    ctaHref,
    ctaLabel,
    description,
    emphasis,
    eventCalendar,
    eyebrow,
    faq,
    faqSection = false,
    heroImage,
    intro,
    lang,
    langAlternates,
    mobileHeroImage,
    noindex,
    pageTitle,
    plated = false,
    slug,
    tags,
    title,
    type,
    updatedAt,
    updatedDate,
    variant = 'page',
} = props

/*
 * Pages with a canonical slug get a generated per-page card; slug-less pages (e.g. 404)
 * and noindex pages (src/lib/og/cards.ts builds no card for them) fall back to the static
 * default social card.
 */
const ogImage =
    slug && !noindex
        ? new URL(`/og/${ogId(slug)}.png`, Astro.site).href
        : getImage('og-image-lauri-lavanti', 'ogFlat').src

// Narrowed here rather than in the template: the type guard does not carry into the JSX expression.
const faqItems = faqSection && lang && hasFaqSection(faq) ? faq : undefined
const faqLabels = lang ? faqSectionLabels[lang] : undefined

const breadcrumbs: BreadcrumbItem[] | undefined =
    breadcrumbParent && lang && slug
        ? pageBreadcrumbs(lang, slug, breadcrumbName ?? pageTitle, breadcrumbParent)
        : undefined
---

<BaseLayout
    breadcrumbs={breadcrumbs}
    createdAt={createdAt}
    description={description}
    events={eventCalendar ? visibleCampaignEvents() : undefined}
    faq={faq}
    headerVariant={variant === 'split' ? 'hero' : 'solid'}
    lang={lang}
    langAlternates={langAlternates}
    noindex={noindex}
    ogImage={ogImage}
    ogImageAlt="Lauri Lavanti"
    plated={plated}
    slug={slug}
    title={pageTitle}
    type={type}
    updatedAt={updatedAt ?? updatedDate}
>
    <Fragment slot="head">
        <HeroPreloadLinks
            heroImage={heroImage}
            mobileHeroImage={mobileHeroImage}
            mode={variant === 'split' ? 'art-directed' : 'page'}
        />
    </Fragment>
    <TitleBanner
        alt={alt}
        createdAt={createdAt}
        ctaHref={ctaHref}
        ctaLabel={ctaLabel}
        emphasis={emphasis}
        eyebrow={eyebrow}
        heroImage={heroImage}
        intro={intro}
        lang={lang}
        mobileHeroImage={mobileHeroImage}
        slot="banner"
        tags={tags}
        title={title}
        variant={variant}
    />
    <Stripe size="slim" />
    <slot />
    {faqItems && faqLabels && <Faq eyebrow={faqLabels.eyebrow} faq={faqItems} heading={faqLabels.heading} />}
</BaseLayout>
