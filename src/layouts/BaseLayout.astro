---
import type { CampaignEvent } from '../content/events'
import type { Lang } from '../content/nav'
/* eslint-disable astro/no-unused-css-selector */
import type { AuthorEntry } from '../content/person'
import type { BreadcrumbItem, FaqItem, JsonLdType } from '../lib/jsonld'

import Footer from '../components/Footer.astro'
import GlobalStyle from '../components/GlobalStyle.astro'
import Head from '../components/Head.astro'
import Header from '../components/Header.astro'
import Stripe from '../components/Stripe.astro'
import { campaignFinance } from '../content/campaignFinance'
import { languageSwitchHrefs } from '../lib/languageSwitch'
import {
    gridAreas,
    gridTemplateColumns,
    gridTemplateColumnsArticle,
    gridTemplateRowsLayout,
    gridTemplateRowsLayoutMobile,
    sizes,
} from '../lib/styles'

interface Props {
    authors?: AuthorEntry[]
    breadcrumbs?: BreadcrumbItem[]
    createdAt?: string
    description?: string
    events?: CampaignEvent[]
    faq?: Array<FaqItem>
    /**
     * Signal Band visual rebrand: `hero` is the transparent bar over a page's hero
     * image; `solid` (default) is the light-sand bar every other page uses —
     * independent of `plated`, since post/page layouts are plated but still solid-headed.
     */
    headerVariant?: 'hero' | 'solid'
    /**
     * Only the front page's hero renders its own in-image wordmark — every other
     * `hero`-variant header needs to show its own brand link instead (overhanging the
     * hero, since there's no in-image mark to rely on there).
     */
    heroShowsMark?: boolean
    lang?: Lang
    langAlternates?: Record<Lang, string>
    noindex?: boolean
    ogImage?: string
    ogImageAlt?: string
    /**
     * Signal Band visual rebrand, transitional: renders `<main>`/`<article>` as plain
     * block flow instead of the 5-column article grid, so full-bleed color plates can
     * sit edge to edge. Opt-in per layout while pages migrate phase by phase — remove
     * this prop (and the article grid it's an alternative to) once every layout that
     * renders prose has moved to plates.
     */
    plated?: boolean
    slug?: string
    tags?: string[]
    title: string
    type?: JsonLdType
    updatedAt?: string
    wordCount?: number
}

const {
    authors,
    breadcrumbs,
    createdAt,
    description,
    events,
    faq,
    headerVariant = 'solid',
    heroShowsMark = false,
    lang,
    langAlternates,
    noindex,
    ogImage,
    ogImageAlt,
    plated = false,
    slug,
    tags,
    title,
    type,
    updatedAt,
    wordCount,
} = Astro.props

const langHrefs = languageSwitchHrefs(Astro.url.pathname, langAlternates, noindex)

/*
 * Counts clicks on any link to the donation short URL as a Simple Analytics "donate_click"
 * event; the page it came from is recorded with it. The link leaves the site through a
 * Cloudflare redirect, so no page view would show it. Navigation waits for the event for at
 * most 500 ms. Modified clicks (new tab) are counted without being held, and Do Not Track
 * is respected.
 */
const donateClickScript = `document.addEventListener('click', function (event) {
    var link = event.target instanceof Element ? event.target.closest('a[href="${campaignFinance.donationUrl}"]') : null
    var doNotTrack = parseInt(navigator.msDoNotTrack || window.doNotTrack || navigator.doNotTrack, 10) === 1
    if (!link || !window.sa_loaded || doNotTrack) return
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
        window.sa_event('donate_click')
        return
    }
    event.preventDefault()
    var left = false
    var leave = function () {
        if (left) return
        left = true
        window.location.href = link.href
    }
    setTimeout(leave, 500)
    window.sa_event('donate_click', leave)
})`
---

<html lang={lang ?? 'fi'}>
    <head>
        <GlobalStyle />
        <Head
            authors={authors}
            breadcrumbs={breadcrumbs}
            createdAt={createdAt}
            description={description}
            events={events}
            faq={faq}
            lang={lang}
            langAlternates={langAlternates}
            noindex={noindex}
            ogImage={ogImage}
            ogImageAlt={ogImageAlt}
            slug={slug}
            tags={tags}
            title={title}
            type={type}
            updatedAt={updatedAt}
            wordCount={wordCount}
        />
        <slot name="head" />
    </head>
    <body>
        <style
            define:vars={{
                articleRowGap: sizes[1],
                gridAreasMain: gridAreas.main,
                gridAreasStripe: gridAreas.stripe,
                gridTemplateColumns,
                gridTemplateColumnsArticle,
                gridTemplateRowsLayout,
                gridTemplateRowsLayoutMobile,
                paddingBlockEnd: sizes[2],
                paddingBlockStart: sizes[1],
            }}
        >
            body > div {
                display: grid;
                grid-template-areas:
                    'header'
                    'main'
                    'stripe'
                    'footer';
                grid-template-columns: var(--gridTemplateColumns);
                grid-template-rows: var(--gridTemplateRowsLayoutMobile);
                min-height: 100dvh;
                position: relative;
            }

            main {
                background-color: var(--colorsWhite);
                display: grid;
                grid-area: var(--gridAreasMain);
                grid-auto-rows: auto;
                grid-template-columns: var(--gridTemplateColumnsArticle);
            }

            body > div > :global(.stripes) {
                grid-area: var(--gridAreasStripe);
            }

            main > article {
                display: grid;
                grid-column: 1 / -1;
                grid-template-columns: var(--gridTemplateColumnsArticle);
                padding-block: var(--paddingBlockStart) var(--paddingBlockEnd);
                row-gap: var(--articleRowGap);
            }

            main > article > *:first-child {
                margin-block-start: 0;
            }

            main > article > *:last-child {
                margin-block-end: 0;
            }

            @media (min-width: 1200px) {
                body > div {
                    grid-template-rows: var(--gridTemplateRowsLayout);
                }
            }

            /* Signal Band visual rebrand, transitional (see the `plated` prop) — full-bleed
               block flow instead of the article grid, so color plates run edge to edge. */
            main.plated {
                background-color: transparent;
                display: block;
            }

            main.plated > article.plated {
                display: contents;
            }
        </style>
        <div>
            <Header heroShowsMark={heroShowsMark} lang={lang} langHrefs={langHrefs} variant={headerVariant} />
            <main class:list={{ plated }} id="main">
                <slot name="banner" />
                <article class:list={{ plated }}>
                    <slot />
                </article>
            </main>
            <Stripe />
            <Footer lang={lang} />
        </div>
        <!-- 100% privacy-first analytics -->
        <script async defer is:inline src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
        <!--
            Counts clicks on any link to the donation short URL as a Simple Analytics
            "donate_click" event (the page it came from is recorded with it). The link
            leaves the site through a Cloudflare redirect, so no page view would show it.
            Navigation waits for the event, at most 500 ms; modified clicks and Do Not
            Track are left alone.
        -->
        <script is:inline set:html={donateClickScript} />
    </body>
</html>
