---
import type { Lang } from '../content/nav'
import type { Post } from '../lib/posts'

import AllPostsLink from '../components/AllPostsLink.astro'
import Byline from '../components/Byline.astro'
import ExcerptList from '../components/ExcerptList.astro'
import Faq from '../components/Faq.astro'
import NewsletterPlate from '../components/frontPage/NewsletterPlate.astro'
import WritingsPlate from '../components/frontPage/WritingsPlate.astro'
import HeroPreloadLinks from '../components/HeroPreloadLinks.astro'
import NewsletterSubscribe from '../components/NewsletterSubscribe.astro'
import PostProse from '../components/post/PostProse.astro'
import SocialShare from '../components/SocialShare.astro'
import TitleBanner from '../components/TitleBanner.astro'
import { breadcrumbLabels } from '../lib/breadcrumbs'
import { faqSectionLabels, hasFaqSection } from '../lib/faq'
import { BLOGPOSTING, type BreadcrumbItem } from '../lib/jsonld'
import { ogId } from '../lib/og/id'
import { relatedPostIds } from '../lib/related'
import { colors } from '../lib/styles'
import BaseLayout from './BaseLayout.astro'

interface Props {
    langAlternates: Record<Lang, string>
    post: Post
}

const { langAlternates, post } = Astro.props
const {
    alt,
    authors,
    description,
    externalPublications,
    faq,
    heroImage,
    id,
    lang,
    pageTitle,
    publishDate,
    readingTime,
    slug,
    tags,
    title,
    updatedDate,
    wordCount,
} = post

const canonicalSlug = `${lang}/blog/${id}/${slug}`
const shareUrl = `https://lavanti.fi/${canonicalSlug}/`

const i18n = {
    en: {
        allPostsHref: '/en/blog/all/',
        allPostsLabel: 'All posts',
        eyebrow: 'Writing',
        otherPosts: 'Other posts',
        shareAriaLabel: (t: string) => `Share links for post ${t}`,
    },
    fi: {
        allPostsHref: '/fi/blog/all/',
        allPostsLabel: 'Kaikki kirjoitukset',
        eyebrow: 'Kirjoitukset',
        otherPosts: 'Muita kirjoituksia',
        shareAriaLabel: (t: string) => `Kirjoituksen ${t} sosiaalisen median jakolinkit`,
    },
    sv: {
        allPostsHref: '/sv/blog/all/',
        allPostsLabel: 'Alla inlägg',
        eyebrow: 'Inlägg',
        otherPosts: 'Andra inlägg',
        shareAriaLabel: (t: string) => `Delningslänkar för inlägget ${t}`,
    },
}

const t = i18n[lang]

// Narrowed here rather than in the template: the type guard does not carry into the JSX expression.
const faqItems = hasFaqSection(faq) ? faq : undefined

const ogImage = new URL(`/og/${ogId(canonicalSlug)}.png`, Astro.site).href

const siteOrigin = 'https://lavanti.fi'
const breadcrumbs: BreadcrumbItem[] = [
    { name: breadcrumbLabels.home[lang], url: `${siteOrigin}/${lang}/` },
    { name: breadcrumbLabels.blog[lang], url: `${siteOrigin}/${lang}/blog/` },
    { name: pageTitle, url: `${siteOrigin}/${canonicalSlug}/` },
]
---

<style define:vars={{ colorsWhite: colors.white }}>
    .prose-section {
        background: var(--colorsWhite);
        padding-bottom: 1.5rem;
    }
</style>
<BaseLayout
    authors={authors}
    breadcrumbs={breadcrumbs}
    createdAt={publishDate}
    description={description}
    faq={faq}
    lang={lang}
    langAlternates={langAlternates}
    ogImage={ogImage}
    ogImageAlt={alt}
    plated
    slug={canonicalSlug}
    tags={tags}
    title={pageTitle}
    type={BLOGPOSTING}
    updatedAt={updatedDate}
    wordCount={wordCount}
>
    <Fragment slot="head">
        <HeroPreloadLinks heroImage={heroImage} mode="post" />
    </Fragment>
    <TitleBanner
        alt={alt}
        createdAt={publishDate}
        heroImage={heroImage}
        lang={lang}
        readingTime={readingTime}
        slot="banner"
        tags={tags}
        title={title}
        updatedDate={updatedDate}
        variant="post"
    />
    <div class="prose-section">
        <div class="sheet">
            <PostProse>
                <slot />
                <Byline authors={authors ?? ['lauri']} externalPublications={externalPublications} lang={lang} />
                <SocialShare
                    ariaLabel={t.shareAriaLabel(pageTitle)}
                    locale={lang}
                    shareUrl={shareUrl}
                    title={pageTitle}
                />
            </PostProse>
        </div>
    </div>
    {
        faqItems && (
            <Faq eyebrow={faqSectionLabels[lang].eyebrow} faq={faqItems} heading={faqSectionLabels[lang].heading} />
        )
    }
    <WritingsPlate
        allPostsHref={t.allPostsHref}
        allPostsLabel={t.allPostsLabel}
        eyebrow={t.eyebrow}
        ground="white"
        heading={t.otherPosts}
    >
        <ExcerptList currentSlug={slug} lang={lang} limit={3} rankedIds={relatedPostIds(id)} relatedTags={tags} />
        <AllPostsLink lang={lang} />
    </WritingsPlate>
    <NewsletterPlate>
        <NewsletterSubscribe lang={lang} />
    </NewsletterPlate>
</BaseLayout>
